@model IEnumerable<code.Models.SanPham>
@{
    ViewData["Title"] = "Quản lý Sản phẩm";
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly");
    var search = ViewData["Search"] as string;
    var selectedDanhMuc = ViewData["SelectedDanhMuc"] as int?;
}

<div class="page-header">
    <div class="page-header-left">
        <h3>Danh sách Sản phẩm</h3>
        <p>Quản lý toàn bộ danh mục hàng hóa, đơn vị tính, đơn giá mặc định và tồn kho</p>
    </div>
    <div class="d-flex align-items-center gap-2">
        <a asp-controller="DanhMuc" asp-action="Index" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-folder2-open me-1"></i> Quản lý Danh mục
        </a>
        <a asp-controller="DonViTinh" asp-action="Index" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-rulers me-1"></i> Đơn vị tính
        </a>
        @if (isManagerOrAdmin)
        {
            <a asp-action="Create" class="btn btn-custom btn-custom-primary">
                <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm mới
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-custom alert-custom-danger mb-3">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="search-bar mb-4">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <div class="input-group" style="flex: 1; min-width: 200px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo tên hoặc mã sản phẩm..." />
        </div>
        <select name="maDanhMuc" class="form-select" style="max-width: 220px;" asp-items="ViewBag.DanhMucs">
            <option value="">-- Tất cả danh mục --</option>
        </select>
        <button type="submit" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-funnel"></i> Lọc
        </button>
        @if (!string.IsNullOrEmpty(search) || selectedDanhMuc.HasValue)
        {
            <a asp-action="Index" class="btn btn-custom btn-custom-outline" title="Đặt lại">
                <i class="bi bi-arrow-counterclockwise"></i>
            </a>
        }
    </form>
</div>

<!-- Bảng danh sách sản phẩm -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Sản phẩm</th>
                    <th>ĐVT</th>
                    <th class="text-end">Giá mặc định</th>
                    <th class="text-end">Tồn kho</th>
                    <th class="text-center" style="width: 140px;">Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var ton = item.TonKho?.SoLuongTon ?? 0;
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(item.AnhSanPham))
                                    {
                                        <img src="@item.AnhSanPham" alt="@item.TenSanPham" class="table-product-thumb" onerror="this.onerror=null; this.src='/images/placeholder-product.svg';" />
                                    }
                                    else
                                    {
                                        <div class="table-product-placeholder">
                                            <i class="bi bi-box-seam"></i>
                                        </div>
                                    }
                                    <div style="min-width: 0;">
                                        <a asp-action="Details" asp-route-id="@item.MaSanPham" class="fw-semibold text-decoration-none d-block" style="color: var(--slate-800);">
                                            @item.TenSanPham
                                        </a>
                                        <div style="margin-top: 2px;">
                                            <span class="code-badge">@(item.MaSanPhamCode ?? $"SP{item.MaSanPham:D3}")</span>
                                            <span style="color: var(--slate-400); font-size: 12px;"> · @(item.DanhMuc?.TenDanhMuc ?? "Chưa phân loại")</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>@(item.DonViTinh?.TenDonVi ?? "-")</td>
                            <td class="text-end font-mono fw-semibold">
                                @((item.GiaMacDinh ?? 0).ToString("N0")) đ
                            </td>
                            <td class="text-end font-mono fw-bold @(ton < 20 ? "text-danger" : "text-dark")">@ton</td>
                            <td class="text-center">
                                @if (item.TrangThai == true)
                                {
                                    <span class="status-badge status-badge-success">Đang kinh doanh</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-secondary">Ngừng bán</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btn-group">
                                    <a asp-action="Details" asp-route-id="@item.MaSanPham" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isManagerOrAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaSanPham" class="btn btn-sm btn-outline-secondary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                                onclick="confirmDelete(@item.MaSanPham, '@item.TenSanPham')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <p>Không tìm thấy sản phẩm nào.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_DeleteModal" view-data='new ViewDataDictionary(ViewData) { ["DeleteNote"] = "Nếu sản phẩm đã phát sinh phiếu nhập, hệ thống sẽ chặn xóa để bảo đảm toàn vẹn dữ liệu." }' />
