@model IEnumerable<code.Models.LichSuNhapHang>
@{
    ViewData["Title"] = "Nhật ký Biến động Nhập hàng";
    var search = ViewData["Search"] as string;
    var selectedLoai = ViewData["SelectedLoai"] as string;
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-clock-history text-primary me-2"></i>Lịch sử Biến động Kho
        </h3>
        <p class="text-muted mb-0 small">Nhật ký chi tiết các lần nhập kho, điều chỉnh số lượng và tăng giảm tồn kho</p>
    </div>
</div>

<!-- Bộ lọc & Tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control bg-light border-start-0" placeholder="Tìm theo tên SP, mã SP hoặc mã phiếu..." />
                </div>
            </div>
            <div class="col-md-4">
                <select name="loaiThayDoi" class="form-select bg-light">
                    <option value="">-- Tất cả loại biến động --</option>
                    <option value="nhap" selected="@(selectedLoai == "nhap")">Nhập hàng mới</option>
                    <option value="dieuchinh" selected="@(selectedLoai == "dieuchinh")">Điều chỉnh kho</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary px-3">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedLoai))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng Lịch sử biến động -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th style="width: 80px;" class="text-center">Mã GD</th>
                        <th>Sản phẩm</th>
                        <th>ĐVT</th>
                        <th>Phiếu nhập liên quan</th>
                        <th>Nhà cung cấp</th>
                        <th class="text-center" style="width: 140px;">Biến động</th>
                        <th class="text-center" style="width: 150px;">Loại biến động</th>
                        <th style="width: 180px;">Thời gian ghi nhận</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var sp = item.SanPham;
                            var pn = item.PhieuNhap;
                            var sl = item.SoLuongThayDoi ?? 0;

                            <tr>
                                <td class="text-center text-muted fw-bold">#@item.MaLichSu</td>
                                <td>
                                    <strong class="text-dark">@(sp?.TenSanPham ?? "N/A")</strong>
                                    <span class="badge bg-light text-dark font-monospace border ms-1">
                                        @(sp?.MaSanPhamCode ?? $"SP{sp?.MaSanPham:D3}")
                                    </span>
                                </td>
                                <td>@(sp?.DonViTinh?.TenDonVi ?? "-")</td>
                                <td>
                                    @if (pn != null)
                                    {
                                        <a asp-controller="PhieuNhap" asp-action="Details" asp-route-id="@pn.MaPhieuNhap" class="font-monospace fw-semibold text-primary text-decoration-none">
                                            @(pn.MaPhieuNhapCode ?? $"PN{pn.MaPhieuNhap:D4}")
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="text-muted">—</span>
                                    }
                                </td>
                                <td class="small text-secondary">
                                    @(pn?.NhaCungCap?.TenNhaCungCap ?? "—")
                                </td>
                                <td class="text-center">
                                    @if (sl > 0)
                                    {
                                        <span class="badge bg-success-subtle text-success fs-6 px-3">
                                            +@sl
                                        </span>
                                    }
                                    else if (sl < 0)
                                    {
                                        <span class="badge bg-danger-subtle text-danger fs-6 px-3">
                                            @sl
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-dark border px-3">0</span>
                                    }
                                </td>
                                <td class="text-center">
                                    @if (item.LoaiThayDoi == "nhap")
                                    {
                                        <span class="badge bg-primary-subtle text-primary">
                                            <i class="bi bi-box-arrow-in-down me-1"></i>Nhập hàng
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning-subtle text-warning">
                                            <i class="bi bi-sliders me-1"></i>Điều chỉnh
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="8" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Chưa có nhật ký biến động kho nào.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
