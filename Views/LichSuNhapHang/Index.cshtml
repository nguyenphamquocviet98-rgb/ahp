@model IEnumerable<code.Models.LichSuNhapHang>
@{
    ViewData["Title"] = "Nhật ký Biến động Nhập hàng";
    var search = ViewData["Search"] as string;
    var selectedLoai = ViewData["SelectedLoai"] as string;
}

<div class="page-header">
    <div class="page-header-left">
        <h3><i class="bi bi-clock-history" style="color: var(--primary);"></i> Lịch sử Biến động Kho</h3>
        <p>Nhật ký chi tiết các lần nhập kho, điều chỉnh số lượng và tăng giảm tồn kho</p>
    </div>
</div>

<!-- Bộ lọc & Tìm kiếm -->
<div class="search-bar mb-4">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <div class="input-group" style="flex: 1; min-width: 240px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo tên SP, mã SP hoặc mã phiếu..." />
        </div>
        <select name="loaiThayDoi" class="form-select" style="max-width: 220px;">
            <option value="">-- Tất cả loại biến động --</option>
            <option value="nhap" selected="@(selectedLoai == "nhap")">Nhập hàng mới</option>
            <option value="dieuchinh" selected="@(selectedLoai == "dieuchinh")">Điều chỉnh kho</option>
        </select>
        <button type="submit" class="btn btn-custom btn-custom-outline"><i class="bi bi-funnel"></i> Lọc</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedLoai))
        {
            <a asp-action="Index" class="btn btn-custom btn-custom-outline"><i class="bi bi-arrow-counterclockwise"></i></a>
        }
    </form>
</div>

<!-- Bảng Lịch sử biến động -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 80px;" class="text-center">Mã GD</th>
                    <th>Sản phẩm</th>
                    <th>ĐVT</th>
                    <th>Phiếu nhập liên quan</th>
                    <th>Nhà cung cấp</th>
                    <th class="text-center" style="width: 140px;">Biến động</th>
                    <th class="text-center" style="width: 150px;">Loại biến động</th>
                    <th style="width: 180px;">Thời gian ghi nhận</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var sp = item.SanPham;
                        var pn = item.PhieuNhap;
                        var sl = item.SoLuongThayDoi ?? 0;

                        <tr>
                            <td class="text-center" style="color: var(--slate-500); font-weight: 600;">#@item.MaLichSu</td>
                            <td>
                                <strong style="color: var(--slate-900);">@(sp?.TenSanPham ?? "N/A")</strong>
                                <span class="code-badge ms-1">
                                    @(sp?.MaSanPhamCode ?? $"SP{sp?.MaSanPham:D3}")
                                </span>
                            </td>
                            <td>@(sp?.DonViTinh?.TenDonVi ?? "-")</td>
                            <td>
                                @if (pn != null)
                                {
                                    <a asp-controller="PhieuNhap" asp-action="Details" asp-route-id="@pn.MaPhieuNhap" class="code-badge text-decoration-none">
                                        @(pn.MaPhieuNhapCode ?? $"PN{pn.MaPhieuNhap:D4}")
                                    </a>
                                }
                                else
                                {
                                    <span style="color: var(--slate-400);">—</span>
                                }
                            </td>
                            <td style="color: var(--slate-600); font-size: 13px;">
                                @(pn?.NhaCungCap?.TenNhaCungCap ?? "—")
                            </td>
                            <td class="text-center">
                                @if (sl > 0)
                                {
                                    <span class="status-badge status-badge-success fs-6 px-3">
                                        +@sl
                                    </span>
                                }
                                else if (sl < 0)
                                {
                                    <span class="status-badge status-badge-danger fs-6 px-3">
                                        @sl
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-secondary px-3">0</span>
                                }
                            </td>
                            <td class="text-center">
                                @if (item.LoaiThayDoi == "nhap")
                                {
                                    <span class="status-badge status-badge-primary">
                                        <i class="bi bi-box-arrow-in-down"></i> Nhập hàng
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-warning">
                                        <i class="bi bi-sliders"></i> Điều chỉnh
                                    </span>
                                }
                            </td>
                            <td style="color: var(--slate-500); font-size: 13px;">
                                @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm:ss") ?? "—")
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state"><i class="bi bi-inbox"></i><p>Chưa có nhật ký biến động kho nào.</p></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
