@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProcureAHP Enterprise</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "nhanvien";
        var username = User.Identity.Name ?? "Người dùng";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        <!-- Sidebar Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- SIDEBAR (LUXURY DARK SLATE) -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <i class="bi bi-diagram-3-fill"></i>
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-title">
                        ProcureAHP
                        <span class="sidebar-version-badge">v2.4 PRO</span>
                    </div>
                    <div class="sidebar-subtitle">Hệ thống Quản lý Nhập hàng & AHP</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <!-- TỔNG QUAN -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Tổng quan</div>
                    <a asp-controller="Home" asp-action="Index"
                       class="sidebar-link @(currentController == "Home" ? "active" : "")">
                        <i class="bi bi-house-door-fill"></i>
                        <span>Trang chủ</span>
                    </a>
                </div>

                <!-- HÀNG HÓA & ĐỐI TÁC -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Hàng hóa & Đối tác</div>
                    <a asp-controller="SanPham" asp-action="Index"
                       class="sidebar-link @(currentController == "SanPham" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>
                        <span>Sản phẩm</span>
                    </a>
                    <a asp-controller="DanhMuc" asp-action="Index"
                       class="sidebar-link @(currentController == "DanhMuc" ? "active" : "")">
                        <i class="bi bi-folder2-open"></i>
                        <span>Danh mục</span>
                    </a>
                    <a asp-controller="DonViTinh" asp-action="Index"
                       class="sidebar-link @(currentController == "DonViTinh" ? "active" : "")">
                        <i class="bi bi-rulers"></i>
                        <span>Đơn vị tính</span>
                    </a>
                    <a asp-controller="NhaCungCap" asp-action="Index"
                       class="sidebar-link @(currentController == "NhaCungCap" ? "active" : "")">
                        <i class="bi bi-buildings"></i>
                        <span>Nhà cung cấp</span>
                    </a>
                </div>

                <!-- NHẬP HÀNG & KHO VẬN -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Nhập hàng & Kho vận</div>
                    <a asp-controller="PhieuNhap" asp-action="Index"
                       class="sidebar-link @(currentController == "PhieuNhap" ? "active" : "")">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Phiếu nhập hàng</span>
                    </a>
                    <a asp-controller="TonKho" asp-action="Index"
                       class="sidebar-link @(currentController == "TonKho" ? "active" : "")">
                        <i class="bi bi-boxes"></i>
                        <span>Quản lý tồn kho</span>
                    </a>
                    <a asp-controller="LichSuNhapHang" asp-action="Index"
                       class="sidebar-link @(currentController == "LichSuNhapHang" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Lịch sử biến động</span>
                    </a>
                </div>

                <!-- ĐÁNH GIÁ ĐA TIÊU CHÍ AHP -->
                @if (role == "admin" || role == "quanly")
                {
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Đánh giá đa tiêu chí AHP</div>
                        <a asp-controller="AHP" asp-action="Index"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-calendar3"></i>
                            <span>Kỳ đánh giá</span>
                        </a>
                        <a asp-controller="AHP" asp-action="MaTranSoSanh"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "MaTranSoSanh" ? "active" : "")">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Ma trận so sánh</span>
                        </a>
                        <a asp-controller="AHP" asp-action="ChamDiemNCC"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "ChamDiemNCC" ? "active" : "")">
                            <i class="bi bi-star-fill text-warning"></i>
                            <span>Chấm điểm NCC</span>
                        </a>
                        <a asp-controller="AHP" asp-action="KetQuaXepHang"
                           class="sidebar-link @(currentController == "AHP" && (currentAction == "KetQuaXepHang" || currentAction == "KetQuaTrongSo") ? "active" : "")">
                            <i class="bi bi-trophy-fill text-warning"></i>
                            <span>Xếp hạng & Đề xuất</span>
                        </a>
                    </div>
                }

                <!-- HỆ THỐNG -->
                @if (role == "admin")
                {
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Quản trị</div>
                        <a asp-controller="NguoiDung" asp-action="Index"
                           class="sidebar-link @(currentController == "NguoiDung" ? "active" : "")">
                            <i class="bi bi-people"></i>
                            <span>Tài khoản người dùng</span>
                        </a>
                    </div>
                }
            </nav>

            <!-- Sidebar User Profile -->
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@username</div>
                        <div class="sidebar-user-role">
                            <span class="sidebar-status-dot"></span>
                            @if (role == "admin") { <span>Quản trị viên</span> }
                            else if (role == "quanly") { <span>Quản lý</span> }
                            else { <span>Nhân viên</span> }
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- TOP HEADER -->
        <header class="top-header">
            <div class="header-left">
                <button class="sidebar-toggle" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="header-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" placeholder="Tìm sản phẩm, nhà cung cấp, phiếu..." />
                    <span class="header-search-badge">⌘K</span>
                </div>
            </div>

            <div class="header-right">
                <div class="header-status-pill d-none d-md-flex">
                    <span class="status-indicator-dot"></span>
                    <span>Hệ thống trực tuyến</span>
                </div>

                <div class="header-user-pill">
                    <div style="width: 24px; height: 24px; border-radius: 50%; background: linear-gradient(135deg, #1E293B, #334155); color: #FFF; display: flex; align-items: center; justify-content: center; font-weight: 700; font-size: 11px;">
                        @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                    </div>
                    <span style="font-weight: 600; font-size: 13px; color: var(--slate-800);">@username</span>
                    @if (role == "admin")
                    {
                        <span class="user-role-badge badge-admin">Admin</span>
                    }
                    else if (role == "quanly")
                    {
                        <span class="user-role-badge badge-quanly">Quản lý</span>
                    }
                    else
                    {
                        <span class="user-role-badge badge-nhanvien">Nhân viên</span>
                    }
                </div>

                <a asp-controller="Account" asp-action="Logout" class="btn-header-logout" title="Đăng xuất khỏi hệ thống">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-sm-inline">Thoát</span>
                </a>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <main role="main">
                @RenderBody()
            </main>

            <footer class="page-footer">
                &copy; 2026 <strong>ProcureAHP Enterprise</strong> &bull; Phần mềm Quản lý Nhập hàng & Ra quyết định Đa tiêu chí AHP
            </footer>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('show');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(function(link) {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        document.getElementById('sidebar').classList.remove('show');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    }
    else
    {
        <div class="container py-5">
            @RenderBody()
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    }
</body>
</html>
