@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản Lý Nhập Hàng & AHP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "nhanvien";
        var username = User.Identity.Name ?? "Người dùng";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";

        <!-- Sidebar Mobile Overlay -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <i class="bi bi-box-seam-fill"></i>
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-title">ProcureAHP</div>
                    <div class="sidebar-subtitle">Quản lý nhập hàng & AHP</div>
                </div>
            </div>

            <nav class="sidebar-nav">
                <!-- Tổng quan -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Tổng quan</div>
                    <a asp-controller="Home" asp-action="Index"
                       class="sidebar-link @(currentController == "Home" ? "active" : "")">
                        <i class="bi bi-grid-1x2"></i>
                        <span>Dashboard</span>
                    </a>
                </div>

                <!-- Danh mục & Hàng hóa -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Hàng hóa & Đối tác</div>
                    <a asp-controller="SanPham" asp-action="Index"
                       class="sidebar-link @(currentController == "SanPham" ? "active" : "")">
                        <i class="bi bi-box-seam"></i>
                        <span>Sản phẩm</span>
                    </a>
                    <a asp-controller="DanhMuc" asp-action="Index"
                       class="sidebar-link @(currentController == "DanhMuc" ? "active" : "")">
                        <i class="bi bi-folder2"></i>
                        <span>Danh mục</span>
                    </a>
                    <a asp-controller="DonViTinh" asp-action="Index"
                       class="sidebar-link @(currentController == "DonViTinh" ? "active" : "")">
                        <i class="bi bi-rulers"></i>
                        <span>Đơn vị tính</span>
                    </a>
                    <a asp-controller="NhaCungCap" asp-action="Index"
                       class="sidebar-link @(currentController == "NhaCungCap" ? "active" : "")">
                        <i class="bi bi-buildings"></i>
                        <span>Nhà cung cấp</span>
                    </a>
                </div>

                <!-- Nhập hàng & Kho -->
                <div class="sidebar-group">
                    <div class="sidebar-group-label">Kho vận & Nhập hàng</div>
                    <a asp-controller="PhieuNhap" asp-action="Index"
                       class="sidebar-link @(currentController == "PhieuNhap" ? "active" : "")">
                        <i class="bi bi-receipt-cutoff"></i>
                        <span>Phiếu nhập hàng</span>
                    </a>
                    <a asp-controller="TonKho" asp-action="Index"
                       class="sidebar-link @(currentController == "TonKho" ? "active" : "")">
                        <i class="bi bi-boxes"></i>
                        <span>Quản lý tồn kho</span>
                    </a>
                    <a asp-controller="LichSuNhapHang" asp-action="Index"
                       class="sidebar-link @(currentController == "LichSuNhapHang" ? "active" : "")">
                        <i class="bi bi-clock-history"></i>
                        <span>Lịch sử biến động</span>
                    </a>
                </div>

                <!-- Đánh giá AHP -->
                @if (role == "admin" || role == "quanly")
                {
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Đánh giá đa tiêu chí (AHP)</div>
                        <a asp-controller="AHP" asp-action="Index"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "Index" ? "active" : "")">
                            <i class="bi bi-calendar3"></i>
                            <span>Kỳ đánh giá</span>
                        </a>
                        <a asp-controller="AHP" asp-action="MaTranSoSanh"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "MaTranSoSanh" ? "active" : "")">
                            <i class="bi bi-grid-3x3"></i>
                            <span>Ma trận so sánh</span>
                        </a>
                        <a asp-controller="AHP" asp-action="ChamDiemNCC"
                           class="sidebar-link @(currentController == "AHP" && currentAction == "ChamDiemNCC" ? "active" : "")">
                            <i class="bi bi-check2-circle"></i>
                            <span>Chấm điểm NCC</span>
                        </a>
                        <a asp-controller="AHP" asp-action="KetQuaXepHang"
                           class="sidebar-link @(currentController == "AHP" && (currentAction == "KetQuaXepHang" || currentAction == "KetQuaTrongSo") ? "active" : "")">
                            <i class="bi bi-award"></i>
                            <span>Xếp hạng & Đề xuất</span>
                        </a>
                    </div>
                }

                <!-- Quản trị -->
                @if (role == "admin")
                {
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Hệ thống</div>
                        <a asp-controller="NguoiDung" asp-action="Index"
                           class="sidebar-link @(currentController == "NguoiDung" ? "active" : "")">
                            <i class="bi bi-people"></i>
                            <span>Tài khoản người dùng</span>
                        </a>
                    </div>
                }
            </nav>

            <!-- Sidebar User -->
            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@username</div>
                        <div class="sidebar-user-role">
                            @if (role == "admin")
                            {
                                <span>Quản trị viên</span>
                            }
                            else if (role == "quanly")
                            {
                                <span>Quản lý</span>
                            }
                            else
                            {
                                <span>Nhân viên</span>
                            }
                        </div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- TOP HEADER -->
        <header class="top-header">
            <div class="header-left">
                <button class="sidebar-toggle" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <div class="header-breadcrumb d-none d-md-flex">
                    <a asp-controller="Home" asp-action="Index">Hệ thống</a>
                    @if (!string.IsNullOrEmpty(ViewData["Title"]?.ToString()) && currentController != "Home")
                    {
                        <span class="separator">/</span>
                        <span class="current">@ViewData["Title"]</span>
                    }
                </div>
            </div>

            <div class="header-right">
                <div class="header-user-pill">
                    <div style="width: 22px; height: 22px; border-radius: 50%; background: var(--gray-200); color: var(--gray-700); display: flex; align-items: center; justify-content: center; font-weight: 600; font-size: 11px;">
                        @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                    </div>
                    <span style="font-weight: 500; font-size: 12.5px; color: var(--gray-800);">@username</span>
                    @if (role == "admin")
                    {
                        <span class="user-role-badge badge-admin">Admin</span>
                    }
                    else if (role == "quanly")
                    {
                        <span class="user-role-badge badge-quanly">Quản lý</span>
                    }
                    else
                    {
                        <span class="user-role-badge badge-nhanvien">Nhân viên</span>
                    }
                </div>
                <a asp-controller="Account" asp-action="Logout" class="btn-header-logout" title="Đăng xuất">
                    <i class="bi bi-box-arrow-right"></i>
                    <span class="d-none d-sm-inline">Thoát</span>
                </a>
            </div>
        </header>

        <!-- MAIN CONTENT -->
        <div class="main-content">
            <main role="main">
                @RenderBody()
            </main>

            <footer class="page-footer">
                &copy; 2026 <strong>ProcureAHP Enterprise</strong> &mdash; Hệ thống Quản lý Nhập hàng & Ra quyết định Nhà cung cấp bằng AHP
            </footer>
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('show');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(function(link) {
                link.addEventListener('click', function() {
                    if (window.innerWidth < 992) {
                        document.getElementById('sidebar').classList.remove('show');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    }
    else
    {
        <div class="container py-5">
            @RenderBody()
        </div>

        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        @await RenderSectionAsync("Scripts", required: false)
    }
</body>
</html>
