@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@using System.Security.Claims
<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Quản lý nhập hàng & AHP</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" />
    <!-- Google Fonts: Be Vietnam Pro & Inter tiếng Việt hoàn hảo -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:ital,wght@0,300;0,400;0,500;0,600;0,700;0,800;1,400;1,600&family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
</head>
<body>
    @if (User.Identity != null && User.Identity.IsAuthenticated)
    {
        var role = User.FindFirst(ClaimTypes.Role)?.Value ?? "nhanvien_npp";
        var username = User.Identity.Name ?? "Người dùng";
        var currentController = ViewContext.RouteData.Values["controller"]?.ToString() ?? "";
        var currentAction = ViewContext.RouteData.Values["action"]?.ToString() ?? "";
        var maDoanhNghiep = User.FindFirst("MaDoanhNghiep")?.Value ?? "0";
        var tenDoanhNghiep = User.FindFirst("TenDoanhNghiep")?.Value ?? "";
        
        var isAdminSan = role == "admin_san" || role == "admin";
        var isChuNPP = role == "chu_npp" || role == "quanly";
        var isNhanVienNPP = role == "nhanvien_npp" || role == "nhanvien";
        var isNPP = isChuNPP || isNhanVienNPP;

        var roleDisplay = isAdminSan ? "Admin Sàn" : isChuNPP ? "Chủ NPP" : "Nhân viên NPP";
        var roleBadgeClass = isAdminSan ? "badge-admin" : isChuNPP ? "badge-quanly" : "badge-nhanvien";

        <!-- Overlay (mobile) -->
        <div class="sidebar-overlay" id="sidebarOverlay" onclick="toggleSidebar()"></div>

        <!-- SIDEBAR -->
        <aside class="sidebar" id="sidebar">
            <div class="sidebar-header">
                <div class="sidebar-logo">
                    <img src="~/favicon.svg" alt="B2B Logo" />
                </div>
                <div class="sidebar-brand-text">
                    <div class="sidebar-title">Nhập hàng & AHP</div>
                    <div class="sidebar-subtitle">
                        @if (isAdminSan)
                        {
                            <text>Quản trị Sàn B2B</text>
                        }
                        else if (!string.IsNullOrEmpty(tenDoanhNghiep))
                        {
                            @tenDoanhNghiep
                        }
                        else
                        {
                            <text>Doanh Nghiệp NPP</text>
                        }
                    </div>
                </div>
            </div>

            <nav class="sidebar-nav">
                @if (isAdminSan)
                {
                    @* =============================================== *@
                    @* === KHỐI MENU DÀNH RIÊNG CHO ADMIN SÀN B2B === *@
                    @* =============================================== *@
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Quản trị Sàn B2B</div>
                        <a asp-controller="DashboardAdmin" asp-action="Index"
                           class="sidebar-link @(currentController == "DashboardAdmin" ? "active" : "")">
                            <i class="bi bi-speedometer2 text-primary"></i>
                            <span>Bảng điều khiển Sàn</span>
                        </a>
                        <a asp-controller="DoanhNghiep" asp-action="Index"
                           class="sidebar-link @(currentController == "DoanhNghiep" ? "active" : "")">
                            <i class="bi bi-building-gear text-info"></i>
                            <span>Quản lý Doanh nghiệp</span>
                        </a>
                        <a asp-controller="NguoiDung" asp-action="Index"
                           class="sidebar-link @(currentController == "NguoiDung" ? "active" : "")">
                            <i class="bi bi-people text-warning"></i>
                            <span>Tài khoản người dùng</span>
                        </a>
                        <a asp-controller="QuangCao" asp-action="Index"
                           class="sidebar-link @(currentController == "QuangCao" ? "active" : "")">
                            <i class="bi bi-badge-ad text-success"></i>
                            <span>Duyệt Banner & QC</span>
                        </a>
                        <a asp-controller="SanB2B" asp-action="Index"
                           class="sidebar-link @(currentController == "SanB2B" ? "active" : "")">
                            <i class="bi bi-shop-window text-secondary"></i>
                            <span>Giám sát Chợ sỉ B2B</span>
                        </a>
                    </div>
                }
                else
                {
                    @* ============================================================= *@
                    @* === KHỐI MENU DÀNH CHO NHÀ PHÂN PHỐI (CHỦ NPP / NHÂN VIÊN) === *@
                    @* ============================================================= *@

                    @* === KHỐI 1: TỔNG QUAN DOANH NGHIỆP === *@
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Tổng quan</div>
                        <a asp-controller="Home" asp-action="Index"
                           class="sidebar-link @(currentController == "Home" ? "active" : "")">
                            <i class="bi bi-grid-1x2"></i>
                            <span>Bảng điều khiển kho</span>
                        </a>
                    </div>

                    @* === KHỐI 2: SÀN B2B & GIAO THƯƠNG SỈ === *@
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Sàn B2B & Bán sỉ</div>
                        <a asp-controller="SanB2B" asp-action="Index"
                           class="sidebar-link @(currentController == "SanB2B" ? "active" : "")">
                            <i class="bi bi-shop-window"></i>
                            <span>Chợ sỉ B2B</span>
                        </a>
                        <a asp-controller="KhoNPP" asp-action="Index"
                           class="sidebar-link @(currentController == "KhoNPP" ? "active" : "")">
                            <i class="bi bi-boxes"></i>
                            <span>Kho chào sỉ của tôi</span>
                        </a>
                        <a asp-controller="DonHangB2B" asp-action="DonMua"
                           class="sidebar-link @(currentController == "DonHangB2B" ? "active" : "")">
                            <i class="bi bi-receipt"></i>
                            <span>Đơn hàng sỉ B2B</span>
                        </a>
                        <a asp-controller="AHPB2B" asp-action="Index"
                           class="sidebar-link @(currentController == "AHPB2B" ? "active" : "")">
                            <i class="bi bi-cpu"></i>
                            <span>AHP Chọn đối tác B2B</span>
                        </a>
                    </div>

                    @* === KHỐI 3: QUẢN LÝ KHO & NHẬP XUẤT === *@
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Kho hàng & Nhập xuất</div>
                        <a asp-controller="SanPham" asp-action="Index"
                           class="sidebar-link @(currentController == "SanPham" ? "active" : "")">
                            <i class="bi bi-box-seam"></i>
                            <span>Sản phẩm của kho</span>
                        </a>
                        <a asp-controller="DanhMuc" asp-action="Index"
                           class="sidebar-link @(currentController == "DanhMuc" || currentController == "DonViTinh" ? "active" : "")">
                            <i class="bi bi-tags"></i>
                            <span>Danh mục & ĐVT</span>
                        </a>
                        <a asp-controller="PhieuNhap" asp-action="Index"
                           class="sidebar-link @(currentController == "PhieuNhap" ? "active" : "")">
                            <i class="bi bi-box-arrow-in-down"></i>
                            <span>Phiếu nhập hàng</span>
                        </a>
                        <a asp-controller="TonKho" asp-action="Index"
                           class="sidebar-link @(currentController == "TonKho" || currentController == "LichSuNhapHang" ? "active" : "")">
                            <i class="bi bi-pie-chart"></i>
                            <span>Quản lý tồn kho</span>
                        </a>
                    </div>

                    @* === KHỐI 4: ĐỐI TÁC CUNG ỨNG & AHP === *@
                    <div class="sidebar-group">
                        <div class="sidebar-group-label">Đối tác & Đánh giá AHP</div>
                        <a asp-controller="NhaCungCap" asp-action="Index"
                           class="sidebar-link @(currentController == "NhaCungCap" ? "active" : "")">
                            <i class="bi bi-buildings"></i>
                            <span>Nhà cung cấp</span>
                        </a>
                        @if (isChuNPP)
                        {
                            <a asp-controller="AHP" asp-action="Index"
                               class="sidebar-link @(currentController == "AHP" ? "active" : "")"
                               title="Quản lý toàn diện các kỳ đánh giá AHP, ma trận so sánh và xếp hạng">
                                <i class="bi bi-diagram-3-fill text-primary"></i>
                                <span>Đánh giá AHP</span>
                            </a>
                        }
                    </div>

                    @* === KHỐI 5: DỊCH VỤ SÀN (Chỉ Chủ NPP) === *@
                    @if (isChuNPP)
                    {
                        <div class="sidebar-group">
                            <div class="sidebar-group-label">Dịch vụ Sàn</div>
                            <a asp-controller="QuangCao" asp-action="MuaGoi"
                               class="sidebar-link @(currentController == "QuangCao" && currentAction == "MuaGoi" ? "active" : "")">
                                <i class="bi bi-award text-warning"></i>
                                <span>Gói Mall & Quảng cáo</span>
                            </a>
                        </div>
                    }
                }
            </nav>

            <div class="sidebar-footer">
                <div class="sidebar-user">
                    <div class="sidebar-user-avatar">
                        @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                    </div>
                    <div class="sidebar-user-info">
                        <div class="sidebar-user-name">@username</div>
                        <div class="sidebar-user-role">@roleDisplay</div>
                    </div>
                </div>
            </div>
        </aside>

        <!-- TOP HEADER -->
        <header class="top-header">
            <div class="header-left">
                <button class="sidebar-toggle" id="sidebarToggleBtn" onclick="toggleSidebar()" title="Menu">
                    <i class="bi bi-list"></i>
                </button>
                <form asp-controller="SanPham" asp-action="Index" method="get" class="header-search-box">
                    <i class="bi bi-search"></i>
                    <input type="text" name="search" id="globalHeaderSearch" placeholder="Tìm sản phẩm, nhà cung cấp, phiếu..." autocomplete="off" />
                    <span class="header-search-badge">Ctrl+K</span>
                </form>
            </div>

            <div class="header-right">
                @if (!isAdminSan)
                {
                    <!-- Cảnh báo tồn kho (Chỉ dành cho NPP) -->
                    <div class="dropdown" id="stockAlertDropdown">
                        <button class="btn-header-icon" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="Cảnh báo tồn kho">
                            <i class="bi bi-bell"></i>
                            <span class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger" id="stockAlertBadge" style="display: none; font-size: 10px;">
                                0
                            </span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end shadow-sm border p-0 mt-2 alert-dropdown">
                            <div class="alert-dropdown-header">
                                <span>Cảnh báo tồn kho</span>
                                <span class="code-badge" id="stockAlertHeaderCount">0 mục</span>
                            </div>
                            <div id="stockAlertList" class="p-2" style="max-height: 280px; overflow-y: auto;">
                                <div class="text-center py-3 text-muted small">
                                    <span class="spinner-border spinner-border-sm text-primary me-1"></span> Đang kiểm tra tồn kho...
                                </div>
                            </div>
                            <div class="alert-dropdown-footer">
                                <a asp-controller="TonKho" asp-action="Index" asp-route-mucTon="thap" class="fw-semibold" style="font-size: 12.5px;">
                                    Xem tồn thấp &rarr;
                                </a>
                                <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-sm btn-primary">
                                    <i class="bi bi-plus-circle me-1"></i> Lập phiếu nhập
                                </a>
                            </div>
                        </div>
                    </div>
                }

                <!-- Menu người dùng -->
                <div class="dropdown">
                    <button class="header-user-pill" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                        <span class="header-user-avatar">
                            @(username.Length > 0 ? username[0].ToString().ToUpper() : "U")
                        </span>
                        <span class="header-user-name d-none d-md-inline">@username</span>
                        <i class="bi bi-chevron-down text-muted" style="font-size: 11px;"></i>
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end shadow-sm mt-2" style="min-width: 200px;">
                        <li class="px-3 py-2">
                            <div class="fw-semibold text-dark">@username</div>
                            <div class="mt-1"><span class="user-role-badge @roleBadgeClass">@roleDisplay</span></div>
                            @if (isNPP && !string.IsNullOrEmpty(tenDoanhNghiep))
                            {
                                <div class="text-muted small mt-1"><i class="bi bi-building me-1"></i>@tenDoanhNghiep</div>
                            }
                        </li>
                        <li><hr class="dropdown-divider"></li>
                        <li>
                            <form asp-controller="Account" asp-action="Logout" method="post">
                                <button class="dropdown-item text-danger" type="submit"><i class="bi bi-box-arrow-right me-2"></i>Đăng xuất</button>
                            </form>
                        </li>
                    </ul>
                </div>
            </div>
        </header>

        <!-- NỘI DUNG CHÍNH -->
        <div class="main-content">
            <main role="main">
                @RenderBody()
            </main>

            <footer class="page-footer">
                &copy; 2026 <strong>Quản lý nhập hàng và lựa chọn nhà cung cấp bằng AHP</strong>
            </footer>
        </div>

        @if (HostEnvironment.IsDevelopment())
        {
        <div id="demoToken" hidden>@Html.AntiForgeryToken()</div>
        <!-- QUICK SWITCHER (Demo) -->
        <div id="quickSwitcher" style="position: fixed; bottom: 16px; right: 16px; z-index: 9999;">
            <button class="btn btn-dark btn-sm shadow-lg rounded-pill px-3 py-2" type="button"
                    data-bs-toggle="collapse" data-bs-target="#quickSwitchPanel"
                    style="font-size: 12px; opacity: 0.85;">
                <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Quick Switch
            </button>
            <div class="collapse mt-2" id="quickSwitchPanel">
                <div class="card shadow-lg border-0" style="border-radius: 12px; width: 260px;">
                    <div class="card-header bg-dark text-white py-2 px-3" style="border-radius: 12px 12px 0 0; font-size: 12px;">
                        <i class="bi bi-lightning-charge-fill text-warning me-1"></i> Chuyển nhanh tài khoản Demo
                    </div>
                    <div class="card-body p-2" id="quickSwitchAccounts">
                        <div class="text-center py-2">
                            <span class="spinner-border spinner-border-sm"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        }
        <script src="~/lib/jquery/dist/jquery.min.js"></script>
        <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
        <script src="~/js/site.js" asp-append-version="true"></script>
        <script>
            function toggleSidebar() {
                document.getElementById('sidebar').classList.toggle('show');
                document.getElementById('sidebarOverlay').classList.toggle('show');
            }

            document.querySelectorAll('.sidebar-link').forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth < 992) {
                        document.getElementById('sidebar').classList.remove('show');
                        document.getElementById('sidebarOverlay').classList.remove('show');
                    }
                });
            });

            document.addEventListener('keydown', function (e) {
                if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === 'k') {
                    e.preventDefault();
                    const searchInput = document.getElementById('globalHeaderSearch');
                    if (searchInput) {
                        searchInput.focus();
                        searchInput.select();
                    }
                }
            });

            // Nạp danh sách cảnh báo tồn kho
            function loadStockAlerts() {
                fetch('/Home/GetLowStockAlerts')
                    .then(res => res.json())
                    .then(data => {
                        const badge = document.getElementById('stockAlertBadge');
                        const headerCount = document.getElementById('stockAlertHeaderCount');
                        const listContainer = document.getElementById('stockAlertList');
                        const bellBtn = document.querySelector('#stockAlertDropdown button');

                        if (!badge || !headerCount || !listContainer) return;

                        if (data && data.count > 0) {
                            badge.innerText = data.count;
                            badge.style.display = 'inline-block';
                            headerCount.innerText = data.count + ' mục';
                            if (bellBtn) bellBtn.classList.add('bell-has-alert');

                            let html = '';
                            data.items.slice(0, 6).forEach(item => {
                                const isOut = item.isOutOfStock;
                                html += `
                                    <a href="/TonKho?search=${encodeURIComponent(item.maCode || item.tenSanPham)}" class="alert-item text-decoration-none mb-1">
                                        <div class="d-flex align-items-center gap-2" style="min-width: 0;">
                                            <div class="alert-item-icon ${isOut ? 'out' : 'low'}">
                                                <i class="bi ${isOut ? 'bi-x-circle' : 'bi-exclamation-triangle'}"></i>
                                            </div>
                                            <div style="min-width: 0;">
                                                <div class="fw-semibold text-truncate" style="font-size: 12.5px;" title="${item.tenSanPham}">${item.tenSanPham}</div>
                                                <div class="text-muted font-mono" style="font-size: 11px;">${item.maCode || ''}</div>
                                            </div>
                                        </div>
                                        <span class="status-badge ${isOut ? 'status-badge-danger' : 'status-badge-warning'}">${item.soLuongTon} ${item.donViTinh}</span>
                                    </a>
                                `;
                            });

                            if (data.count > 6) {
                                html += `<div class="text-center text-muted small py-1" style="font-size: 11.5px;">+ ${data.count - 6} mặt hàng khác...</div>`;
                            }
                            listContainer.innerHTML = html;
                        } else {
                            badge.style.display = 'none';
                            headerCount.innerText = '0 mục';
                            if (bellBtn) bellBtn.classList.remove('bell-has-alert');
                            listContainer.innerHTML = `
                                <div class="text-center py-4 text-muted small">
                                    <i class="bi bi-check-circle text-success fs-3 d-block mb-1"></i>
                                    Kho hàng an toàn, không có mục tồn thấp.
                                </div>
                            `;
                        }
                    })
                    .catch(err => {
                        console.log('Stock alerts load error:', err);
                    });
            }

            // Nạp danh sách tài khoản demo cho Quick Switcher
            function escapeDemoText(value) {
                const element = document.createElement('span'); element.textContent = value; return element.innerHTML;
            }
            function loadQuickSwitchAccounts() {
                if (!document.getElementById("quickSwitcher")) return;
                fetch('/Account/GetDemoAccounts')
                    .then(res => res.json())
                    .then(accounts => {
                        const container = document.getElementById('quickSwitchAccounts');
                        if (!container || !accounts) return;

                        let html = '';
                        const currentUser = '@username';
                        accounts.forEach(acc => {
                            const isCurrent = acc.tenDangNhap === currentUser;
                            const isAdmin = acc.vaiTro === 'admin_san' || acc.vaiTro === 'admin';
                            const isChu = acc.vaiTro === 'chu_npp' || acc.vaiTro === 'quanly';
                            const roleIcon = isAdmin ? '🔴' : acc.laGianHangMall ? '🟢' : '🔵';
                            const roleLabel = isAdmin ? 'Admin Sàn' : isChu ? 'Chủ NPP' : 'NV NPP';
                            const mallBadge = acc.laGianHangMall ? '<span class="badge bg-danger ms-1" style="font-size: 9px;">MALL</span>' : '';
                            html += `
                                <form action="/Account/QuickSwitch" method="post" class="d-block mb-1">
                                    <input type="hidden" name="userId" value="${acc.maNguoiDung}" />
                                    <input type="hidden" name="__RequestVerificationToken" value="${document.querySelector('#demoToken input').value}" />
                                    <button type="submit" class="btn btn-sm w-100 text-start px-2 py-1 ${isCurrent ? 'btn-primary' : 'btn-light'}"
                                            style="font-size: 12px; border-radius: 8px;" ${isCurrent ? 'disabled' : ''}>
                                        <span class="me-1">${roleIcon}</span>
                                        <strong>${escapeDemoText(acc.tenDangNhap)}</strong>
                                        <span class="text-muted ms-1">${roleLabel}</span>
                                        ${mallBadge}
                                        ${isCurrent ? '<i class="bi bi-check-circle-fill text-white ms-1"></i>' : ''}
                                    </button>
                                </form>
                            `;
                        });
                        container.innerHTML = html;
                    })
                    .catch(err => console.log('Quick switch load error:', err));
            }

            document.addEventListener('DOMContentLoaded', function () {
                @if (!isAdminSan)
                {
                    <text>loadStockAlerts();</text>
                }
                loadQuickSwitchAccounts();
            });
        </script>
        @await RenderSectionAsync("Scripts", required: false)
    }
    else
    {
        <!-- PUBLIC TOP NAVBAR -->
        <header class="public-navbar sticky-top bg-white border-bottom shadow-sm">
            <div class="container d-flex align-items-center justify-content-between py-2">
                <a href="/" class="d-flex align-items-center gap-2 text-decoration-none">
                    <img src="~/favicon.svg" alt="B2B Logo" style="width: 38px; height: 38px;" />
                    <div class="d-flex flex-column">
                        <span class="fw-bold text-dark fs-5 lh-1">SÀN B2B <span class="badge bg-primary" style="font-size: 10px; vertical-align: middle;">AHP 2.0</span></span>
                        <small class="text-muted" style="font-size: 11px;">Cổng Phân Phối & Đánh Giá Đối Tác</small>
                    </div>
                </a>

                <nav class="d-none d-lg-flex align-items-center gap-4 public-nav-links">
                    <a href="/#nguon-hang" class="public-nav-item"><i class="bi bi-shop-window me-1 text-primary"></i> Sàn Hàng Sỉ</a>
                    <a href="/#nha-phan-phoi" class="public-nav-item"><i class="bi bi-building me-1 text-primary"></i> Danh Bạ Nhà Phân Phối</a>
                    <a href="/#cong-nghe-ahp" class="public-nav-item"><i class="bi bi-cpu me-1 text-primary"></i> Trợ Lý AHP</a>
                    <a href="/#tai-khoan-demo" class="public-nav-item"><i class="bi bi-lightning-charge me-1 text-warning"></i> Trải Nghiệm Demo</a>
                </nav>

                <div class="d-flex align-items-center gap-2">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-primary btn-sm px-3 py-2 fw-semibold rounded-pill">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập
                    </a>
                    <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-sm px-3 py-2 fw-semibold rounded-pill shadow-sm">
                        <i class="bi bi-person-plus me-1"></i> Đăng ký NPP
                    </a>
                </div>
