    <script>
        document.addEventListener('DOMContentLoaded', function () {
            @if (TempData["SuccessMessage"] != null)
            {
                <text>
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'success',
                        title: '@Html.Raw(TempData["SuccessMessage"])',
                        showConfirmButton: false,
                        timer: 4000,
                        timerProgressBar: true
                    });
                }
                </text>
            }
            @if (TempData["ErrorMessage"] != null)
            {
                <text>
                if (typeof Swal !== 'undefined') {
                    Swal.fire({
                        toast: true,
                        position: 'top-end',
                        icon: 'error',
                        title: '@Html.Raw(TempData["ErrorMessage"])',
                        showConfirmButton: false,
                        timer: 4500,
                        timerProgressBar: true
                    });
                }
                </text>
            }
        });

        function confirmDelete(formId, message) {
            if (typeof Swal !== 'undefined') {
                Swal.fire({
                    title: 'Bạn có chắc chắn?',
                    text: message || 'Thao tác này không thể hoàn tác.',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#2563EB',
                    cancelButtonColor: '#64748B',
                    confirmButtonText: 'Xác nhận xóa',
                    cancelButtonText: 'Hủy'
                }).then((result) => {
                    if (result.isConfirmed) {
                        document.getElementById(formId).submit();
                    }
                });
            } else {
                if (confirm(message || 'Bạn có chắc chắn muốn xóa?')) {
                    document.getElementById(formId).submit();
                }
            }
        }

        // Tự động xử lý lỗi ảnh vỡ toàn hệ thống (Global Image Error Fallback)
        window.addEventListener('error', function (e) {
            if (e.target && e.target.tagName === 'IMG') {
                const img = e.target;
                if (!img.getAttribute('data-fallback-applied')) {
                    img.setAttribute('data-fallback-applied', 'true');
                    // Nếu là ảnh avatar / logo nhà phân phối
                    if (img.classList.contains('supplier-logo') || img.closest('.supplier-avatar-box')) {
                        img.src = '/images/placeholder-supplier.svg';
                    } else {
                        img.src = '/images/placeholder-product.svg';
                    }
                }
            }
        }, true);
    </script>
