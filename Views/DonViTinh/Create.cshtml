@model code.Models.DonViTinh
@{
    ViewData["Title"] = "Thêm đơn vị tính mới";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-custom">
            <div class="card-body-custom">
                <div class="d-flex align-items-center mb-4">
                    <a asp-action="Index" class="btn btn-custom btn-custom-outline me-3" style="padding: 6px 10px;"><i class="bi bi-arrow-left"></i></a>
                    <h4 class="fw-bold mb-0" style="color: var(--gray-900);">Thêm Đơn Vị Tính Mới</h4>
                </div>
                <form asp-action="Create" method="post" class="form-custom">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label asp-for="TenDonVi" class="form-label">Tên đơn vị tính <span style="color: var(--danger);">*</span></label>
                        <input asp-for="TenDonVi" class="form-control" placeholder="Ví dụ: Thùng, Kg, Cái, Chai, Hộp, Gói..." required maxlength="20" />
                        <span asp-validation-for="TenDonVi" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline px-4">Hủy</a>
                        <button type="submit" class="btn btn-custom btn-custom-primary px-4"><i class="bi bi-check-lg me-1"></i> Lưu đơn vị tính</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
