@model code.Models.PhieuNhap
@{
    ViewData["Title"] = "Tạo phiếu nhập mới";
    var ahpDeXuat = ViewBag.NhaCungCapAHPDeXuat as code.Models.KetQuaXepHang;
}

<div class="row justify-content-center">
    <div class="col-lg-7 col-md-9">
        @if (ahpDeXuat != null && ahpDeXuat.NhaCungCap != null)
        {
            <div class="alert alert-warning border-0 shadow-sm rounded-4 mb-3 d-flex align-items-center justify-content-between p-3">
                <div class="d-flex align-items-center">
                    <div class="fs-2 text-warning me-3">
                        <i class="bi bi-trophy-fill"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-dark">
                            Gợi ý từ AHP: @ahpDeXuat.NhaCungCap.TenNhaCungCap
                        </div>
                        <small class="text-secondary">
                            Đạt <strong>@ahpDeXuat.DiemTong?.ToString("0.00") điểm</strong> trong @(ahpDeXuat.KyDanhGia?.TenKyDanhGia ?? "kỳ đánh giá gần nhất").
                        </small>
                    </div>
                </div>
                <button type="button" class="btn btn-sm btn-dark rounded-3" onclick="selectAhpSupplier(@ahpDeXuat.MaNhaCungCap)">
                    <i class="bi bi-check2"></i> Chọn đối tác này
                </button>
            </div>
        }

        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex align-items-center mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3" title="Quay lại">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Tạo Phiếu Nhập Hàng Mới</h4>
                    <small class="text-muted">Bước 1: Điền thông tin đối tác và ngày nhập</small>
                </div>
            </div>

            <form asp-action="Create" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="MaNhaCungCap" class="form-label fw-semibold">Nhà cung cấp đối tác <span class="text-danger">*</span></label>
                    <select asp-for="MaNhaCungCap" id="cboNhaCungCap" class="form-select rounded-3" asp-items="ViewBag.NhaCungCaps" required>
                        <option value="">-- Chọn nhà cung cấp --</option>
                    </select>
                    <span asp-validation-for="MaNhaCungCap" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-4">
                    <div class="col-md-6">
                        <label asp-for="NgayNhap" class="form-label fw-semibold">Ngày nhập hàng</label>
                        <input asp-for="NgayNhap" type="date" class="form-control rounded-3" value="@DateTime.Today.ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="NgayNhap" class="text-danger small"></span>
                    </div>
                    <div class="col-md-6">
                        <label asp-for="TrangThai" class="form-label fw-semibold">Trạng thái khởi tạo</label>
                        <select asp-for="TrangThai" class="form-select rounded-3">
                            <option value="nhap">Chờ xử lý / Nháp</option>
                            <option value="xacnhan">Đã xác nhận</option>
                        </select>
                        <span asp-validation-for="TrangThai" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-arrow-right-circle me-1"></i> Tạo phiếu & Thêm mặt hàng
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function selectAhpSupplier(nccId) {
            const cbo = document.getElementById('cboNhaCungCap');
            if (cbo) {
                cbo.value = nccId;
            }
        }
    </script>
}
