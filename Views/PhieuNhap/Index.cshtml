@model IEnumerable<code.Models.PhieuNhap>
@{
    ViewData["Title"] = "Phiếu nhập hàng";
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly");
    var search = ViewData["Search"] as string;
    var selectedTrangThai = ViewData["SelectedTrangThai"] as string;
}

<div class="page-header">
    <div class="page-header-left">
        <h3>Phiếu nhập hàng</h3>
        <p>Quản lý các đợt nhập hàng từ nhà cung cấp, kiểm tra thành tiền và cập nhật kho</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportExcel" asp-route-search="@search" asp-route-trangThai="@selectedTrangThai" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
        </a>
        <a asp-action="Create" class="btn btn-custom btn-custom-primary">
            <i class="bi bi-plus-circle"></i> Lập phiếu nhập mới
        </a>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-custom alert-custom-danger mb-3"><i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
}

<!-- Bộ lọc & Tìm kiếm -->
<div class="search-bar mb-4">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <div class="input-group" style="flex: 1; min-width: 240px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo mã phiếu hoặc tên nhà cung cấp..." />
        </div>
        <select name="trangThai" class="form-select" style="max-width: 220px;">
            <option value="">-- Tất cả trạng thái --</option>
            <option value="nhap" selected="@(selectedTrangThai == "nhap")">Chờ xử lý / Nháp</option>
            <option value="xacnhan" selected="@(selectedTrangThai == "xacnhan")">Đã xác nhận</option>
            <option value="huy" selected="@(selectedTrangThai == "huy")">Đã hủy</option>
        </select>
        <button type="submit" class="btn btn-custom btn-custom-outline"><i class="bi bi-funnel"></i> Lọc</button>
        @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(selectedTrangThai))
        {
            <a asp-action="Index" class="btn btn-custom btn-custom-outline"><i class="bi bi-arrow-counterclockwise"></i></a>
        }
    </form>
</div>

<!-- Bảng danh sách phiếu nhập -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th style="width: 110px;">Mã phiếu</th>
                    <th>Nhà cung cấp</th>
                    <th>Người tạo</th>
                    <th>Ngày nhập</th>
                    <th class="text-center">Mặt hàng</th>
                    <th class="text-end">Tổng tiền</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var tongTien = (item.TongTien.HasValue && item.TongTien.Value > 0)
                            ? item.TongTien.Value
                            : (item.ChiTietPhieuNhaps?.Sum(c => c.ThanhTien ?? (c.SoLuong * c.DonGia) ?? 0) ?? 0);
                        var maPhieu = item.MaPhieuNhapCode ?? $"PN{item.MaPhieuNhap:D4}";
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="code-badge text-decoration-none">
                                    @maPhieu
                                </a>
                            </td>
                            <td class="fw-semibold" style="color: var(--slate-800);">@(item.NhaCungCap?.TenNhaCungCap ?? "N/A")</td>
                            <td style="color: var(--slate-500);">@(item.NguoiDung?.TenDangNhap ?? "Hệ thống")</td>
                            <td style="color: var(--slate-500);">
                                @(item.NgayNhap?.ToString("dd/MM/yyyy") ?? item.NgayTao?.ToString("dd/MM/yyyy") ?? "—")
                            </td>
                            <td class="text-center" style="color: var(--slate-600);">
                                @(item.ChiTietPhieuNhaps?.Count ?? 0) mặt hàng
                            </td>
                            <td class="text-end font-mono fw-semibold" style="color: var(--slate-900);">
                                @(tongTien.ToString("N0")) đ
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "xacnhan")
                                {
                                    <span class="status-badge status-badge-success">Đã xác nhận</span>
                                }
                                else if (item.TrangThai == "huy")
                                {
                                    <span class="status-badge status-badge-danger">Đã hủy</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-warning">Chờ xử lý</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btn-group">
                                    <a asp-action="Details" asp-route-id="@item.MaPhieuNhap" class="btn btn-sm btn-outline-primary" title="Xem chi tiết & quản lý mặt hàng">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isManagerOrAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaPhieuNhap" class="btn btn-sm btn-outline-secondary" title="Sửa thông tin">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa phiếu"
                                                onclick="confirmDelete(@item.MaPhieuNhap, '@maPhieu')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="8">
                            <div class="empty-state"><i class="bi bi-inbox"></i><p>Không tìm thấy phiếu nhập nào.</p></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_DeleteModal" view-data='new ViewDataDictionary(ViewData) { ["DeleteNote"] = "Toàn bộ chi tiết mặt hàng trong phiếu này cũng sẽ bị xóa bỏ." }' />
