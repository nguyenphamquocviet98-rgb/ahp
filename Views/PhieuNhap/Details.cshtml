@model code.Models.PhieuNhap
@{
    ViewData["Title"] = "Chi tiết phiếu nhập - " + (Model.MaPhieuNhapCode ?? $"PN{Model.MaPhieuNhap:D4}");
    var isManagerOrAdmin = User.IsInRole("chu_npp") || User.IsInRole("quanly");
    var sanPhams = ViewBag.SanPhams as List<code.Models.SanPham> ?? new List<code.Models.SanPham>();
    var maPhieu = Model.MaPhieuNhapCode ?? $"PN{Model.MaPhieuNhap:D4}";

    var tongTien = (Model.TongTien.HasValue && Model.TongTien.Value > 0)
        ? Model.TongTien.Value
        : (Model.ChiTietPhieuNhaps?.Sum(c => c.ThanhTien ?? (c.SoLuong * c.DonGia) ?? 0) ?? 0);
}

@if (Model.PhienBanNhapKho < 2) { <div class="alert alert-warning">Phiếu thuộc cơ chế nhập kho cũ và được giữ để đối soát. Không xác nhận lại để tránh cộng kho hai lần.</div> }
<div class="page-header">
    <div class="page-header-left">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline" title="Quay lại danh sách">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h3 class="mb-0">Phiếu nhập <span class="code-badge fs-6">@maPhieu</span></h3>
                <p class="mb-0">Ngày tạo: @(Model.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</p>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="ExportChiTietExcel" asp-route-id="@Model.MaPhieuNhap" class="btn btn-custom btn-custom-outline" title="Xuất phiếu nhập ra file Excel">
            <i class="bi bi-file-earmark-excel me-1"></i> Xuất Excel
        </a>
        <button type="button" class="btn btn-custom btn-custom-outline" onclick="window.print()" title="In hoặc lưu dạng PDF">
            <i class="bi bi-printer me-1"></i> In phiếu
        </button>
        @if (isManagerOrAdmin)
        {
            <a asp-action="Edit" asp-route-id="@Model.MaPhieuNhap" class="btn btn-custom btn-custom-primary">
                <i class="bi bi-pencil me-1"></i> Sửa thông tin
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-custom alert-custom-danger mb-3">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Thông tin chung -->
<div class="card-custom mb-4">
    <div class="card-body-custom">
        <div class="row g-3">
            <div class="col-md-4">
                <div class="p-3 h-100" style="background: var(--slate-50); border-radius: var(--radius-md);">
                    <span style="color: var(--slate-400); font-size: 12.5px;">Nhà cung cấp</span>
                    <div class="fw-semibold" style="color: var(--primary-700);">@(Model.NhaCungCap?.TenNhaCungCap ?? "N/A")</div>
                    <div class="small mt-1" style="color: var(--slate-500);">
                        Người LH: @(Model.NhaCungCap?.NguoiLienHe ?? "—") · SĐT: @(Model.NhaCungCap?.SoDienThoai ?? "—")
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 h-100" style="background: var(--slate-50); border-radius: var(--radius-md);">
                    <span style="color: var(--slate-400); font-size: 12.5px;">Thông tin chứng từ</span>
                    <div class="small">Ngày nhập: <strong style="color: var(--slate-800);">@(Model.NgayNhap?.ToString("dd/MM/yyyy") ?? "N/A")</strong></div>
                    <div class="small mt-1" style="color: var(--slate-500);">Người lập: <strong style="color: var(--slate-800);">@(Model.NguoiDung?.TenDangNhap ?? "Hệ thống")</strong></div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="p-3 h-100" style="background: var(--slate-50); border-radius: var(--radius-md);">
                    <span style="color: var(--slate-400); font-size: 12.5px;">Trạng thái phiếu</span>
                    <div class="mb-2">
                        @if (Model.TrangThai == "xacnhan")
                        {
                            <span class="status-badge status-badge-success">Đã xác nhận</span>
                        }
                        else if (Model.TrangThai == "huy")
                        {
                            <span class="status-badge status-badge-danger">Đã hủy</span>
                        }
                        else
                        {
                            <span class="status-badge status-badge-warning">Chờ xử lý / Nháp</span>
                        }
                    </div>

                    @if (isManagerOrAdmin)
                    {
                        <div class="d-flex gap-1">
                            @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                            {
                                <form asp-action="DoiTrangThai" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maPhieuNhap" value="@Model.MaPhieuNhap" />
                                    <input type="hidden" name="trangThaiMoi" value="xacnhan" />
                                    <button type="submit" class="btn btn-sm btn-custom btn-custom-emerald" onclick="return confirm('Xác nhận hoàn thành phiếu nhập này?')">
                                        <i class="bi bi-check2 me-1"></i> Xác nhận
                                    </button>
                                </form>
                            }
                            @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                            {
                                <form asp-action="DoiTrangThai" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="maPhieuNhap" value="@Model.MaPhieuNhap" />
                                    <input type="hidden" name="trangThaiMoi" value="huy" />
                                    <button type="submit" class="btn btn-sm btn-custom btn-custom-outline" style="color: var(--rose-700);" onclick="return confirm('Bạn có chắc chắn muốn hủy phiếu nhập này?')">
                                        <i class="bi bi-x me-1"></i> Hủy phiếu
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Danh sách mặt hàng -->
<div class="card-custom mb-4">
    <div class="card-header-custom">
        <div>
            <h5 class="mb-0"><i class="bi bi-boxes text-primary"></i> Danh sách mặt hàng nhập</h5>
            <small style="color: var(--slate-400);">Tổng số mặt hàng: @(Model.ChiTietPhieuNhaps?.Count ?? 0)</small>
        </div>
        @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
        {
            <button type="button" class="btn btn-custom btn-custom-primary" data-bs-toggle="modal" data-bs-target="#themSanPhamModal">
                <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm vào phiếu
            </button>
        }
    </div>

    <div class="card-body-custom p-0">
        @if (Model.ChiTietPhieuNhaps != null && Model.ChiTietPhieuNhaps.Any())
        {
            <div class="table-responsive">
                <table class="table-custom">
                    <thead>
                        <tr>
                            <th style="width: 50px;" class="text-center">STT</th>
                            <th style="width: 110px;">Mã SP</th>
                            <th>Tên sản phẩm</th>
                            <th class="text-center" style="width: 90px;">ĐVT</th>
                            <th class="text-center" style="width: 100px;">Số lượng</th>
                            <th class="text-end" style="width: 140px;">Đơn giá nhập</th>
                            <th class="text-end" style="width: 150px;">Thành tiền</th>
                            @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                            {
                                <th class="text-center" style="width: 110px;">Thao tác</th>
                            }
                        </tr>
                    </thead>
                    <tbody>
                        @{ int stt = 1; }
                        @foreach (var ct in Model.ChiTietPhieuNhaps)
                        {
                            var sp = ct.SanPham;
                            var tt = ct.ThanhTien ?? (ct.SoLuong * ct.DonGia ?? 0);
                            <tr>
                                <td class="text-center" style="color: var(--slate-400);">@(stt++)</td>
                                <td><span class="code-badge">@(sp?.MaSanPhamCode ?? $"SP{sp?.MaSanPham:D3}")</span></td>
                                <td class="fw-semibold" style="color: var(--slate-800);">@(sp?.TenSanPham ?? "N/A")</td>
                                <td class="text-center">@(sp?.DonViTinh?.TenDonVi ?? "-")</td>
                                <td class="text-center fw-bold font-mono">@ct.SoLuong</td>
                                <td class="text-end font-mono">@((ct.DonGia ?? 0).ToString("N0")) đ</td>
                                <td class="text-end font-mono fw-semibold text-primary">@(tt.ToString("N0")) đ</td>
                                @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                                {
                                    <td class="text-center">
                                        <div class="action-btn-group">
                                            <button type="button" class="btn btn-sm btn-outline-secondary" title="Sửa số lượng/đơn giá"
                                                    onclick="openEditDetail(@ct.MaChiTiet, '@sp?.TenSanPham', @(ct.SoLuong ?? 0), @(ct.DonGia ?? 0))">
                                                <i class="bi bi-pencil"></i>
                                            </button>
                                            <form asp-action="XoaChiTiet" method="post" class="d-inline" onsubmit="return confirm('Xóa sản phẩm này khỏi phiếu?')">
                                                @Html.AntiForgeryToken()
                                                <input type="hidden" name="maChiTiet" value="@ct.MaChiTiet" />
                                                <button type="submit" class="btn btn-sm btn-outline-danger" title="Xóa">
                                                    <i class="bi bi-trash"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                }
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <td colspan="@(Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap" ? 6 : 5)" class="text-end fw-semibold text-uppercase" style="background: var(--slate-50);">
                                Tổng cộng tiền hàng:
                            </td>
                            <td class="text-end fw-bold text-danger" style="background: var(--slate-50); font-size: 15px;">
                                @(tongTien.ToString("N0")) VNĐ
                            </td>
                            @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                            {
                                <td style="background: var(--slate-50);"></td>
                            }
                        </tr>
                    </tfoot>
                </table>
            </div>
        }
        else
        {
            <div class="empty-state">
                <i class="bi bi-inbox"></i>
                <p class="mb-2">Phiếu nhập này chưa có sản phẩm nào.</p>
                @if (Model.PhienBanNhapKho >= 2 && Model.TrangThai == "nhap")
                {
                    <button type="button" class="btn btn-sm btn-custom btn-custom-primary" data-bs-toggle="modal" data-bs-target="#themSanPhamModal">
                        <i class="bi bi-plus-circle me-1"></i> Thêm sản phẩm đầu tiên
                    </button>
                }
            </div>
        }
    </div>
</div>

<!-- Khung chữ ký khi in ấn / xuất PDF -->
<div class="d-none d-print-block mt-5 pt-4">
    <div class="row text-center">
        <div class="col-4">
            <strong class="d-block text-uppercase" style="font-size: 13px;">Người Lập Phiếu</strong>
            <span class="text-muted small fst-italic">(Ký, ghi rõ họ tên)</span>
            <div style="height: 70px;"></div>
            <div class="fw-semibold">@(Model.NguoiDung?.TenDangNhap ?? "........................")</div>
        </div>
        <div class="col-4">
            <strong class="d-block text-uppercase" style="font-size: 13px;">Thủ Kho</strong>
            <span class="text-muted small fst-italic">(Ký, ghi rõ họ tên)</span>
            <div style="height: 70px;"></div>
            <div class="fw-semibold">....................................</div>
        </div>
        <div class="col-4">
            <strong class="d-block text-uppercase" style="font-size: 13px;">Đại Diện Nhà Cung Cấp</strong>
            <span class="text-muted small fst-italic">(Ký, đóng dấu)</span>
            <div style="height: 70px;"></div>
            <div class="fw-semibold">@(Model.NhaCungCap?.TenNhaCungCap ?? "........................")</div>
        </div>
    </div>
</div>

<!-- Modal Thêm sản phẩm vào phiếu -->
<div class="modal fade" id="themSanPhamModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-plus-circle text-primary me-2"></i>Thêm sản phẩm vào phiếu nhập
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="ThemChiTiet" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maPhieuNhap" value="@Model.MaPhieuNhap" />

                <div class="modal-body py-3">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Tìm kiếm &amp; Chọn sản phẩm <span class="text-danger">*</span></label>

                        <div class="input-group mb-2">
                            <span class="input-group-text"><i class="bi bi-search"></i></span>
                            <input type="text" id="modalSearchProduct" class="form-control"
                                   placeholder="Gõ tên hoặc mã sản phẩm để lọc nhanh..."
                                   oninput="filterModalProducts()" />
                            <button type="button" class="btn btn-outline-secondary" onclick="clearModalSearch()" title="Xóa tìm kiếm">
                                <i class="bi bi-x-lg"></i>
                            </button>
                        </div>

                        <select name="maSanPham" id="cboSanPham" class="form-select" required onchange="onSanPhamSelected()">
                            <option value="">-- Chọn sản phẩm (@(sanPhams.Count) sản phẩm có sẵn) --</option>
                            @foreach (var sp in sanPhams)
                            {
                                <option value="@sp.MaSanPham"
                                        data-search="@($"{sp.MaSanPhamCode} {sp.TenSanPham} {sp.DonViTinh?.TenDonVi}".ToLower())"
                                        data-price="@(sp.GiaMacDinh ?? 0)"
                                        data-unit="@(sp.DonViTinh?.TenDonVi ?? "")">
                                    @(sp.MaSanPhamCode ?? $"SP{sp.MaSanPham:D3}") - @sp.TenSanPham (@(sp.DonViTinh?.TenDonVi ?? "Cái")) - @((sp.GiaMacDinh ?? 0).ToString("N0")) đ
                                </option>
                            }
                        </select>
                        <div id="searchMatchCount" class="form-text small mt-1"></div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số lượng nhập <span class="text-danger">*</span></label>
                            <input type="number" name="soLuong" id="txtSoLuong" class="form-control" value="1" min="1" required oninput="calcPreview()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="donGia" id="txtDonGia" class="form-control" value="0" min="0" step="1000" required oninput="calcPreview()" />
                        </div>
                    </div>

                    <div class="p-3 text-end" style="background: var(--slate-50); border-radius: var(--radius-md);">
                        <span class="text-muted small">Thành tiền tạm tính:</span>
                        <h5 class="fw-bold text-primary mb-0" id="lblThanhTienPreview">0 đ</h5>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-custom btn-custom-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-custom btn-custom-primary">
                        <i class="bi bi-plus-lg me-1"></i> Thêm vào phiếu
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Sửa số lượng / đơn giá -->
<div class="modal fade" id="suaChiTietModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title fw-bold">
                    <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa sản phẩm
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form asp-action="SuaChiTiet" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="maChiTiet" id="editMaChiTiet" />

                <div class="modal-body py-3">
                    <div class="mb-3">
                        <span class="text-muted small d-block">Sản phẩm:</span>
                        <strong style="color: var(--slate-800);" id="editTenSanPham"></strong>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Số lượng nhập <span class="text-danger">*</span></label>
                            <input type="number" name="soLuong" id="editSoLuong" class="form-control" min="1" required oninput="calcEditPreview()" />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Đơn giá nhập (VNĐ) <span class="text-danger">*</span></label>
                            <input type="number" name="donGia" id="editDonGia" class="form-control" min="0" step="1000" required oninput="calcEditPreview()" />
                        </div>
                    </div>

                    <div class="p-3 text-end" style="background: var(--slate-50); border-radius: var(--radius-md);">
                        <span class="text-muted small">Thành tiền mới:</span>
                        <h5 class="fw-bold text-primary mb-0" id="lblEditThanhTienPreview">0 đ</h5>
                    </div>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-custom btn-custom-outline" data-bs-dismiss="modal">Hủy</button>
                    <button type="submit" class="btn btn-custom btn-custom-primary">
                        <i class="bi bi-check-lg me-1"></i> Lưu thay đổi
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filterModalProducts() {
            const keyword = document.getElementById('modalSearchProduct').value.trim().toLowerCase();
            const select = document.getElementById('cboSanPham');
            const options = select.options;
            let matchCount = 0;
            let firstMatchIndex = -1;

            for (let i = 1; i < options.length; i++) {
                const searchData = options[i].getAttribute('data-search') || options[i].text.toLowerCase();
                if (!keyword || searchData.includes(keyword)) {
                    options[i].style.display = '';
                    options[i].disabled = false;
                    matchCount++;
                    if (firstMatchIndex === -1) firstMatchIndex = i;
                } else {
                    options[i].style.display = 'none';
                    options[i].disabled = true;
                }
            }

            const countEl = document.getElementById('searchMatchCount');
            if (keyword) {
                countEl.innerHTML = `<i class="bi bi-funnel"></i> Tìm thấy <strong>${matchCount}</strong> sản phẩm phù hợp.`;
                if (firstMatchIndex !== -1 && matchCount === 1) {
                    select.selectedIndex = firstMatchIndex;
                    onSanPhamSelected();
                }
            } else {
                countEl.innerText = '';
            }
        }

        function clearModalSearch() {
            document.getElementById('modalSearchProduct').value = '';
            filterModalProducts();
        }

        // Tự động focus vào ô tìm kiếm khi mở Modal
        const themModalEl = document.getElementById('themSanPhamModal');
        if (themModalEl) {
            themModalEl.addEventListener('shown.bs.modal', function () {
                document.getElementById('modalSearchProduct').focus();
            });
        }

        function onSanPhamSelected() {
            const select = document.getElementById('cboSanPham');
            const selectedOption = select.options[select.selectedIndex];
            const price = selectedOption.getAttribute('data-price') || 0;
            document.getElementById('txtDonGia').value = price;
            calcPreview();
        }

        function calcPreview() {
            const qty = parseFloat(document.getElementById('txtSoLuong').value) || 0;
            const price = parseFloat(document.getElementById('txtDonGia').value) || 0;
            const total = qty * price;
            document.getElementById('lblThanhTienPreview').innerText = total.toLocaleString('vi-VN') + ' đ';
        }

        function openEditDetail(id, name, qty, price) {
            document.getElementById('editMaChiTiet').value = id;
            document.getElementById('editTenSanPham').innerText = name;
            document.getElementById('editSoLuong').value = qty;
            document.getElementById('editDonGia').value = price;
            calcEditPreview();
            bootstrap.Modal.getOrCreateInstance(document.getElementById('suaChiTietModal')).show();
        }

        function calcEditPreview() {
            const qty = parseFloat(document.getElementById('editSoLuong').value) || 0;
            const price = parseFloat(document.getElementById('editDonGia').value) || 0;
            const total = qty * price;
            document.getElementById('lblEditThanhTienPreview').innerText = total.toLocaleString('vi-VN') + ' đ';
        }
    </script>
}
