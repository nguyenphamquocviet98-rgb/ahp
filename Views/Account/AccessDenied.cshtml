@{
    ViewData["Title"] = "Không có quyền truy cập";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 text-center">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <div class="mb-3">
                    <i class="bi bi-shield-x text-danger" style="font-size: 4rem;"></i>
                </div>
                <h2 class="text-danger fw-bold">403 - TỪ CHỐI TRUY CẬP</h2>
                <p class="text-muted mt-2">
                    Bạn không có quyền thực hiện chức năng này với vai trò hiện tại (<strong>@(User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "Không xác định")</strong>).
                </p>
                <div class="mt-4">
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary px-4">
                        <i class="bi bi-house-door me-1"></i> Quay về trang chủ
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
