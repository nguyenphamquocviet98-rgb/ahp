@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống — Quản lý Nhập Hàng AHP";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/svg+xml" href="~/favicon.svg" />
    <link rel="alternate icon" type="image/x-icon" href="~/favicon.ico" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
        :root {
            --font-main: 'Be Vietnam Pro', 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
            --primary: #1E60D5;
            --primary-hover: #174EAE;
            --primary-light: #EFF6FF;
            --border-color: #E2E8F0;
            --bg-page: #F8FAFC;
        }

        body {
            font-family: var(--font-main);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
            background-color: var(--bg-page);
            background-image: radial-gradient(at 50% 0%, #EFF6FF 0px, transparent 60%),
                              radial-gradient(at 100% 100%, #F1F5F9 0px, transparent 50%);
            margin: 0;
            -webkit-font-smoothing: antialiased;
        }

        .login-card {
            width: 100%;
            max-width: 440px;
            background: #FFFFFF;
            border: 1px solid var(--border-color);
            border-radius: 20px;
            padding: 2.5rem 2.25rem;
            box-shadow: 0 10px 30px -5px rgba(30, 96, 213, 0.08), 0 4px 12px -2px rgba(15, 23, 42, 0.04);
            animation: fadeIn 0.3s ease-out;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(8px); }
            to { opacity: 1; transform: translateY(0); }
        }

        .login-brand-icon {
            width: 52px;
            height: 52px;
            margin: 0 auto 16px;
            background: #EFF6FF;
            border: 1px solid #DBEAFE;
            border-radius: 14px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--primary);
            font-size: 26px;
        }

        .login-title {
            font-size: 22px;
            font-weight: 800;
            color: #0F172A;
            text-align: center;
            margin-bottom: 4px;
            letter-spacing: -0.02em;
        }

        .login-subtitle {
            font-size: 13.5px;
            color: #64748B;
            text-align: center;
            margin-bottom: 2rem;
            line-height: 1.4;
        }

        .form-label {
            font-size: 13px;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .form-control {
            border-radius: 12px;
            border: 1px solid var(--border-color);
            font-size: 14px;
            padding: 10px 14px;
            color: #0F172A;
            background: #FFFFFF;
            transition: all 0.15s ease;
        }

        .form-control:focus {
            border-color: var(--primary);
            box-shadow: 0 0 0 3px rgba(30, 96, 213, 0.12);
            outline: none;
        }

        .input-group .btn {
            border-radius: 0 12px 12px 0 !important;
            border: 1px solid var(--border-color);
            border-left: none;
            background: #FFFFFF;
            color: #64748B;
        }

        .input-group .form-control {
            border-radius: 12px 0 0 12px !important;
        }

        .btn-login-submit {
            background: var(--primary);
            border: none;
            border-radius: 12px;
            padding: 11px;
            font-size: 14.5px;
            font-weight: 600;
            color: #FFFFFF;
            width: 100%;
            cursor: pointer;
            transition: all 0.15s ease;
            box-shadow: 0 2px 6px rgba(30, 96, 213, 0.25);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 6px;
        }

        .btn-login-submit:hover {
            background: var(--primary-hover);
            color: #FFFFFF;
            transform: translateY(-1px);
            box-shadow: 0 4px 12px rgba(30, 96, 213, 0.35);
        }

        .demo-roles-container {
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border-color);
        }

        .demo-roles-title {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            color: #94A3B8;
            margin-bottom: 10px;
            text-align: center;
        }

        .demo-btn-group {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .demo-role-btn {
            border: 1px solid var(--border-color);
            background: #FFFFFF;
            border-radius: 12px;
            padding: 10px 6px;
            text-align: center;
            cursor: pointer;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 3px;
            width: 100%;
            outline: none;
            transition: all 0.15s ease;
        }

        .demo-role-btn:hover {
            background: #EFF6FF;
            border-color: #BFDBFE;
            transform: translateY(-1px);
        }

        .demo-role-btn .role-badge {
            font-size: 12px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 4px;
            color: #1E293B;
        }

        .demo-role-btn .role-acc {
            font-size: 11px;
            color: #64748B;
            font-family: 'JetBrains Mono', monospace;
        }

        .public-portal-link {
            text-align: center;
            margin-top: 1.25rem;
            font-size: 13px;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-brand-icon">
            <i class="bi bi-diagram-3-fill"></i>
        </div>
        <div class="login-title">Hệ Thống Nhập Hàng AHP</div>
        <div class="login-subtitle">Lựa chọn nhà cung cấp đa tiêu chí & Quản trị kho sỉ B2B</div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger border-0 d-flex align-items-center mb-3 py-2 px-3 small" style="border-radius: 12px;" role="alert">
                <i class="bi bi-exclamation-circle-fill fs-5 me-2 text-danger flex-shrink-0"></i>
                <div class="flex-grow-1">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger d-inline list-unstyled mb-0" })
                </div>
            </div>
        }

        <form asp-action="Login" method="post" id="loginForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

            <div class="mb-3">
                <label asp-for="TenDangNhap" class="form-label">Tên tài khoản</label>
                <input asp-for="TenDangNhap" id="txtUsername" class="form-control" placeholder="admin / quanly / nhanvien" required autocomplete="username" />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="mb-4">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label asp-for="MatKhau" class="form-label mb-0">Mật khẩu</label>
                </div>
                <div class="input-group">
                    <input asp-for="MatKhau" id="txtPassword" type="password" class="form-control" placeholder="••••••••" required autocomplete="current-password" />
                    <button type="button" class="btn btn-outline-secondary" id="togglePasswordBtn" title="Hiện/Ẩn mật khẩu" onclick="togglePasswordVisibility()">
                        <i class="bi bi-eye" id="toggleIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <button type="submit" id="btnLoginSubmit" class="btn btn-login-submit">
                <i class="bi bi-box-arrow-in-right"></i> Đăng nhập hệ thống
            </button>
        </form>

        @if (HostEnvironment.IsDevelopment())
        {
        <!-- Đăng nhập nhanh Demo -->
        <div class="demo-roles-container">
            <div class="demo-roles-title">Đăng nhập tài khoản mẫu (1 click)</div>
            <div class="demo-btn-group">
                <button type="button" class="demo-role-btn" onclick="quickFill('admin', '123456')" title="Quản trị viên Sàn B2B">
                    <span class="role-badge"><i class="bi bi-shield-lock-fill text-primary"></i> Admin</span>
                    <span class="role-acc">admin</span>
                </button>
                <button type="button" class="demo-role-btn" onclick="quickFill('quanly', '123456')" title="Chủ Nhà Phân Phối / Quản lý">
                    <span class="role-badge"><i class="bi bi-briefcase-fill text-success"></i> Chủ NPP</span>
                    <span class="role-acc">quanly</span>
                </button>
                <button type="button" class="demo-role-btn" onclick="quickFill('nhanvien', '123456')" title="Nhân viên Nghiệp vụ kho">
                    <span class="role-badge"><i class="bi bi-person-fill text-secondary"></i> Nhân viên</span>
                    <span class="role-acc">nhanvien</span>
                </button>
            </div>
        </div>
        }

        <div class="public-portal-link">
            <a asp-controller="Home" asp-action="Landing" class="text-muted text-decoration-none">
                <i class="bi bi-globe me-1"></i> Xem Cổng Chợ Sỉ B2B Công Khai &rarr;
            </a>
        </div>
    </div>

    <script>
        function togglePasswordVisibility() {
            const pwd = document.getElementById('txtPassword');
            const icon = document.getElementById('toggleIcon');
            if (pwd.type === 'password') {
                pwd.type = 'text';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            } else {
                pwd.type = 'password';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            }
        }

        function quickFill(username, password) {
            const userInp = document.getElementById('txtUsername');
            const passInp = document.getElementById('txtPassword');
            const form = document.getElementById('loginForm');
            if (userInp && passInp && form) {
                userInp.value = username;
                passInp.value = password;
                form.submit();
            }
        }
    </script>
</body>
</html>
