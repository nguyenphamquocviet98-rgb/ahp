@model LoginViewModel
@{
    ViewData["Title"] = "Đăng nhập hệ thống";
    Layout = null;
}

<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - ProcureAHP</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet">
    <style>
        body {
            background-color: #F8FAFC;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
            padding: 1.5rem;
            color: #1E293B;
            -webkit-font-smoothing: antialiased;
        }
        .login-card {
            background: #FFFFFF;
            border-radius: 12px;
            border: 1px solid #E2E8F0;
            box-shadow: 0 1px 3px 0 rgba(15, 23, 42, 0.06), 0 1px 2px -1px rgba(15, 23, 42, 0.04);
            width: 100%;
            max-width: 440px;
            padding: 2.25rem;
        }
        .login-header {
            text-align: center;
            margin-bottom: 1.75rem;
        }
        .login-header .logo-badge {
            width: 44px;
            height: 44px;
            background: #0F172A;
            color: #FFFFFF;
            border-radius: 10px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            margin-bottom: 0.75rem;
        }
        .login-header h2 {
            font-size: 20px;
            font-weight: 700;
            color: #0F172A;
            letter-spacing: -0.02em;
            margin-bottom: 0.25rem;
        }
        .login-header p {
            color: #64748B;
            font-size: 13px;
            margin-bottom: 0;
        }
        .form-label {
            font-size: 12.5px;
            font-weight: 500;
            color: #334155;
            margin-bottom: 4px;
        }
        .form-control {
            border-radius: 6px;
            border: 1px solid #CBD5E1;
            font-size: 13.5px;
            padding: 8px 12px;
            color: #0F172A;
        }
        .form-control:focus {
            border-color: #2563EB;
            box-shadow: 0 0 0 2px #EFF6FF;
            outline: none;
        }
        .password-toggle-btn {
            position: absolute;
            right: 10px;
            top: 50%;
            transform: translateY(-50%);
            background: none;
            border: none;
            color: #94A3B8;
            font-size: 16px;
            cursor: pointer;
            z-index: 5;
            padding: 4px 6px;
            border-radius: 4px;
        }
        .password-toggle-btn:hover {
            color: #334155;
        }
        .btn-login {
            background: #0F172A;
            border: 1px solid #0F172A;
            border-radius: 6px;
            padding: 9px;
            font-size: 14px;
            font-weight: 600;
            color: #FFFFFF;
            transition: all 150ms ease;
        }
        .btn-login:hover {
            background: #1E293B;
            border-color: #1E293B;
            color: #FFFFFF;
        }
        .forgot-link {
            color: #2563EB;
            text-decoration: none;
            font-size: 12.5px;
            font-weight: 500;
        }
        .forgot-link:hover {
            text-decoration: underline;
        }
        .demo-accounts {
            background: #F8FAFC;
            border: 1px solid #E2E8F0;
            border-radius: 8px;
            padding: 1rem;
            margin-top: 1.5rem;
        }
        .demo-item {
            background: #FFFFFF;
            border: 1px solid #E2E8F0;
            border-radius: 6px;
            padding: 7px 10px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            cursor: pointer;
            transition: all 150ms ease;
            margin-bottom: 6px;
        }
        .demo-item:last-child {
            margin-bottom: 0;
        }
        .demo-item:hover {
            border-color: #CBD5E1;
            background: #F1F5F9;
        }
    </style>
</head>
<body>
    <div class="login-card">
        <div class="login-header">
            <div class="logo-badge">
                <i class="bi bi-box-seam-fill"></i>
            </div>
            <h2>ProcureAHP</h2>
            <p>Hệ thống Quản lý Nhập hàng & AHP</p>
        </div>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="alert alert-danger py-2 px-3 mb-3 small" role="alert">
                <div asp-validation-summary="All" class="text-danger mb-0"></div>
            </div>
        }

        <form asp-controller="Account" asp-action="Login" method="post" id="loginForm">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-3">
                <label class="form-label" asp-for="TenDangNhap">Tên đăng nhập</label>
                <input asp-for="TenDangNhap" class="form-control" id="txtTenDangNhap" placeholder="admin" required autocomplete="username" />
                <span asp-validation-for="TenDangNhap" class="text-danger small"></span>
            </div>

            <div class="mb-3">
                <div class="d-flex justify-content-between align-items-center mb-1">
                    <label class="form-label mb-0" asp-for="MatKhau">Mật khẩu</label>
                    <a href="javascript:void(0)" class="forgot-link" data-bs-toggle="modal" data-bs-target="#forgotModal">
                        Quên mật khẩu?
                    </a>
                </div>
                <div class="position-relative">
                    <input asp-for="MatKhau" type="password" class="form-control pe-5" id="txtMatKhau" placeholder="••••••" required autocomplete="current-password" />
                    <button type="button" class="password-toggle-btn" id="btnTogglePassword" title="Ẩn/Hiện mật khẩu" tabindex="-1">
                        <i class="bi bi-eye-slash" id="eyeIcon"></i>
                    </button>
                </div>
                <span asp-validation-for="MatKhau" class="text-danger small"></span>
            </div>

            <div class="form-check mb-3">
                <input class="form-check-input" type="checkbox" asp-for="GhiNhoDangNhap" id="chkGhiNho">
                <label class="form-check-label small" style="color: #64748B;" for="chkGhiNho">
                    Ghi nhớ phiên đăng nhập
                </label>
            </div>

            <button type="submit" class="btn btn-login w-100 mb-2">
                Đăng nhập
            </button>
        </form>

        <div class="demo-accounts">
            <div class="small fw-semibold text-muted mb-2">Tài khoản demo (Bấm để điền nhanh):</div>
            <div class="demo-item" onclick="fillAccount('admin', 'Admin@123', 'Admin')" role="button">
                <div>
                    <span class="badge" style="background: #0F172A; font-size: 10.5px;">admin</span>
                    <span class="small ms-1 fw-medium" style="color: #334155;">Quản trị viên</span>
                </div>
                <span class="small text-muted font-mono">Admin@123</span>
            </div>

            <div class="demo-item" onclick="fillAccount('quanly', 'Quanly@123', 'Quản lý')" role="button">
                <div>
                    <span class="badge" style="background: #EFF6FF; color: #2563EB; border: 1px solid #DBEAFE; font-size: 10.5px;">quanly</span>
                    <span class="small ms-1 fw-medium" style="color: #334155;">Quản lý</span>
                </div>
                <span class="small text-muted font-mono">Quanly@123</span>
            </div>

            <div class="demo-item" onclick="fillAccount('nhanvien', 'Nhanvien@123', 'Nhân viên')" role="button">
                <div>
                    <span class="badge" style="background: #F1F5F9; color: #475569; border: 1px solid #E2E8F0; font-size: 10.5px;">nhanvien</span>
                    <span class="small ms-1 fw-medium" style="color: #334155;">Nhân viên</span>
                </div>
                <span class="small text-muted font-mono">Nhanvien@123</span>
            </div>
        </div>
    </div>

    <!-- Modal Quên mật khẩu -->
    <div class="modal fade" id="forgotModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content" style="border-radius: 10px; border: 1px solid #E2E8F0;">
                <div class="modal-header">
                    <h6 class="modal-title fw-bold" style="color: #0F172A;"><i class="bi bi-info-circle me-1 text-primary"></i> Khôi phục mật khẩu</h6>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body py-3">
                    <p class="small text-muted mb-2">
                        Để đảm bảo an toàn nội bộ, hệ thống không cấp lại mật khẩu qua email tự động.
                    </p>
                    <div class="p-3 bg-light rounded-2 border small text-secondary">
                        Vui lòng liên hệ <strong>Quản trị viên (admin)</strong> để được hỗ trợ cấp lại mật khẩu mới.
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-sm btn-secondary px-3" data-bs-dismiss="modal">Đã hiểu</button>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        const toggleBtn = document.getElementById('btnTogglePassword');
        const pwdInput = document.getElementById('txtMatKhau');
        const eyeIcon = document.getElementById('eyeIcon');

        toggleBtn.addEventListener('click', function () {
            if (pwdInput.type === 'password') {
                pwdInput.type = 'text';
                eyeIcon.classList.remove('bi-eye-slash');
                eyeIcon.classList.add('bi-eye');
            } else {
                pwdInput.type = 'password';
                eyeIcon.classList.remove('bi-eye');
                eyeIcon.classList.add('bi-eye-slash');
            }
        });

        function fillAccount(username, password, roleName) {
            document.getElementById('txtTenDangNhap').value = username;
            document.getElementById('txtMatKhau').value = password;
        }
    </script>
</body>
</html>
