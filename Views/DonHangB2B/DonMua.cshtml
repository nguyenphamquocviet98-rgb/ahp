@model IEnumerable<code.Models.DonHangB2B>

@{
    ViewData["Title"] = "Đơn Hàng Sỉ Đã Đặt Mua";
    string currentStatus = ViewBag.Status ?? "";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-controller="SanB2B" asp-action="Index">Sàn B2B</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đơn Mua Của Tôi</li>
            </ol>
        </nav>
        <h2 class="page-title">Quản lý Đơn Hàng Đã Đặt Mua</h2>
        <p class="text-muted mb-0 small">Theo dõi tiến trình xử lý, giao hàng và xác nhận nhập kho từ các đối tác NPP.</p>
    </div>
    <div>
        <a asp-controller="SanB2B" asp-action="Index" class="btn btn-primary rounded-3">
            <i class="bi bi-cart-plus me-1"></i> Khám phá Chợ Sỉ B2B
        </a>
    </div>
</div>

<!-- Tabs lọc theo trạng thái -->
<div class="card shadow-sm border-0 rounded-3 mb-4">
    <div class="card-body p-2">
        <ul class="nav nav-pills gap-1">
            <li class="nav-item">
                <a class="nav-link @(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="DonMua">
                    Tất cả
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "cho_duyet" ? "active" : "")" asp-action="DonMua" asp-route-status="cho_duyet">
                    ⏳ Chờ đối tác duyệt
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "da_duyet" ? "active" : "")" asp-action="DonMua" asp-route-status="da_duyet">
                    📦 Đã duyệt
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "dang_giao" ? "active" : "")" asp-action="DonMua" asp-route-status="dang_giao">
                    🚚 Đang giao hàng
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "hoan_thanh" ? "active" : "")" asp-action="DonMua" asp-route-status="hoan_thanh">
                    ✅ Hoàn thành
                </a>
            </li>
            <li class="nav-item">
                <a class="nav-link @(currentStatus == "huy" ? "active" : "")" asp-action="DonMua" asp-route-status="huy">
                    ❌ Đã hủy
                </a>
            </li>
        </ul>
    </div>
</div>

<!-- Danh sách đơn hàng -->
<div class="card shadow-sm border-0 rounded-3">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Mã đơn hàng</th>
                    <th>Đối tác bán (NPP)</th>
                    <th>Mặt hàng</th>
                    <th class="text-end">Tổng tiền (VNĐ)</th>
                    <th class="text-center">Ngày đặt</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                <a asp-action="Details" asp-route-id="@item.MaDonHang" class="fw-bold text-decoration-none">
                                    @item.MaDonHangCode
                                </a>
                            </td>
                            <td>
                                <div class="fw-bold">
                                    @item.NPPBan?.TenDoanhNghiep
                                    @if (item.NPPBan != null && item.NPPBan.LaGianHangMall)
                                    {
                                        <span class="badge bg-danger ms-1 small">MALL</span>
                                    }
                                </div>
                                <small class="text-muted">ĐT: @(item.NPPBan?.SoDienThoai ?? "---")</small>
                            </td>
                            <td>
                                @if (item.ChiTietDonHangs != null && item.ChiTietDonHangs.Any())
                                {
                                    <div>@item.ChiTietDonHangs.First().SanPham?.TenSanPham</div>
                                    @if (item.ChiTietDonHangs.Count > 1)
                                    {
                                        <small class="text-muted">+@(item.ChiTietDonHangs.Count - 1) mặt hàng khác</small>
                                    }
                                }
                            </td>
                            <td class="text-end fw-bold text-success fs-6">
                                @item.TongTien.ToString("N0") đ
                            </td>
                            <td class="text-center text-muted small">
                                @item.NgayDatHang?.ToString("dd/MM/yyyy HH:mm")
                            </td>
                            <td class="text-center">
                                @switch (item.TrangThai)
                                {
                                    case "cho_duyet":
                                        <span class="badge bg-warning text-dark px-2 py-1">Chờ duyệt</span>
                                        break;
                                    case "da_duyet":
                                        <span class="badge bg-info px-2 py-1">Đã duyệt</span>
                                        break;
                                    case "dang_giao":
                                        <span class="badge bg-primary px-2 py-1">Đang giao</span>
                                        break;
                                    case "hoan_thanh":
                                        <span class="badge bg-success px-2 py-1">Hoàn thành</span>
                                        break;
                                    case "huy":
                                        <span class="badge bg-secondary px-2 py-1">Đã hủy</span>
                                        break;
                                    default:
                                        <span class="badge bg-light text-dark">@item.TrangThai</span>
                                        break;
                                }
                            </td>
                            <td class="text-center">
                                <a asp-action="Details" asp-route-id="@item.MaDonHang" class="btn btn-sm btn-outline-primary rounded-2">
                                    <i class="bi bi-eye me-1"></i> Chi tiết
                                </a>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-bag-x fs-2 d-block mb-2"></i>
                            Bạn chưa có đơn đặt mua nào trong mục này.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
