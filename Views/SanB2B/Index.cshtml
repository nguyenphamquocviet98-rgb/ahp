@model IEnumerable<code.Models.TonKhoNPP>

@{
    ViewData["Title"] = "Sàn Giao Dịch Chợ Sỉ B2B";
    var danhMucs = ViewBag.DanhMucs as List<code.Models.DanhMuc> ?? new List<code.Models.DanhMuc>();
    int currentDNId = ViewBag.CurrentMaDoanhNghiep ?? 0;
    var banners = ViewBag.Banners as List<code.Models.QuangCaoBanner> ?? new List<code.Models.QuangCaoBanner>();
    int currentPage = ViewBag.CurrentPage ?? 1;
    int totalPages = ViewBag.TotalPages ?? 1;
}

<div class="container-fluid px-lg-5 py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a href="/" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Sàn Chợ Sỉ B2B</li>
        </ol>
    </nav>

    <!-- Header Sàn B2B Hiện Đại -->
    <div class="b2b-header-card rounded-4 p-4 p-md-5 text-white mb-4 position-relative overflow-hidden shadow-sm"
         style="background: radial-gradient(circle at 85% 30%, #1e40af 0%, #1e293b 60%, #0f172a 100%);">
        <div class="row align-items-center position-relative" style="z-index: 2;">
            <div class="col-lg-8">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-20 mb-3 backdrop-blur">
                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 11px;">B2B MARKETPLACE</span>
                    <span class="small text-white-50">Sàn Thương Mại Điện Tử Bán Buôn Đa Doanh Nghiệp</span>
                </div>
                <h1 class="display-6 fw-bold mb-2 text-white">Chợ Sỉ Nhà Phân Phối & Đại Lý</h1>
                <p class="lead text-white-50 mb-4 fs-6" style="max-width: 650px; line-height: 1.6;">
                    Kết nối trực tiếp nguồn cung ứng từ các tổng kho phân phối lớn. So sánh giá buôn tận gốc, đánh giá uy tín đối tác bằng <strong>thuật toán AHP</strong> và đặt hàng sỉ khép kín.
                </p>

                <!-- 3 Thẻ Chỉ Số Bento -->
                <div class="d-flex flex-wrap gap-3">
                    <div class="stat-pill-card px-3 py-2 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-15">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-box-seam text-warning fs-5"></i>
                            <div>
                                <div class="fs-5 fw-bold text-white lh-1">@(ViewBag.TongSanPham ?? 0)</div>
                                <small class="text-white-50" style="font-size: 11px;">Mặt hàng đang chào sỉ</small>
                            </div>
                        </div>
                    </div>
                    <div class="stat-pill-card px-3 py-2 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-15">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-building text-info fs-5"></i>
                            <div>
                                <div class="fs-5 fw-bold text-white lh-1">@(ViewBag.TongNPP ?? 0)</div>
                                <small class="text-white-50" style="font-size: 11px;">Doanh nghiệp phân phối</small>
                            </div>
                        </div>
                    </div>
                    <div class="stat-pill-card px-3 py-2 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-15">
                        <div class="d-flex align-items-center gap-2">
                            <i class="bi bi-award-fill text-danger fs-5"></i>
                            <div>
                                <div class="fs-5 fw-bold text-white lh-1">@(ViewBag.TongMall ?? 0) ⭐</div>
                                <small class="text-white-50" style="font-size: 11px;">Gian hàng Mall chính hãng</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="col-lg-4 text-end d-none d-lg-block">
                <div class="hero-b2b-illustration p-4 d-inline-block rounded-circle bg-white bg-opacity-5 border border-white border-opacity-10">
                    <i class="bi bi-boxes text-white opacity-50" style="font-size: 100px;"></i>
                </div>
            </div>
        </div>
    </div>

    <!-- Dải Banner Quảng Cáo Đối Tác VIP Nổi Bật -->
    @if (banners.Any())
    {
        <div class="mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-warning text-dark px-2 py-1 fw-bold">VIP</span>
                    <h6 class="fw-bold text-dark mb-0 text-uppercase" style="font-size: 13px; letter-spacing: 0.5px;">
                        Gian Hàng & Nguồn Hàng Tài Trợ Nổi Bật
                    </h6>
                </div>
                <a asp-controller="QuangCao" asp-action="DangKy" class="btn btn-sm btn-outline-primary rounded-pill px-3" style="font-size: 12px;">
                    <i class="bi bi-megaphone me-1"></i> Đăng ký Banner VIP
                </a>
            </div>

            <div class="row g-3">
                @for (int idx = 0; idx < banners.Count; idx++)
                {
                    var b = banners[idx];
                    var bannerBg = idx == 0 ? "linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%)" :
                                   idx == 1 ? "linear-gradient(135deg, #831843 0%, #e11d48 100%)" :
                                              "linear-gradient(135deg, #065f46 0%, #10b981 100%)";
                    <div class="col-lg-4 col-md-6">
                        <div class="card border-0 rounded-4 shadow-sm text-white overflow-hidden h-100 banner-vip-card"
                             style="background: @bannerBg; transition: transform 0.2s, box-shadow 0.2s;">
                            <div class="card-body p-4 d-flex flex-column justify-content-between">
                                <div>
                                    <div class="d-flex justify-content-between align-items-center mb-2">
                                        <span class="badge bg-warning text-dark px-2 py-1 small fw-bold" style="font-size: 10.5px;">
                                            <i class="bi bi-star-fill me-1"></i> ĐỐI TÁC TÀI TRỢ
                                        </span>
                                        @if (b.DoanhNghiep != null && b.DoanhNghiep.LaGianHangMall)
                                        {
                                            <span class="badge bg-dark text-warning border px-2 py-1 small fw-bold" style="font-size: 10px;">
                                                MALL
                                            </span>
                                        }
                                    </div>
                                    <h6 class="fw-bold text-white mb-2" style="line-height: 1.4; min-height: 42px;">@b.TieuDe</h6>
                                    <p class="small text-white-50 mb-3 text-truncate" style="font-size: 12px;">
                                        <i class="bi bi-building me-1"></i>@b.DoanhNghiep?.TenDoanhNghiep
                                    </p>
                                </div>
                                <div>
                                    <a href="@b.LienKet" class="btn btn-light btn-sm fw-bold px-3 py-1 rounded-pill text-dark shadow-sm">
                                        Xem ưu đãi ngay <i class="bi bi-arrow-right ms-1"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- Bộ Lọc Tìm Kiếm & Sắp Xếp Đa Tiêu Chí -->
    <div class="card shadow-sm border rounded-4 mb-4 bg-white">
        <div class="card-body p-3">
            <form method="get" class="row g-2 align-items-center">
                <div class="col-xl-4 col-lg-4 col-md-6">
                    <div class="input-group">
                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control border-start-0 shadow-none ps-1"
                               placeholder="Tìm tên sản phẩm, mã SKU, nhà phân phối..." value="@ViewBag.Search" />
                        @if (!string.IsNullOrEmpty(ViewBag.Search as string))
                        {
                            <a asp-action="Index" class="btn btn-outline-secondary border-start-0 border-end-0" title="Xóa tìm kiếm">
                                <i class="bi bi-x-lg"></i>
                            </a>
                        }
                    </div>
                </div>

                <div class="col-xl-3 col-lg-3 col-md-6">
                    <select name="maDanhMuc" class="form-select shadow-none">
                        <option value="">-- Tất cả ngành hàng --</option>
                        @foreach (var dm in danhMucs)
                        {
                            <option value="@dm.MaDanhMuc" selected="@(ViewBag.MaDanhMuc == dm.MaDanhMuc)">@dm.TenDanhMuc</option>
                        }
                    </select>
                </div>

                <div class="col-xl-2 col-lg-2 col-md-6">
                    <select name="loaiNPP" class="form-select shadow-none">
                        <option value="">Tất cả NPP</option>
                        <option value="mall" selected="@(ViewBag.LoaiNPP == "mall")">⭐ Gian Hàng Mall</option>
                    </select>
                </div>

                <div class="col-xl-2 col-lg-2 col-md-6">
                    <select name="sort" class="form-select shadow-none">
                        <option value="">Sắp xếp mặc định</option>
                        <option value="gia_tang" selected="@(ViewBag.Sort == "gia_tang")">Giá sỉ tăng dần</option>
                        <option value="gia_giam" selected="@(ViewBag.Sort == "gia_giam")">Giá sỉ giảm dần</option>
                        <option value="giao_nhanh" selected="@(ViewBag.Sort == "giao_nhanh")">Giao hàng nhanh nhất</option>
                        <option value="uy_tin" selected="@(ViewBag.Sort == "uy_tin")">NPP Uy tín cao nhất</option>
                    </select>
                </div>

                <div class="col-xl-1 col-lg-1 col-12">
                    <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold">
                        <i class="bi bi-funnel me-1"></i> Lọc
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Danh Sách Sản Phẩm Chào Sỉ -->
    @if (Model != null && Model.Any())
    {
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div class="small text-muted">
                Tìm thấy <strong>@Model.Count()</strong> mặt hàng chào sỉ phù hợp
            </div>
            @if (!string.IsNullOrEmpty(ViewBag.Search as string) || ViewBag.MaDanhMuc != null || ViewBag.LoaiNPP != null)
            {
                <a asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xóa bộ lọc
                </a>
            }
        </div>

        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 row-cols-xl-4 g-4 mb-5">
            @foreach (var item in Model)
            {
                bool isOwnProduct = currentDNId > 0 && item.MaDoanhNghiep == currentDNId;
                decimal giaGoc = item.SanPham?.GiaMacDinh ?? (item.GiaSi * 1.15m);
                var discountPercent = giaGoc > item.GiaSi ? Math.Round((1 - (item.GiaSi / giaGoc)) * 100) : 0;

                <div class="col">
                    <div class="card h-100 border rounded-4 product-b2b-card shadow-xs overflow-hidden">
                        <!-- Ảnh sản phẩm & Huy hiệu -->
                        <div class="product-img-wrapper text-center p-3">
                            @if (discountPercent > 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill fw-bold shadow-xs" style="font-size: 11px; z-index: 2;">
                                    -@discountPercent% SỈ
                                </span>
                            }
                            
                            <div class="position-absolute top-0 end-0 m-3 d-flex align-items-center gap-1" style="z-index: 2;">
                                @if (item.DoanhNghiep != null && item.DoanhNghiep.LaGianHangMall)
                                {
                                    <span class="badge bg-dark rounded-pill fw-bold text-warning border border-secondary px-2 py-1" style="font-size: 10px;">
                                        ⭐ MALL
                                    </span>
                                }
                                <a asp-controller="AHPB2B" asp-action="ThietLap" asp-route-maSanPham="@item.MaSanPham"
                                   class="btn-ahp-quick" title="Kích hoạt thuật toán AHP so sánh các nhà phân phối sản phẩm này">
                                    <i class="bi bi-diagram-3-fill"></i>
                                </a>
                            </div>

                            <div class="d-flex align-items-center justify-content-center h-100">
                                @if (!string.IsNullOrEmpty(item.SanPham?.AnhSanPham))
                                {
                                    <img src="@item.SanPham.AnhSanPham" alt="@item.SanPham?.TenSanPham"
                                         class="img-fluid product-thumb" loading="lazy"
                                         onerror="this.onerror=null; this.src='/images/placeholder-product.svg';" />
                                }
                                else
                                {
                                    <img src="~/images/placeholder-product.svg" alt="Sản phẩm" class="img-fluid product-thumb" style="max-height: 110px;" />
                                }
                            </div>
                        </div>

                        <div class="card-body p-3 d-flex flex-column">
                            <div class="d-flex align-items-center justify-content-between mb-1">
                                <small class="text-muted text-uppercase fw-semibold" style="font-size: 10.5px; letter-spacing: 0.5px;">
                                    @(item.SanPham?.DanhMuc?.TenDanhMuc ?? "Hàng tiêu dùng")
                                </small>
                                <span class="badge bg-light text-dark border font-mono" style="font-size: 10px;">
                                    @(item.SanPham?.MaSanPhamCode ?? $"SP-{item.MaSanPham}")
                                </span>
                            </div>

                            <h6 class="fw-bold text-dark mb-2 text-truncate-2" title="@item.SanPham?.TenSanPham" style="min-height: 42px; line-height: 1.4;">
                                <a asp-action="ChiTiet" asp-route-id="@item.MaTonKhoNPP" class="text-decoration-none text-dark hover-primary">
                                    @item.SanPham?.TenSanPham
                                </a>
                            </h6>

                            <!-- Thông tin Nhà Phân Phối -->
                            <div class="p-2 px-3 bg-light rounded-3 mb-2 small border border-light-subtle">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <div class="fw-semibold text-truncate text-dark me-2" title="@item.DoanhNghiep?.TenDoanhNghiep">
                                        <i class="bi bi-building me-1 text-primary"></i>@item.DoanhNghiep?.TenDoanhNghiep
                                    </div>
                                    <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-1 py-0" style="font-size: 10px;">
                                        ⭐ @item.DoanhNghiep?.DiemUyTin
                                    </span>
                                </div>
                                <div class="d-flex justify-content-between text-muted" style="font-size: 11px;">
                                    <span class="text-truncate"><i class="bi bi-geo-alt me-1"></i>@(item.DoanhNghiep?.DiaChi ?? "TP.HCM")</span>
                                    <span class="text-nowrap"><i class="bi bi-truck me-1"></i>~@item.ThoiGianGiaoHang ngày</span>
                                </div>
                            </div>

                            <!-- Giá sỉ & Tồn kho -->
                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex justify-content-between align-items-baseline mb-2">
                                    <div>
                                        <span class="fs-5 fw-bold text-danger">@item.GiaSi.ToString("N0")</span>
                                        <small class="text-muted" style="font-size: 11px;">đ/@(item.SanPham?.DonViTinh?.TenDonVi ?? "đv")</small>
                                        @if (giaGoc > item.GiaSi)
                                        {
                                            <div class="text-muted text-decoration-line-through" style="font-size: 10.5px;">
                                                @giaGoc.ToString("N0") đ
                                            </div>
                                        }
                                    </div>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1 small">
                                        Sẵn: @item.SoLuongTon
                                    </span>
                                </div>

                                <!-- Action Buttons -->
                                <div class="d-flex gap-2">
                                    <a asp-action="ChiTiet" asp-route-id="@item.MaTonKhoNPP"
                                       class="btn btn-sm btn-outline-secondary flex-grow-1 rounded-pill fw-semibold py-2">
                                        Chi tiết
                                    </a>

                                    @if (isOwnProduct)
                                    {
                                        <button class="btn btn-sm btn-light border flex-grow-1 rounded-pill text-muted py-2" disabled title="Hàng trong kho của bạn">
                                            Kho bạn
                                        </button>
                                    }
                                    else
                                    {
                                        <button type="button" class="btn btn-sm btn-primary flex-grow-1 rounded-pill fw-semibold py-2 shadow-sm"
                                                data-bs-toggle="modal" data-bs-target="#modalDatHang_@item.MaTonKhoNPP">
                                            <i class="bi bi-cart-plus me-1"></i> Đặt sỉ
                                        </button>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Modal Đặt Hàng Nhanh -->
                <div class="modal fade" id="modalDatHang_@item.MaTonKhoNPP" tabindex="-1" aria-hidden="true">
                    <div class="modal-dialog modal-dialog-centered">
                        <div class="modal-content border-0 shadow-lg rounded-4 overflow-hidden">
                            <div class="modal-header bg-light border-0 py-3">
                                <h5 class="modal-title fw-bold text-dark">
                                    <i class="bi bi-cart-check text-primary me-2"></i>Lập Đơn Đặt Hàng Sỉ B2B
                                </h5>
                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                            </div>
                            <form asp-action="DatHangNhanh" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="maTonKhoNPP" value="@item.MaTonKhoNPP" />

                                <div class="modal-body p-4">
                                    <div class="p-3 rounded-3 bg-light border mb-3">
                                        <h6 class="fw-bold text-primary mb-1">@item.SanPham?.TenSanPham</h6>
                                        <div class="small text-muted mb-1">Nhà cung cấp: <strong>@item.DoanhNghiep?.TenDoanhNghiep</strong></div>
                                        <div class="small text-muted mb-1">Đơn giá sỉ: <strong class="text-danger">@item.GiaSi.ToString("N0") VNĐ</strong> / @(item.SanPham?.DonViTinh?.TenDonVi ?? "đv")</div>
                                        <div class="small text-muted">Thời gian giao hàng: <strong>~@item.ThoiGianGiaoHang ngày</strong></div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-dark">Số lượng đặt mua (@(item.SanPham?.DonViTinh?.TenDonVi ?? "đv")) <span class="text-danger">*</span></label>
                                        <div class="input-group">
                                            <input type="number" name="soLuong" id="soLuong_@item.MaTonKhoNPP"
                                                   class="form-control form-control-lg fw-bold text-primary text-center"
                                                   value="10" min="1" max="@item.SoLuongTon" required
                                                   oninput="tinhTongTien(@item.MaTonKhoNPP, @item.GiaSi)" />
                                            <span class="input-group-text bg-light text-muted">/ Tối đa @item.SoLuongTon</span>
                                        </div>
                                    </div>

                                    <div class="mb-3">
                                        <label class="form-label fw-bold small text-dark">Ghi chú giao hàng</label>
                                        <input type="text" name="ghiChu" class="form-control" placeholder="Ví dụ: Giao giờ hành chính, xuất hóa đơn VAT..." />
                                    </div>

                                    <div class="d-flex justify-content-between align-items-center p-3 bg-primary-subtle bg-opacity-15 rounded-3 border border-primary-subtle">
                                        <span class="fw-bold text-dark small">Tạm tính thành tiền:</span>
                                        <span class="fs-4 fw-bold text-danger font-mono" id="tongTien_@item.MaTonKhoNPP">
                                            @((10 * item.GiaSi).ToString("N0")) VNĐ
                                        </span>
                                    </div>
                                </div>

                                <div class="modal-footer bg-light border-0 py-3">
                                    <button type="button" class="btn btn-light rounded-pill px-4" data-bs-dismiss="modal">Hủy</button>
                                    <button type="submit" class="btn btn-primary rounded-pill px-4 fw-bold shadow-sm">
                                        <i class="bi bi-check-circle-fill me-1"></i> Xác nhận đặt đơn
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Thanh Phân Trang Pagination -->
        @if (totalPages > 1)
        {
            <nav class="d-flex justify-content-center my-4" aria-label="Phân trang sàn B2B">
                <ul class="pagination pagination-rounded gap-1">
                    <li class="page-item @(currentPage <= 1 ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Index"
                           asp-route-page="@(currentPage - 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-maDanhMuc="@ViewBag.MaDanhMuc"
                           asp-route-loaiNPP="@ViewBag.LoaiNPP"
                           asp-route-sort="@ViewBag.Sort">
                            <i class="bi bi-chevron-left me-1"></i> Trang trước
                        </a>
                    </li>
                    @for (int p = 1; p <= totalPages; p++)
                    {
                        <li class="page-item @(p == currentPage ? "active" : "")">
                            <a class="page-link rounded-circle text-center" style="width: 38px; height: 38px; line-height: 22px;"
                               asp-action="Index"
                               asp-route-page="@p"
                               asp-route-search="@ViewBag.Search"
                               asp-route-maDanhMuc="@ViewBag.MaDanhMuc"
                               asp-route-loaiNPP="@ViewBag.LoaiNPP"
                               asp-route-sort="@ViewBag.Sort">
                                @p
                            </a>
                        </li>
                    }
                    <li class="page-item @(currentPage >= totalPages ? "disabled" : "")">
                        <a class="page-link rounded-pill px-3" asp-action="Index"
                           asp-route-page="@(currentPage + 1)"
                           asp-route-search="@ViewBag.Search"
                           asp-route-maDanhMuc="@ViewBag.MaDanhMuc"
                           asp-route-loaiNPP="@ViewBag.LoaiNPP"
                           asp-route-sort="@ViewBag.Sort">
                            Trang sau <i class="bi bi-chevron-right ms-1"></i>
                        </a>
                    </li>
                </ul>
            </nav>
        }
    }
    else
    {
        <!-- Empty State Khi Không Tìm Thấy Sản Phẩm -->
        <div class="card shadow-sm border-0 rounded-4 py-5 text-center bg-white my-4">
            <div class="card-body p-5">
                <i class="bi bi-search text-muted opacity-50" style="font-size: 3.5rem;"></i>
                <h5 class="fw-bold text-dark mt-3">Không tìm thấy mặt hàng chào sỉ phù hợp</h5>
                <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                    Hãy thử xóa từ khóa tìm kiếm hoặc chọn lại danh mục "Tất cả ngành hàng" để xem toàn bộ nguồn hàng có sẵn.
                </p>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 py-2 fw-semibold shadow-sm">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Xem lại tất cả nguồn hàng sỉ
                </a>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        function tinhTongTien(id, giaSi) {
            const slInput = document.getElementById('soLuong_' + id);
            const tongTienSpan = document.getElementById('tongTien_' + id);
            if (!slInput || !tongTienSpan) return;
            let sl = parseInt(slInput.value) || 0;
            let total = sl * giaSi;
            tongTienSpan.textContent = total.toLocaleString('vi-VN') + ' VNĐ';
        }
    </script>
}
