@model IEnumerable<code.Models.TonKho>
@{
    ViewData["Title"] = "Quản lý Tồn kho";
    var search = ViewData["Search"] as string;
    var selectedDanhMuc = ViewData["SelectedDanhMuc"] as int?;
    var selectedMucTon = ViewData["SelectedMucTon"] as string;

    int tongMatHang = ViewBag.TongSoMatHang ?? 0;
    int tongSoLuongTon = ViewBag.TongSoLuongTon ?? 0;
    int soMatHangTonThap = ViewBag.SoMatHangTonThap ?? 0;
    decimal tongGiaTriTonKho = ViewBag.TongGiaTriTonKho ?? 0;
}

<div class="row mb-3 align-items-center">
    <div class="col-md-6">
        <h3 class="fw-bold text-dark mb-1">
            <i class="bi bi-boxes text-primary me-2"></i>Quản lý Tồn kho
        </h3>
        <p class="text-muted mb-0 small">Theo dõi số lượng hàng tồn trong kho, cảnh báo mức tồn thấp và giá trị kho</p>
    </div>
    <div class="col-md-6 text-md-end mt-3 mt-md-0">
        <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-primary shadow-sm rounded-3">
            <i class="bi bi-plus-circle me-1"></i> Tạo phiếu nhập hàng
        </a>
    </div>
</div>

<!-- 4 Thẻ KPI Tồn kho -->
<div class="row g-3 mb-4">
    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-primary border-4">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0 bg-primary-subtle text-primary p-3 rounded-3 me-3">
                    <i class="bi bi-grid-3x3-gap fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng số mặt hàng</div>
                    <h4 class="fw-bold text-dark mb-0">@tongMatHang</h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-info border-4">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0 bg-info-subtle text-info p-3 rounded-3 me-3">
                    <i class="bi bi-box-seam fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng số lượng tồn</div>
                    <h4 class="fw-bold text-dark mb-0">@tongSoLuongTon <small class="text-muted fs-6">đơn vị</small></h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-danger border-4">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0 bg-danger-subtle text-danger p-3 rounded-3 me-3">
                    <i class="bi bi-exclamation-triangle fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Cảnh báo tồn thấp</div>
                    <h4 class="fw-bold text-danger mb-0">@soMatHangTonThap <small class="text-muted fs-6">mặt hàng (&lt;20)</small></h4>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-3 col-md-6">
        <div class="card border-0 shadow-sm rounded-3 p-3 bg-white border-start border-success border-4">
            <div class="d-flex align-items-center">
                <div class="flex-shrink-0 bg-success-subtle text-success p-3 rounded-3 me-3">
                    <i class="bi bi-cash-stack fs-3"></i>
                </div>
                <div>
                    <div class="text-muted small fw-semibold text-uppercase">Tổng giá trị tồn kho</div>
                    <h5 class="fw-bold text-dark mb-0">@tongGiaTriTonKho.ToString("N0") <small class="text-muted fs-6">VNĐ</small></h5>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bộ lọc & Tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 bg-white mb-4">
    <div class="card-body p-3">
        <form method="get" asp-action="Index" class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-search text-muted"></i></span>
                    <input type="text" name="search" value="@search" class="form-control bg-light border-start-0" placeholder="Tìm theo tên hoặc mã sản phẩm..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="maDanhMuc" class="form-select bg-light" asp-items="ViewBag.DanhMucs">
                    <option value="">-- Tất cả danh mục --</option>
                </select>
            </div>
            <div class="col-md-3">
                <select name="mucTon" class="form-select bg-light">
                    <option value="">-- Tất cả mức tồn kho --</option>
                    <option value="thap" selected="@(selectedMucTon == "thap")">Cảnh báo: Tồn thấp (&lt; 20)</option>
                    <option value="antoan" selected="@(selectedMucTon == "antoan")">Tồn kho an toàn (&gt;= 20)</option>
                </select>
            </div>
            <div class="col-md-2 d-flex gap-2">
                <button type="submit" class="btn btn-secondary px-3">
                    <i class="bi bi-funnel me-1"></i> Lọc
                </button>
                @if (!string.IsNullOrEmpty(search) || selectedDanhMuc.HasValue || !string.IsNullOrEmpty(selectedMucTon))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại">
                        <i class="bi bi-arrow-counterclockwise"></i>
                    </a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng Tồn kho -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light text-uppercase small text-muted">
                    <tr>
                        <th style="width: 100px;">Mã SP</th>
                        <th>Tên sản phẩm</th>
                        <th>Danh mục</th>
                        <th>ĐVT</th>
                        <th class="text-end">Đơn giá định mức</th>
                        <th class="text-center" style="width: 130px;">Số lượng tồn</th>
                        <th class="text-end">Giá trị tồn tạm tính</th>
                        <th class="text-center" style="width: 140px;">Tình trạng</th>
                        <th style="width: 150px;">Cập nhật gần nhất</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var item in Model)
                        {
                            var sp = item.SanPham;
                            var soLuong = item.SoLuongTon ?? 0;
                            var gia = sp?.GiaMacDinh ?? 0;
                            var giaTriTon = soLuong * gia;

                            <tr>
                                <td>
                                    <span class="badge bg-light text-dark font-monospace border">
                                        @(sp?.MaSanPhamCode ?? $"SP{sp?.MaSanPham:D3}")
                                    </span>
                                </td>
                                <td>
                                    <a asp-controller="SanPham" asp-action="Details" asp-route-id="@sp?.MaSanPham" class="fw-bold text-dark text-decoration-none hover-primary">
                                        @(sp?.TenSanPham ?? "N/A")
                                    </a>
                                </td>
                                <td>
                                    <span class="badge bg-secondary-subtle text-secondary">
                                        @(sp?.DanhMuc?.TenDanhMuc ?? "Chưa phân loại")
                                    </span>
                                </td>
                                <td>@(sp?.DonViTinh?.TenDonVi ?? "-")</td>
                                <td class="text-end">@(gia.ToString("N0")) đ</td>
                                <td class="text-center">
                                    <span class="fw-bold fs-6 @(soLuong < 20 ? "text-danger" : "text-dark")">
                                        @soLuong
                                    </span>
                                </td>
                                <td class="text-end fw-semibold text-primary">
                                    @(giaTriTon.ToString("N0")) đ
                                </td>
                                <td class="text-center">
                                    @if (soLuong < 20)
                                    {
                                        <span class="badge bg-danger-subtle text-danger px-2 py-1">
                                            <i class="bi bi-exclamation-circle me-1"></i>Tồn thấp
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success-subtle text-success px-2 py-1">
                                            <i class="bi bi-check-circle me-1"></i>Đủ hàng
                                        </span>
                                    }
                                </td>
                                <td class="small text-muted">
                                    @(item.NgayCapNhat?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center py-5 text-muted">
                                <i class="bi bi-inbox fs-2 d-block mb-2"></i>
                                Không tìm thấy dữ liệu tồn kho nào phù hợp.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>
