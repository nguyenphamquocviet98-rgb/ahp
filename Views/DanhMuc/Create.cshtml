@model code.Models.DanhMuc
@{
    ViewData["Title"] = "Thêm danh mục mới";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-custom">
            <div class="card-body-custom">
                <div class="d-flex align-items-center mb-4">
                    <a asp-action="Index" class="btn btn-custom btn-custom-outline me-3" style="padding: 6px 10px;"><i class="bi bi-arrow-left"></i></a>
                    <h4 class="fw-bold mb-0" style="color: var(--gray-900);">Thêm Danh Mục Mới</h4>
                </div>

                <form asp-action="Create" method="post" class="form-custom">
                    @Html.AntiForgeryToken()
                    <div class="mb-3">
                        <label asp-for="TenDanhMuc" class="form-label">Tên danh mục <span style="color: var(--danger);">*</span></label>
                        <input asp-for="TenDanhMuc" class="form-control" placeholder="Ví dụ: Đồ gia dụng, Thực phẩm khô..." required maxlength="50" />
                        <span asp-validation-for="TenDanhMuc" class="text-danger"></span>
                    </div>
                    <div class="mb-4">
                        <label asp-for="MoTa" class="form-label">Mô tả danh mục</label>
                        <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Nhập ghi chú hoặc mô tả nhóm hàng (tối đa 200 ký tự)..." maxlength="200"></textarea>
                        <span asp-validation-for="MoTa" class="text-danger"></span>
                    </div>
                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline px-4">Hủy</a>
                        <button type="submit" class="btn btn-custom btn-custom-primary px-4"><i class="bi bi-check-lg me-1"></i> Lưu danh mục</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
