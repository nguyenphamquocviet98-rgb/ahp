@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Tổng quan";
    var username = User.Identity?.Name ?? "Người dùng";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "nhanvien";
}

<!-- Page Header Toolbar -->
<div class="page-header">
    <div class="page-header-left">
        <h3><i class="bi bi-speedometer2 text-primary"></i> Tổng quan điều hành</h3>
        <p>Theo dõi luồng nhập hàng, cảnh báo tồn kho và kết quả lựa chọn nhà cung cấp AHP</p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-plus-lg"></i> Lập phiếu nhập
        </a>
        <a asp-controller="AHP" asp-action="MaTranSoSanh" class="btn btn-custom btn-custom-accent">
            <i class="bi bi-diagram-3-fill"></i> Đánh giá AHP
        </a>
    </div>
</div>

<!-- 5 Bento KPI Cards (High Precision) -->
<div class="row g-3 mb-4">
    <!-- Thẻ 1: Sản phẩm -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-bento-card">
            <div>
                <div class="kpi-top-row">
                    <span class="kpi-title">Sản phẩm</span>
                    <div class="kpi-icon-badge badge-icon-blue"><i class="bi bi-box-seam-fill"></i></div>
                </div>
                <div class="kpi-main-metric">@Model.TongSanPham</div>
            </div>
            <div>
                <div class="kpi-progress-bar">
                    <div class="kpi-progress-fill bg-primary" style="width: 100%;"></div>
                </div>
                <div class="kpi-bottom-meta">
                    <i class="bi bi-check-circle-fill text-success"></i> Đang lưu thông
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ 2: Nhà cung cấp -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-bento-card">
            <div>
                <div class="kpi-top-row">
                    <span class="kpi-title">Nhà cung cấp</span>
                    <div class="kpi-icon-badge badge-icon-purple"><i class="bi bi-buildings-fill"></i></div>
                </div>
                <div class="kpi-main-metric">@Model.TongNhaCungCap</div>
            </div>
            <div>
                <div class="kpi-progress-bar">
                    <div class="kpi-progress-fill" style="width: 100%; background: #7C3AED;"></div>
                </div>
                <div class="kpi-bottom-meta">
                    <i class="bi bi-shield-check text-primary"></i> Đã thẩm định AHP
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ 3: Phiếu nhập -->
    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-bento-card">
            <div>
                <div class="kpi-top-row">
                    <span class="kpi-title">Phiếu nhập kho</span>
                    <div class="kpi-icon-badge badge-icon-indigo"><i class="bi bi-receipt-cutoff"></i></div>
                </div>
                <div class="kpi-main-metric">@Model.TongPhieuNhap</div>
            </div>
            <div>
                <div class="kpi-progress-bar">
                    <div class="kpi-progress-fill" style="width: 100%; background: #4F46E5;"></div>
                </div>
                <div class="kpi-bottom-meta">
                    <i class="bi bi-clock-history text-secondary"></i> Toàn thời gian
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ 4: Tổng giá trị nhập -->
    <div class="col-xl col-md-6 col-sm-6">
        <div class="kpi-bento-card">
            <div>
                <div class="kpi-top-row">
                    <span class="kpi-title">Tổng giá trị nhập</span>
                    <div class="kpi-icon-badge badge-icon-emerald"><i class="bi bi-cash-stack"></i></div>
                </div>
                <div class="kpi-main-metric" style="font-size: 20px;">@Model.TongGiaTriNhap.ToString("N0") <span style="font-size: 12px; font-weight: 500; color: var(--slate-500);">VNĐ</span></div>
            </div>
            <div>
                <div class="kpi-progress-bar">
                    <div class="kpi-progress-fill bg-success" style="width: 100%;"></div>
                </div>
                <div class="kpi-bottom-meta">
                    <i class="bi bi-arrow-up-right text-success"></i> Vốn luân chuyển
                </div>
            </div>
        </div>
    </div>

    <!-- Thẻ 5: Tổng tồn kho -->
    <div class="col-xl col-md-6 col-sm-12">
        <div class="kpi-bento-card">
            <div>
                <div class="kpi-top-row">
                    <span class="kpi-title">Tổng tồn kho</span>
                    <div class="kpi-icon-badge badge-icon-amber"><i class="bi bi-boxes"></i></div>
                </div>
                <div class="kpi-main-metric">@Model.TongSoLuongTon <span style="font-size: 12px; font-weight: 500; color: var(--slate-500);">đơn vị</span></div>
            </div>
            <div>
                <div class="kpi-progress-bar">
                    <div class="kpi-progress-fill bg-warning" style="width: 100%;"></div>
                </div>
                <div class="kpi-bottom-meta">
                    <i class="bi bi-layers-fill text-warning"></i> Đang lưu kho
                </div>
            </div>
        </div>
    </div>
</div>

<!-- AHP Executive Decision Spotlight Card -->
<div class="mb-4">
    <div class="ahp-executive-card">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="ahp-crown-badge mb-2">
                    <i class="bi bi-award-fill"></i> ĐỐI TÁC ĐỀ XUẤT NHẬP HÀNG TỐI ƯU #1 (AHP + WSM)
                </div>

                @if (Model.NhaCungCapDeXuatGanNhat != null && Model.NhaCungCapDeXuatGanNhat.NhaCungCap != null)
                {
                    var ncc = Model.NhaCungCapDeXuatGanNhat.NhaCungCap;
                    <div class="ahp-supplier-title">
                        @ncc.TenNhaCungCap
                        <span class="status-badge status-badge-success ms-2">Hạng 1</span>
                    </div>

                    <div class="ahp-info-chips">
                        <div class="ahp-info-chip">
                            <i class="bi bi-calendar3"></i> Kỳ: @(Model.NhaCungCapDeXuatGanNhat.KyDanhGia?.TenKyDanhGia ?? "Kỳ hiện tại")
                        </div>
                        <div class="ahp-info-chip">
                            <i class="bi bi-person"></i> @(ncc.NguoiLienHe ?? "Liên hệ: —")
                        </div>
                        <div class="ahp-info-chip">
                            <i class="bi bi-telephone"></i> @(ncc.SoDienThoai ?? "SĐT: —")
                        </div>
                        <div class="ahp-info-chip">
                            <i class="bi bi-envelope"></i> @(ncc.Email ?? "Email: —")
                        </div>
                    </div>

                    <div class="d-flex flex-wrap gap-2">
                        <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-emerald">
                            <i class="bi bi-cart-plus-fill me-1"></i> Tạo phiếu nhập từ đối tác này
                        </a>
                        <a asp-controller="AHP" asp-action="KetQuaXepHang" asp-route-id="@Model.NhaCungCapDeXuatGanNhat.MaKyDanhGia" class="btn btn-custom btn-custom-outline" style="color: #FFF; background: rgba(255,255,255,0.08); border-color: rgba(255,255,255,0.2);">
                            Xem ma trận & giải trình AHP
                        </a>
                    </div>
                }
                else
                {
                    <h5 class="fw-bold text-white mt-2 mb-1">Chưa có kết quả đánh giá AHP</h5>
                    <p style="color: var(--slate-300); font-size: 13px; margin: 0;">
                        Hãy hoàn thiện ma trận so sánh cặp và chấm điểm nhà cung cấp để hệ thống tự động đưa ra đề xuất đối tác tối ưu.
                    </p>
                }
            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                @if (Model.NhaCungCapDeXuatGanNhat != null)
                {
                    <div class="ahp-score-display d-inline-block">
                        <div style="font-size: 11px; font-weight: 700; color: #FDE68A; text-transform: uppercase; letter-spacing: 0.05em;">Điểm tổng hợp WSM</div>
                        <div class="ahp-score-big mt-1">
                            @(Model.NhaCungCapDeXuatGanNhat.DiemTong?.ToString("0.00") ?? "N/A")
                            <span style="font-size: 14px; color: var(--slate-300); font-weight: 500;">/ 9.00</span>
                        </div>
                        <div class="ahp-score-sub">Mô hình phân tích thứ bậc Saaty</div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 2 Interactive Charts (Connected 100% to SQL) -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-pie-chart-fill text-primary"></i> Phân bố sản phẩm theo Danh mục</h5>
                <span class="status-badge status-badge-primary">Từ cơ sở dữ liệu</span>
            </div>
            <div class="card-body-custom d-flex align-items-center justify-content-center" style="min-height: 250px;">
                <canvas id="categoryChart" style="max-height: 220px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-bar-chart-fill text-primary"></i> So sánh năng lực Nhà cung cấp (AHP)</h5>
                <span class="status-badge status-badge-success">Điểm WSM thực tế</span>
            </div>
            <div class="card-body-custom d-flex align-items-center justify-content-center" style="min-height: 250px;">
                <canvas id="supplierChart" style="max-height: 220px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 2 Data Tables -->
<div class="row g-4 mb-4">
    <!-- Phiếu nhập gần nhất -->
    <div class="col-lg-7">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5><i class="bi bi-receipt text-primary"></i> Phiếu nhập gần đây</h5>
                <a asp-controller="PhieuNhap" asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body-custom p-0">
                @if (Model.PhieuNhapMoiNhat.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Nhà cung cấp</th>
                                    <th>Ngày nhập</th>
                                    <th class="text-end">Tổng tiền</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pn in Model.PhieuNhapMoiNhat)
                                {
                                    var tongTien = (pn.TongTien.HasValue && pn.TongTien.Value > 0)
                                        ? pn.TongTien.Value
                                        : (pn.ChiTietPhieuNhaps?.Sum(c => c.ThanhTien ?? (c.SoLuong * c.DonGia) ?? 0) ?? 0);
                                    <tr>
                                        <td>
                                            <a asp-controller="PhieuNhap" asp-action="Details" asp-route-id="@pn.MaPhieuNhap" class="code-badge text-decoration-none">
                                                @(pn.MaPhieuNhapCode ?? $"PN{pn.MaPhieuNhap:D4}")
                                            </a>
                                        </td>
                                        <td>
                                            <strong style="color: var(--slate-900);">@(pn.NhaCungCap?.TenNhaCungCap ?? "N/A")</strong>
                                        </td>
                                        <td style="color: var(--slate-500); font-size: 12.5px;">
                                            @(pn.NgayNhap?.ToString("dd/MM/yyyy") ?? pn.NgayTao?.ToString("dd/MM/yyyy") ?? "N/A")
                                        </td>
                                        <td class="text-end font-mono fw-bold" style="color: var(--slate-900);">
                                            @(tongTien.ToString("N0")) đ
                                        </td>
                                        <td class="text-center">
                                            @if (pn.TrangThai == "xacnhan")
                                            {
                                                <span class="status-badge status-badge-success">Đã duyệt</span>
                                            }
                                            else if (pn.TrangThai == "huy")
                                            {
                                                <span class="status-badge status-badge-danger">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge-warning">Chờ xử lý</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có phiếu nhập hàng nào trong hệ thống.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tồn kho theo dõi -->
    <div class="col-lg-5">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5><i class="bi bi-boxes text-warning"></i> Theo dõi tồn kho</h5>
                <a asp-controller="TonKho" asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    Chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body-custom p-0">
                @if (Model.DanhSachTonKho.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>ĐVT</th>
                                    <th class="text-end">Tồn kho</th>
                                    <th class="text-center">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tk in Model.DanhSachTonKho.Take(6))
                                {
                                    var soLuong = tk.SoLuongTon ?? 0;
                                    <tr>
                                        <td>
                                            <div class="fw-semibold" style="color: var(--slate-900);">@(tk.SanPham?.TenSanPham ?? "N/A")</div>
                                            <small style="color: var(--slate-400); font-size: 11.5px;">@(tk.SanPham?.DanhMuc?.TenDanhMuc ?? "")</small>
                                        </td>
                                        <td style="color: var(--slate-600);">@(tk.SanPham?.DonViTinh?.TenDonVi ?? "-")</td>
                                        <td class="text-end font-mono fw-bold" style="color: var(--slate-900);">@soLuong</td>
                                        <td class="text-center">
                                            @if (soLuong < 20)
                                            {
                                                <span class="status-badge status-badge-danger">Tồn thấp</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge-success">Đủ hàng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có dữ liệu tồn kho.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Biểu đồ Donut: Lấy dữ liệu danh mục thực tế 100% từ SQL database
            const catLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeDanhMuc.Select(d => d.TenDanhMuc)));
            const catData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeDanhMuc.Select(d => d.SoLuongSanPham)));

            const ctxCat = document.getElementById('categoryChart');
            if (ctxCat && catLabels && catLabels.length > 0) {
                new Chart(ctxCat, {
                    type: 'doughnut',
                    data: {
                        labels: catLabels,
                        datasets: [{
                            data: catData,
                            backgroundColor: ['#2563EB', '#6366F1', '#06B6D4', '#10B981', '#F59E0B', '#64748B'],
                            borderWidth: 3,
                            borderColor: '#FFFFFF',
                            hoverOffset: 4
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    font: { family: 'Plus Jakarta Sans', size: 12, weight: '600' },
                                    boxWidth: 12,
                                    padding: 12
                                }
                            }
                        },
                        cutout: '70%'
                    }
                });
            }

            // 2. Biểu đồ Cột: Lấy điểm số tổng hợp AHP thực tế 100% từ SQL database (kỳ gần nhất)
            const supLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeNhaCungCapAHP.Select(n => n.TenNhaCungCap)));
            const supData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ThongKeNhaCungCapAHP.Select(n => n.DiemTong)));

            const ctxSup = document.getElementById('supplierChart');
            if (ctxSup && supLabels && supLabels.length > 0) {
                // Top 1 dùng màu gradient blue/emerald, các top sau dùng màu slate sang trọng
                const bgColors = supLabels.map((_, index) => index === 0 ? '#2563EB' : (index === 1 ? '#4F46E5' : (index === 2 ? '#64748B' : '#94A3B8')));

                new Chart(ctxSup, {
                    type: 'bar',
                    data: {
                        labels: supLabels,
                        datasets: [{
                            label: 'Điểm tổng hợp (WSM)',
                            data: supData,
                            backgroundColor: bgColors,
                            borderRadius: 6,
                            borderSkipped: false,
                            barPercentage: 0.55
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 9,
                                grid: { color: '#F1F5F9' },
                                ticks: { font: { family: 'JetBrains Mono', size: 11 }, stepSize: 3 }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Plus Jakarta Sans', size: 11, weight: '600' } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
