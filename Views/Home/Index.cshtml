@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@model code.Models.ViewModels.LandingPageViewModel
@{
    ViewData["Title"] = "Cổng Sàn Giao Dịch B2B & Lựa Chọn Đối Tác AHP";
}

<!-- HERO SECTION: B2B Marketplace Search -->
<section class="b2b-hero py-5 text-white position-relative overflow-hidden">
    <div class="container position-relative py-4" style="z-index: 2;">
        <div class="row align-items-center g-5">
            <div class="col-lg-7">
                <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-20 mb-3 backdrop-blur">
                    <span class="badge bg-warning text-dark fw-bold" style="font-size: 11px;">MỚI</span>
                    <span class="small text-white-50">Nền tảng B2B tích hợp Mô hình Ra Quyết Định AHP</span>
                </div>
                <h1 class="display-5 fw-bold text-white mb-3 lh-sm">
                    Cổng Kết Nối <span class="text-gradient-cyan">Nhà Phân Phối</span> & Tìm Nguồn Hàng B2B Tối Ưu
                </h1>
                <p class="lead text-white-50 mb-4 fs-6" style="max-width: 600px; line-height: 1.7;">
                    Khám phá hàng ngàn mặt hàng giá sỉ trực tiếp từ các tổng kho phân phối. Tự động đánh giá, xếp hạng và đề xuất Nhà cung cấp uy tín nhất bằng thuật toán <strong>AHP đa tiêu chí</strong>.
                </p>

                <!-- Search Box B2B -->
                <div class="b2b-search-card p-2 rounded-4 shadow-lg bg-white text-dark mb-3">
                    <form asp-controller="SanB2B" asp-action="Index" method="get" class="row g-2 align-items-center">
                        <div class="col-md-7">
                            <div class="input-group">
                                <span class="input-group-text bg-transparent border-0 text-muted ps-3"><i class="bi bi-search fs-5"></i></span>
                                <input type="text" name="search" id="heroSearchInput" class="form-control border-0 shadow-none ps-2"
                                       placeholder="Tìm tên sản phẩm, mã hàng, tên nhà phân phối..." autocomplete="off" />
                            </div>
                        </div>
                        <div class="col-md-3 d-none d-md-block border-start">
                            <select name="maDanhMuc" id="heroCategorySelect" class="form-select border-0 shadow-none text-muted">
                                <option value="">Tất cả ngành hàng</option>
                                @foreach (var dm in Model.DanhSachDanhMuc)
                                {
                                    <option value="@dm.MaDanhMuc">@dm.TenDanhMuc (@dm.SoLuongSanPham)</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-2 col-12">
                            <button type="submit" class="btn btn-primary w-100 py-2 rounded-3 fw-semibold">
                                <i class="bi bi-search me-1"></i> Tìm sỉ
                            </button>
                        </div>
                    </form>
                </div>

                <!-- Popular search tags -->
                <div class="d-flex flex-wrap align-items-center gap-2 small text-white-50">
                    <span>Tìm nhanh:</span>
                    <a href="/SanB2B?search=nước" class="hero-tag">Nước giải khát</a>
                    <a href="/SanB2B?search=bánh" class="hero-tag">Bánh kẹo</a>
                    <a href="/SanB2B?search=dầu" class="hero-tag">Dầu ăn & Gia vị</a>
                    <a href="/SanB2B?loaiNPP=mall" class="hero-tag text-warning border-warning border-opacity-50"><i class="bi bi-award-fill me-1"></i>Gian hàng Mall</a>
                </div>
            </div>

            <!-- Hero Graphic / AHP Snapshot -->
            <div class="col-lg-5">
                <div class="hero-glass-panel p-4 rounded-4 shadow-2xl border border-white border-opacity-20 text-white">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="icon-bubble bg-primary text-white rounded-circle p-2 d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                                <i class="bi bi-cpu-fill fs-5"></i>
                            </div>
                            <div>
                                <h6 class="mb-0 fw-bold">Trợ Lý Đánh Giá AHP</h6>
                                <small class="text-white-50" style="font-size: 11px;">Mô hình tối ưu đa tiêu chí</small>
                            </div>
                        </div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-2 py-1" style="font-size: 11px;">
                            <i class="bi bi-check2-circle me-1"></i>Hoạt động
                        </span>
                    </div>

                    <div class="ahp-criteria-list mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="text-white-50">Tiêu chí Giá cả & Chiết khấu</span>
                            <span class="fw-bold text-info">38.5%</span>
                        </div>
                        <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.15);">
                            <div class="progress-bar bg-info" style="width: 38.5%"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="text-white-50">Tiêu chí Chất lượng sản phẩm</span>
                            <span class="fw-bold text-success">29.0%</span>
                        </div>
                        <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.15);">
                            <div class="progress-bar bg-success" style="width: 29%"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="text-white-50">Thời gian & Cam kết giao hàng</span>
                            <span class="fw-bold text-warning">18.5%</span>
                        </div>
                        <div class="progress mb-2" style="height: 6px; background-color: rgba(255,255,255,0.15);">
                            <div class="progress-bar bg-warning" style="width: 18.5%"></div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-1 small">
                            <span class="text-white-50">Uy tín & Hậu mãi đối tác</span>
                            <span class="fw-bold text-purple">14.0%</span>
                        </div>
                        <div class="progress" style="height: 6px; background-color: rgba(255,255,255,0.15);">
                            <div class="progress-bar bg-primary" style="width: 14%"></div>
                        </div>
                    </div>

                    <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 d-flex align-items-center justify-content-between">
                        <div>
                            <small class="text-white-50 d-block" style="font-size: 11px;">Tự động lọc đối tác tốt nhất</small>
                            <span class="fw-bold small text-white">Giảm 25% chi phí rủi ro nhập hàng</span>
                        </div>
                        <a href="#cong-nghe-ahp" class="btn btn-sm btn-light text-primary fw-semibold rounded-pill px-3">
                            Xem mô hình &rarr;
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Live Stats Strip -->
    <div class="hero-stats-strip py-3 border-top border-white border-opacity-10 bg-black bg-opacity-20">
        <div class="container">
            <div class="row text-center g-3">
                <div class="col-6 col-md-3 border-end border-white border-opacity-10">
                    <div class="fs-4 fw-bold text-white">@Model.TongNhaPhanPhoi+</div>
                    <small class="text-white-50">Nhà Phân Phối & NCC</small>
                </div>
                <div class="col-6 col-md-3 border-end-md border-white border-opacity-10">
                    <div class="fs-4 fw-bold text-white">@Model.TongSanPham+</div>
                    <small class="text-white-50">Mặt Hàng Lưu Thông Sỉ</small>
                </div>
                <div class="col-6 col-md-3 border-end border-white border-opacity-10">
                    <div class="fs-4 fw-bold text-white">@Model.TongGiaoDich+</div>
                    <small class="text-white-50">Phiếu Đơn Hàng & Nhập Kho</small>
                </div>
                <div class="col-6 col-md-3">
                    <div class="fs-4 fw-bold text-warning">@Model.TiLeToiUuAHP%</div>
                    <small class="text-white-50">Độ Tối Ưu Ra Quyết Định</small>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- SECTION 1: CATEGORY FILTER BAR (Lướt theo ngành hàng) -->
<section class="py-4 bg-white border-bottom">
    <div class="container">
        <div class="d-flex align-items-center justify-content-between mb-3">
            <div>
                <h5 class="fw-bold mb-0 text-dark"><i class="bi bi-grid-fill text-primary me-2"></i>Khám Phá Ngành Hàng Sỉ</h5>
                <small class="text-muted">Chọn ngành hàng để lọc nhanh các nhà phân phối và sản phẩm phù hợp</small>
            </div>
            <a asp-controller="SanB2B" asp-action="Index" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
                Xem tất cả sàn &rarr;
            </a>
        </div>

        <div class="category-pill-container d-flex gap-2 overflow-auto pb-2">
            <button class="btn btn-category-pill active" onclick="filterByCatalog(0, this)">
                <i class="bi bi-stars text-warning me-1"></i> Tất cả ngành hàng
            </button>
            @foreach (var dm in Model.DanhSachDanhMuc)
            {
                <button class="btn btn-category-pill" onclick="filterByCatalog(@dm.MaDanhMuc, this)" data-cat-id="@dm.MaDanhMuc">
                    <i class="bi @dm.IconClass text-primary me-1"></i> @dm.TenDanhMuc
                    <span class="badge bg-light text-dark rounded-pill ms-1">@dm.SoLuongSanPham</span>
                </button>
            }
        </div>
    </div>
</section>

<!-- SECTION 2: DANH BẠ NHÀ PHÂN PHỐI & NHÀ CUNG CẤP UY TÍN -->
<section class="py-5 bg-light" id="nha-phan-phoi">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                    <i class="bi bi-shield-check me-1"></i>ĐỐI TÁC XÁC THỰC
                </span>
                <h3 class="fw-bold text-dark mb-1">Mạng Lưới Nhà Phân Phối Uy Tín</h3>
                <p class="text-muted mb-0">Các nhà phân phối đầu mối, tổng kho cung ứng với nguồn hàng dồi dào và giá sỉ tận gốc</p>
            </div>
            <a asp-controller="SanB2B" asp-action="Index" asp-route-loaiNPP="mall" class="btn btn-outline-primary rounded-pill px-4 mt-2 mt-md-0 fw-semibold">
                <i class="bi bi-award me-1"></i> Gian hàng Mall xác thực
            </a>
        </div>

        <div class="row g-4" id="distributorGrid">
            @foreach (var np in Model.DanhSachNhaPhanPhoi)
            {
                <div class="col-xl-3 col-lg-4 col-md-6 distributor-card-wrapper">
                    <div class="card h-100 border-0 shadow-sm rounded-4 supplier-bento-card position-relative overflow-hidden">
                        @if (np.LaGianHangMall)
                        {
                            <div class="badge-mall-ribbon">
                                <i class="bi bi-patch-check-fill me-1"></i> MALL
                            </div>
                        }

                        <div class="card-body p-4 d-flex flex-column">
                            <div class="d-flex align-items-center gap-3 mb-3">
                                <div class="supplier-avatar-box rounded-3 bg-light border d-flex align-items-center justify-content-center shadow-xs">
                                    @if (!string.IsNullOrEmpty(np.Logo))
                                    {
                                        <img src="@np.Logo" alt="@np.TenDoanhNghiep" class="img-fluid rounded-3 p-1" style="max-height: 48px;"
                                             onerror="this.onerror=null; this.src='/images/placeholder-supplier.svg';" />
                                    }
                                    else
                                    {
                                        <img src="~/images/placeholder-supplier.svg" alt="@np.TenDoanhNghiep" class="img-fluid rounded-3" style="max-height: 48px;" />
                                    }
                                </div>
                                <div class="flex-grow-1 overflow-hidden">
                                    <h6 class="fw-bold text-dark mb-1 text-truncate" title="@np.TenDoanhNghiep">@np.TenDoanhNghiep</h6>
                                    <div class="d-flex align-items-center gap-2">
                                        <span class="badge bg-warning-subtle text-dark border border-warning-subtle px-2 py-0" style="font-size: 11px;">
                                            <i class="bi bi-star-fill text-warning me-1"></i>@np.DiemUyTin.ToString("0.0")
                                        </span>
                                        @if (np.CoDeXuatAHP)
                                        {
                                            <span class="badge bg-info-subtle text-info border border-info-subtle px-2 py-0" style="font-size: 11px;" title="Xếp hạng cao trong đánh giá AHP">
                                                <i class="bi bi-award me-1"></i>AHP Top
                                            </span>
                                        }
                                    </div>
                                </div>
                            </div>

                            <p class="text-muted small mb-3 supplier-desc flex-grow-1" style="font-size: 12.5px; line-height: 1.5;">
                                @np.MoTa
                            </p>

                            <div class="supplier-meta-box p-2 rounded-3 bg-light mb-3 small">
                                <div class="d-flex align-items-center text-muted mb-1 text-truncate">
                                    <i class="bi bi-geo-alt text-primary me-2"></i>
                                    <span class="text-truncate">@np.DiaChi</span>
                                </div>
                                <div class="d-flex justify-content-between align-items-center text-muted">
                                    <span><i class="bi bi-box-seam text-primary me-1"></i> Nguồn hàng:</span>
                                    <span class="fw-semibold text-dark">@(np.SoSanPhamChaoBan > 0 ? $"{np.SoSanPhamChaoBan} mặt hàng" : "Kho lớn đa dạng")</span>
                                </div>
                            </div>

                            <div class="d-flex gap-2">
                                <a asp-controller="SanB2B" asp-action="Index" asp-route-search="@np.TenDoanhNghiep"
                                   class="btn btn-sm btn-primary flex-grow-1 rounded-pill fw-semibold py-2">
                                    <i class="bi bi-shop me-1"></i> Xem kho sỉ
                                </a>
                                <a href="tel:@np.SoDienThoai" class="btn btn-sm btn-outline-secondary rounded-circle d-flex align-items-center justify-content-center"
                                   style="width: 36px; height: 36px;" title="Gọi tư vấn sỉ: @np.SoDienThoai">
                                    <i class="bi bi-telephone"></i>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- SECTION 3: NGUỒN HÀNG GIÁ SỈ B2B TIÊU BIỂU (Lướt tìm sản phẩm giá sỉ) -->
<section class="py-5 bg-white" id="nguon-hang">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4">
            <div>
                <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-1 rounded-pill mb-2 fw-semibold">
                    <i class="bi bi-tag-fill me-1"></i>GIÁ SỈ TẬN GỐC
                </span>
                <h3 class="fw-bold text-dark mb-1">Nguồn Hàng B2B Đang Chào Bán Giá Tốt</h3>
                <p class="text-muted mb-0">Hàng hóa sẵn kho, giá chiết khấu buôn từ 10% - 25% cho các Nhà Phân Phối</p>
            </div>
            <div class="d-flex gap-2 mt-3 mt-md-0">
                <a asp-controller="SanB2B" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-grid me-1"></i> Lướt toàn bộ sàn B2B &rarr;
                </a>
            </div>
        </div>

        <div class="row g-4" id="productListGrid">
            @foreach (var sp in Model.DanhSachSanPhamHot)
            {
                var discountPercent = sp.GiaGoc > sp.GiaSi ? Math.Round((1 - (sp.GiaSi / sp.GiaGoc)) * 100) : 0;
                <div class="col-xl-3 col-lg-4 col-md-6 product-b2b-col" data-cat="@sp.TenDanhMuc">
                    <div class="card h-100 border rounded-4 product-b2b-card shadow-xs overflow-hidden">
                        <div class="position-relative product-img-box bg-light text-center p-3">
                            @if (discountPercent > 0)
                            {
                                <span class="badge bg-danger position-absolute top-0 start-0 m-3 px-2 py-1 rounded-pill fw-bold" style="font-size: 11px;">
                                    -@discountPercent% SỈ
                                </span>
                            }
                            @if (sp.LaMall)
                            {
                                <span class="badge bg-dark position-absolute top-0 end-0 m-3 px-2 py-1 rounded-pill fw-bold text-warning" style="font-size: 10px;">
                                    MALL
                                </span>
                            }

                            <div class="d-flex align-items-center justify-content-center" style="height: 140px;">
                                @if (!string.IsNullOrEmpty(sp.AnhSanPham))
                                {
                                    <img src="@sp.AnhSanPham" alt="@sp.TenSanPham" class="img-fluid"
                                         style="max-height: 130px; object-fit: contain;" loading="lazy"
                                         onerror="this.onerror=null; this.src='/images/placeholder-product.svg';" />
                                }
                                else
                                {
                                    <img src="~/images/placeholder-product.svg" alt="Sản phẩm" class="img-fluid" style="max-height: 110px;" />
                                }
                            </div>
                        </div>

                        <div class="card-body p-3 d-flex flex-column">
                            <small class="text-muted text-uppercase mb-1" style="font-size: 11px; letter-spacing: 0.5px;">
                                @sp.TenDanhMuc
                            </small>
                            <h6 class="fw-bold text-dark mb-2 text-truncate-2" title="@sp.TenSanPham" style="min-height: 42px; line-height: 1.4;">
                                @sp.TenSanPham
                            </h6>

                            <div class="supplier-row d-flex align-items-center gap-1 text-muted small mb-2 text-truncate" title="Kho phân phối: @sp.TenNhaCungCap">
                                <i class="bi bi-building text-primary"></i>
                                <span class="text-truncate">@sp.TenNhaCungCap</span>
                            </div>

                            <div class="mt-auto pt-2 border-top">
                                <div class="d-flex align-items-baseline justify-content-between mb-2">
                                    <div>
                                        <span class="fs-5 fw-bold text-danger">@sp.GiaSi.ToString("N0")</span>
                                        <small class="text-muted" style="font-size: 11px;">đ/@sp.DonViTinh</small>
                                    </div>
                                    @if (sp.GiaGoc > sp.GiaSi)
                                    {
                                        <span class="text-decoration-line-through text-muted small">@sp.GiaGoc.ToString("N0") đ</span>
                                    }
                                </div>

                                <div class="d-flex align-items-center justify-content-between small text-muted mb-3">
                                    <span><i class="bi bi-truck me-1"></i> Giao: ~@sp.ThoiGianGiaoHang ngày</span>
                                    <span>Sẵn: <strong class="text-dark">@sp.SoLuongCoSan</strong></span>
                                </div>

                                <a asp-controller="SanB2B" asp-action="ChiTiet" asp-route-id="@(sp.MaTonKhoNPP ?? sp.MaSanPham)"
                                   class="btn btn-sm btn-outline-primary w-100 rounded-pill fw-semibold py-2">
                                    <i class="bi bi-cart-plus me-1"></i> Xem & Đặt sỉ
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<!-- SECTION 4: ĐIỂM NHẤN CÔNG NGHỆ THUẬT TOÁN AHP -->
<section class="py-5 bg-gradient-dark text-white position-relative" id="cong-nghe-ahp">
    <div class="container py-3">
        <div class="row align-items-center g-5">
            <div class="col-lg-6">
                <span class="badge bg-primary px-3 py-1 rounded-pill mb-3 fw-semibold">
                    <i class="bi bi-lightbulb me-1"></i>CÔNG NGHỆ ĐỘC QUYỀN
                </span>
                <h2 class="display-6 fw-bold text-white mb-3">
                    Thuật Toán AHP — Trợ Lý Ra Quyết Định Nhập Hàng Thông Minh
                </h2>
                <p class="text-white-50 mb-4" style="line-height: 1.7;">
                    Khác với các sàn B2B thông thường chỉ so sánh giá bán lẻ tẻ, hệ thống ứng dụng <strong>Mô hình Phân tích Thứ bậc AHP (Analytic Hierarchy Process)</strong> do GS. Thomas Saaty sáng lập, giúp Nhà Phân Phối cân đối toàn diện 4 trụ cột quan trọng:
                </p>

                <div class="row g-3 mb-4">
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2 text-info">
                                <i class="bi bi-cash-coin fs-4"></i>
                                <h6 class="mb-0 fw-bold text-white">1. Giá cả & Chiết khấu</h6>
                            </div>
                            <small class="text-white-50">So sánh giá buôn niêm yết, chính sách chiết khấu bậc thang theo sản lượng đặt hàng.</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2 text-success">
                                <i class="bi bi-patch-check fs-4"></i>
                                <h6 class="mb-0 fw-bold text-white">2. Chất lượng & Hạn dùng</h6>
                            </div>
                            <small class="text-white-50">Đánh giá tiêu chuẩn hàng hóa, chứng nhận ATTP và hạn sử dụng dài hạn của lô hàng.</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
                        <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-10 h-100">
                            <div class="d-flex align-items-center gap-2 mb-2 text-warning">
                                <i class="bi bi-clock-history fs-4"></i>
                                <h6 class="mb-0 fw-bold text-white">3. Tốc độ Giao hàng</h6>
                            </div>
                            <small class="text-white-50">Cam kết thời gian xuất kho, khoảng cách địa lý và tỷ lệ đúng hẹn để chống đứt hàng.</small>
                        </div>
                    </div>
                    <div class="col-sm-6">
