@section Scripts {
    <script>
        // Lọc danh mục sản phẩm trên giao diện
        function filterByCatalog(catId, btnElement) {
            document.querySelectorAll('.btn-category-pill').forEach(btn => btn.classList.remove('active'));
            btnElement.classList.add('active');

            const catSelect = document.getElementById('heroCategorySelect');
            if (catSelect) {
                catSelect.value = catId > 0 ? catId : "";
            }

            // Scroll nhẹ xuống danh sách sản phẩm
            const productSection = document.getElementById('nguon-hang');
            if (productSection && catId > 0) {
                productSection.scrollIntoView({ behavior: 'smooth' });
            }
        }
    </script>
}
