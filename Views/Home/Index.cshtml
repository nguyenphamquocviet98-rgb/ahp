@model DashboardViewModel
@{
    ViewData["Title"] = "Dashboard Tổng quan";
    var username = User.Identity?.Name ?? "Người dùng";
    var role = User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value ?? "nhanvien";
}

<!-- Page Header Toolbar -->
<div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--gray-900); font-size: 20px;">
            Tổng quan hệ thống
        </h3>
        <p style="color: var(--gray-500); font-size: 13px; margin: 0;">
            Theo dõi tình hình nhập hàng, tồn kho và đề xuất đối tác cung ứng tối ưu.
        </p>
    </div>
    <div class="d-flex gap-2">
        <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-plus-lg"></i> Lập phiếu nhập
        </a>
        <a asp-controller="AHP" asp-action="MaTranSoSanh" class="btn btn-custom btn-custom-primary">
            <i class="bi bi-calculator"></i> Đánh giá AHP
        </a>
    </div>
</div>

<!-- 5 Clean Metric Cards -->
<div class="row g-3 mb-4">
    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Sản phẩm quản lý</span>
                <div class="kpi-icon-pill"><i class="bi bi-box-seam"></i></div>
            </div>
            <div class="kpi-value">@Model.TongSanPham</div>
            <div class="kpi-trend">
                <i class="bi bi-check2 text-success"></i> Đang hoạt động
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Nhà cung cấp</span>
                <div class="kpi-icon-pill"><i class="bi bi-buildings"></i></div>
            </div>
            <div class="kpi-value">@Model.TongNhaCungCap</div>
            <div class="kpi-trend">
                <i class="bi bi-shield-check text-primary"></i> Đã thẩm định AHP
            </div>
        </div>
    </div>

    <div class="col-xl col-md-4 col-sm-6">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Phiếu nhập kho</span>
                <div class="kpi-icon-pill"><i class="bi bi-receipt"></i></div>
            </div>
            <div class="kpi-value">@Model.TongPhieuNhap</div>
            <div class="kpi-trend">
                <i class="bi bi-clock-history"></i> Toàn thời gian
            </div>
        </div>
    </div>

    <div class="col-xl col-md-6 col-sm-6">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Tổng giá trị nhập</span>
                <div class="kpi-icon-pill"><i class="bi bi-cash"></i></div>
            </div>
            <div class="kpi-value" style="font-size: 21px;">@Model.TongGiaTriNhap.ToString("N0") <span class="kpi-unit">VNĐ</span></div>
            <div class="kpi-trend">
                <i class="bi bi-graph-up text-secondary"></i> Tổng luân chuyển
            </div>
        </div>
    </div>

    <div class="col-xl col-md-6 col-sm-12">
        <div class="kpi-card">
            <div class="kpi-top">
                <span class="kpi-label">Tổng tồn kho</span>
                <div class="kpi-icon-pill"><i class="bi bi-boxes"></i></div>
            </div>
            <div class="kpi-value">@Model.TongSoLuongTon <span class="kpi-unit">đơn vị</span></div>
            <div class="kpi-trend">
                <i class="bi bi-layers text-secondary"></i> Lưu kho an toàn
            </div>
        </div>
    </div>
</div>

<!-- Recommended Supplier Banner (Clean & Authentic) -->
<div class="mb-4">
    <div class="spotlight-card">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <div class="spotlight-tag mb-2">
                    <i class="bi bi-award"></i> ĐỀ XUẤT AHP GẦN NHẤT
                </div>

                @if (Model.NhaCungCapDeXuatGanNhat != null && Model.NhaCungCapDeXuatGanNhat.NhaCungCap != null)
                {
                    var ncc = Model.NhaCungCapDeXuatGanNhat.NhaCungCap;
                    <div class="spotlight-title">
                        @ncc.TenNhaCungCap
                        <span class="status-badge status-badge-success ms-2">Hạng 1</span>
                    </div>
                    <div class="spotlight-meta">
                        Kỳ: <strong>@(Model.NhaCungCapDeXuatGanNhat.KyDanhGia?.TenKyDanhGia ?? "Kỳ hiện tại")</strong> &bull;
                        Người liên hệ: <strong>@(ncc.NguoiLienHe ?? "—")</strong> &bull;
                        SĐT: <strong>@(ncc.SoDienThoai ?? "—")</strong> &bull;
                        Email: <strong>@(ncc.Email ?? "—")</strong>
                    </div>
                    <div class="mt-3">
                        <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-accent me-2">
                            <i class="bi bi-plus-circle me-1"></i> Tạo phiếu nhập từ NCC này
                        </a>
                        <a asp-controller="AHP" asp-action="KetQuaXepHang" asp-route-id="@Model.NhaCungCapDeXuatGanNhat.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
                            Xem phân tích chi tiết
                        </a>
                    </div>
                }
                else
                {
                    <h5 class="fw-bold mb-1" style="color: var(--gray-800);">Chưa có kết quả AHP</h5>
                    <p style="color: var(--gray-500); font-size: 13px; margin: 0;">
                        Hãy hoàn thiện ma trận so sánh cặp và chấm điểm nhà cung cấp để hệ thống đưa ra đề xuất tối ưu.
                    </p>
                }
            </div>

            <div class="col-lg-4 text-lg-end mt-3 mt-lg-0">
                @if (Model.NhaCungCapDeXuatGanNhat != null)
                {
                    <div class="spotlight-score-box d-inline-block">
                        <div style="font-size: 11px; font-weight: 600; color: var(--gray-500); text-transform: uppercase;">Điểm tổng hợp WSM</div>
                        <div class="spotlight-score-num mt-1">
                            @(Model.NhaCungCapDeXuatGanNhat.DiemTong?.ToString("0.00") ?? "N/A")
                            <span style="font-size: 13px; color: var(--gray-400); font-weight: 400;">/ 9.0</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<!-- 2 Clean Charts -->
<div class="row g-4 mb-4">
    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5>Phân bố sản phẩm theo Danh mục</h5>
                <span class="status-badge status-badge-secondary">Cơ cấu kho</span>
            </div>
            <div class="card-body-custom d-flex align-items-center justify-content-center" style="min-height: 240px;">
                <canvas id="categoryChart" style="max-height: 210px;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5>So sánh năng lực Nhà cung cấp (AHP)</h5>
                <span class="status-badge status-badge-secondary">Điểm tổng hợp WSM</span>
            </div>
            <div class="card-body-custom d-flex align-items-center justify-content-center" style="min-height: 240px;">
                <canvas id="supplierChart" style="max-height: 210px;"></canvas>
            </div>
        </div>
    </div>
</div>

<!-- 2 Bảng Dữ Liệu -->
<div class="row g-4 mb-4">
    <!-- Phiếu nhập gần nhất -->
    <div class="col-lg-7">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5>Phiếu nhập gần đây</h5>
                <a asp-controller="PhieuNhap" asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    Xem tất cả <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body-custom p-0">
                @if (Model.PhieuNhapMoiNhat.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Mã phiếu</th>
                                    <th>Nhà cung cấp</th>
                                    <th>Ngày nhập</th>
                                    <th class="text-end">Tổng tiền</th>
                                    <th class="text-center">Trạng thái</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var pn in Model.PhieuNhapMoiNhat)
                                {
                                    var tongTien = (pn.TongTien.HasValue && pn.TongTien.Value > 0)
                                        ? pn.TongTien.Value
                                        : (pn.ChiTietPhieuNhaps?.Sum(c => c.ThanhTien ?? (c.SoLuong * c.DonGia) ?? 0) ?? 0);
                                    <tr>
                                        <td>
                                            <a asp-controller="PhieuNhap" asp-action="Details" asp-route-id="@pn.MaPhieuNhap" class="code-badge text-decoration-none">
                                                @(pn.MaPhieuNhapCode ?? $"PN{pn.MaPhieuNhap:D4}")
                                            </a>
                                        </td>
                                        <td>
                                            <strong style="color: var(--gray-900);">@(pn.NhaCungCap?.TenNhaCungCap ?? "N/A")</strong>
                                        </td>
                                        <td style="color: var(--gray-500); font-size: 12.5px;">
                                            @(pn.NgayNhap?.ToString("dd/MM/yyyy") ?? pn.NgayTao?.ToString("dd/MM/yyyy") ?? "N/A")
                                        </td>
                                        <td class="text-end font-mono fw-semibold" style="color: var(--gray-900);">
                                            @(tongTien.ToString("N0")) đ
                                        </td>
                                        <td class="text-center">
                                            @if (pn.TrangThai == "xacnhan")
                                            {
                                                <span class="status-badge status-badge-success">Đã duyệt</span>
                                            }
                                            else if (pn.TrangThai == "huy")
                                            {
                                                <span class="status-badge status-badge-danger">Đã hủy</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge-warning">Chờ xử lý</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có phiếu nhập hàng nào trong hệ thống.</p>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Tình trạng tồn kho -->
    <div class="col-lg-5">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5>Theo dõi tồn kho</h5>
                <a asp-controller="TonKho" asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    Chi tiết <i class="bi bi-arrow-right"></i>
                </a>
            </div>
            <div class="card-body-custom p-0">
                @if (Model.DanhSachTonKho.Any())
                {
                    <div class="table-responsive">
                        <table class="table-custom">
                            <thead>
                                <tr>
                                    <th>Sản phẩm</th>
                                    <th>ĐVT</th>
                                    <th class="text-end">Tồn kho</th>
                                    <th class="text-center">Tình trạng</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var tk in Model.DanhSachTonKho.Take(6))
                                {
                                    var soLuong = tk.SoLuongTon ?? 0;
                                    <tr>
                                        <td>
                                            <div class="fw-medium" style="color: var(--gray-900);">@(tk.SanPham?.TenSanPham ?? "N/A")</div>
                                            <small style="color: var(--gray-400); font-size: 11.5px;">@(tk.SanPham?.DanhMuc?.TenDanhMuc ?? "")</small>
                                        </td>
                                        <td style="color: var(--gray-600);">@(tk.SanPham?.DonViTinh?.TenDonVi ?? "-")</td>
                                        <td class="text-end font-mono fw-semibold" style="color: var(--gray-900);">@soLuong</td>
                                        <td class="text-center">
                                            @if (soLuong < 20)
                                            {
                                                <span class="status-badge status-badge-danger">Tồn thấp</span>
                                            }
                                            else
                                            {
                                                <span class="status-badge status-badge-success">Đủ hàng</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="empty-state">
                        <i class="bi bi-inbox"></i>
                        <p>Chưa có dữ liệu tồn kho.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            // 1. Biểu đồ Donut Danh mục sản phẩm (Restrained Enterprise Colors)
            const ctxCat = document.getElementById('categoryChart');
            if (ctxCat) {
                new Chart(ctxCat, {
                    type: 'doughnut',
                    data: {
                        labels: ['Bánh kẹo & Đồ ngọt', 'Đồ uống & Giải khát', 'Gia vị & Thực phẩm khô', 'Sữa & Chế phẩm'],
                        datasets: [{
                            data: [2, 1, 1, 1],
                            backgroundColor: ['#1E293B', '#3B82F6', '#64748B', '#CBD5E1'],
                            borderWidth: 2,
                            borderColor: '#FFFFFF'
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: {
                                position: 'right',
                                labels: {
                                    font: { family: 'Inter', size: 12 },
                                    boxWidth: 10,
                                    padding: 10
                                }
                            }
                        },
                        cutout: '72%'
                    }
                });
            }

            // 2. Biểu đồ Cột So sánh Nhà cung cấp
            const ctxSup = document.getElementById('supplierChart');
            if (ctxSup) {
                new Chart(ctxSup, {
                    type: 'bar',
                    data: {
                        labels: ['Thực phẩm Á Châu', 'Thương mại Tân Phú', 'Nông sản Việt', 'DNTN Hoàng Gia'],
                        datasets: [{
                            label: 'Điểm tổng hợp (WSM)',
                            data: [8.05, 6.75, 6.45, 6.15],
                            backgroundColor: [
                                '#2563EB', // Top 1 Accent
                                '#94A3B8',
                                '#CBD5E1',
                                '#E2E8F0'
                            ],
                            borderRadius: 4,
                            barPercentage: 0.6
                        }]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        plugins: {
                            legend: { display: false }
                        },
                        scales: {
                            y: {
                                beginAtZero: true,
                                max: 9,
                                grid: { color: '#F1F5F9' },
                                ticks: { font: { family: 'JetBrains Mono', size: 11 }, stepSize: 3 }
                            },
                            x: {
                                grid: { display: false },
                                ticks: { font: { family: 'Inter', size: 11 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
