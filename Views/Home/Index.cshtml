<!-- SECTION 5: KHU VỰC TRẢI NGHIỆM TÀI KHOẢN DEMO 1-CLICK -->
@if (HostEnvironment.IsDevelopment())
{
<section class="py-5 bg-light" id="tai-khoan-demo">
    <div class="container">
        <div class="text-center mb-5">
            <span class="badge bg-warning text-dark px-3 py-1 rounded-pill mb-2 fw-semibold">
                <i class="bi bi-lightning-charge-fill me-1"></i>DÀNH CHO HỘI ĐỒNG & KHÁCH ĐÁNH GIÁ
            </span>
            <h3 class="fw-bold text-dark mb-2">Trải Nghiệm Nhanh Toàn Diện Hệ Thống (1-Click)</h3>
            <p class="text-muted mx-auto" style="max-width: 680px;">
                Không cần đăng ký phức tạp. Chọn một trong các vai trò người dùng bên dưới để hệ thống tự động đăng nhập và trải nghiệm ngay quy trình thực tế.
            </p>
        </div>

        <div class="row g-3 justify-content-center">
            @foreach (var acc in Model.TaiKhoanDemo)
            {
                var roleBadge = acc.VaiTro == "admin_san" ? "bg-danger text-white" : acc.VaiTro == "chu_npp" ? "bg-success text-white" : "bg-primary text-white";
                var roleName = acc.VaiTro == "admin_san" ? "Admin Quản Trị Sàn" : acc.VaiTro == "chu_npp" ? "Chủ Nhà Phân Phối" : "Nhân Viên Quản Lý Kho";
                var roleIcon = acc.VaiTro == "admin_san" ? "bi-shield-shaded" : acc.VaiTro == "chu_npp" ? "bi-building-fill-check" : "bi-person-badge";

                <div class="col-lg-4 col-md-6">
                    <div class="card h-100 border-0 shadow-sm rounded-4 demo-role-card p-3">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="badge @roleBadge px-3 py-1 rounded-pill" style="font-size: 11px;">
                                <i class="bi @roleIcon me-1"></i>@roleName
                            </span>
                            @if (acc.LaMall)
                            {
                                <span class="badge bg-dark text-warning border" style="font-size: 10px;">MALL VIP</span>
                            }
                        </div>

                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="demo-avatar rounded-circle bg-light border d-flex align-items-center justify-content-center fw-bold text-dark fs-5" style="width: 44px; height: 44px;">
                                @(acc.TenDangNhap.Length > 0 ? acc.TenDangNhap.Substring(0, 1).ToUpper() : "U")
                            </div>
                            <div>
                                <h6 class="fw-bold text-dark mb-0">@acc.HoTen</h6>
                                <small class="text-muted">Username: <strong class="text-primary font-mono">@acc.TenDangNhap</strong></small>
                            </div>
                        </div>

                        <p class="text-muted small mb-3 flex-grow-1" style="font-size: 12px; line-height: 1.5;">
                            @if (acc.VaiTro == "admin_san")
                            {
                                <text>Quản trị toàn bộ sàn B2B, duyệt banner quảng cáo, cấu hình tham số AHP và xem thống kê doanh thu.</text>
                            }
                            else if (acc.VaiTro == "chu_npp")
                            {
                                <text>Gian hàng @acc.TenDoanhNghiep: Chào bán sỉ, nhập hàng, chạy thuật toán AHP chọn nhà cung cấp tối ưu.</text>
                            }
                            else
                            {
                                <text>Tài khoản nhân viên: Theo dõi tồn kho thực tế, lập phiếu nhập kho và kiểm tra hàng dưới định mức an toàn.</text>
                            }
                        </p>

                        <form asp-controller="Account" asp-action="QuickSwitch" method="post">
                            <input type="hidden" name="userId" value="@acc.MaNguoiDung" />
                            <button type="submit" class="btn btn-outline-primary w-100 rounded-pill fw-semibold py-2">
                                <i class="bi bi-box-arrow-in-right me-1"></i> Đăng nhập vai trò này &rarr;
                            </button>
                        </form>
                    </div>
                </div>
            }
        </div>
    </div>
</section>
}


