@model IEnumerable<code.Models.KyDanhGia>
@{
    ViewData["Title"] = "Kỳ đánh giá AHP";
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly");
}

<div class="page-header">
    <div class="page-header-left">
        <h3>Kỳ đánh giá Nhà cung cấp (AHP)</h3>
        <p>Quản lý các đợt đánh giá đa tiêu chí, tính trọng số AHP và xếp hạng đối tác cung ứng</p>
    </div>
    <div>
        @if (isManagerOrAdmin)
        {
            <a asp-action="CreateKy" class="btn btn-custom btn-custom-primary">
                <i class="bi bi-plus-circle"></i> Tạo kỳ đánh giá mới
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-custom alert-custom-danger mb-3"><i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]</div>
}

<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Kỳ đánh giá</th>
                    <th class="text-center" style="width: 150px;">Trạng thái</th>
                    <th>Nhà cung cấp đề xuất</th>
                    <th class="text-end" style="width: 190px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var deXuat = item.KetQuaXepHangs.FirstOrDefault(k => k.DeXuat == true)?.NhaCungCap;
                        <tr>
                            <td>
                                <strong style="color: var(--slate-800);">@item.TenKyDanhGia</strong>
                                <div style="color: var(--slate-400); font-size: 12.5px; margin-top: 2px;">
                                    Kỳ #@item.MaKyDanhGia · @(item.NguoiDung?.TenDangNhap ?? "Hệ thống") · @(item.NgayTao?.ToString("dd/MM/yyyy HH:mm") ?? "—")
                                </div>
                            </td>
                            <td class="text-center">
                                @if (item.TrangThai == "hoanthanh")
                                {
                                    <span class="status-badge status-badge-success">Hoàn thành</span>
                                }
                                else if (item.TrangThai == "dat_trong_so" || item.TrongSoTieuChis.Any())
                                {
                                    <span class="status-badge status-badge-primary">Có trọng số</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-warning">Khởi tạo</span>
                                }
                            </td>
                            <td>
                                @if (deXuat != null)
                                {
                                    <span style="color: var(--slate-800); font-weight: 600;">@deXuat.TenNhaCungCap</span>
                                }
                                else
                                {
                                    <span style="color: var(--slate-400);">—</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btn-group">
                                    <a asp-action="MaTranSoSanh" asp-route-id="@item.MaKyDanhGia" class="btn btn-sm btn-outline-primary" title="Ma trận so sánh (Bước 1)">
                                        <i class="bi bi-grid-3x3"></i>
                                    </a>
                                    @if (item.TrongSoTieuChis.Any())
                                    {
                                        <a asp-action="ChamDiemNCC" asp-route-id="@item.MaKyDanhGia" class="btn btn-sm btn-outline-secondary" title="Chấm điểm NCC (Bước 2)">
                                            <i class="bi bi-star"></i>
                                        </a>
                                    }
                                    @if (item.KetQuaXepHangs.Any())
                                    {
                                        <a asp-action="KetQuaXepHang" asp-route-id="@item.MaKyDanhGia" class="btn btn-sm btn-outline-secondary" title="Xem xếp hạng (Bước 3)">
                                            <i class="bi bi-trophy"></i>
                                        </a>
                                    }
                                    @if (isManagerOrAdmin)
                                    {
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa kỳ"
                                                onclick="confirmDelete(@item.MaKyDanhGia, '@item.TenKyDanhGia')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="4">
                            <div class="empty-state"><i class="bi bi-inbox"></i><p>Chưa có kỳ đánh giá AHP nào trong hệ thống.</p></div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_DeleteModal" view-data='new ViewDataDictionary(ViewData) { ["DeleteAction"] = "DeleteKy", ["DeleteNote"] = "Toàn bộ dữ liệu ma trận, trọng số và kết quả xếp hạng của kỳ này sẽ bị xóa bỏ." }' />
