@model code.Models.KyDanhGia
@{
    ViewData["Title"] = "Tạo kỳ đánh giá AHP mới";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="bi bi-calendar3-plus text-primary me-1"></i> Tạo Kỳ Đánh Giá AHP Mới</h5>
                <a asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>
            <div class="card-body-custom">
                <form asp-action="CreateKy" method="post" class="form-custom">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label asp-for="TenKyDanhGia" class="form-label">Tên kỳ đánh giá <span class="text-danger">*</span></label>
                        <input asp-for="TenKyDanhGia" class="form-control" placeholder="Ví dụ: Đánh giá nhà cung cấp Quý 3/2026..." required maxlength="50" />
                        <span asp-validation-for="TenKyDanhGia" class="text-danger small"></span>
                    </div>

                    <div class="p-3 mb-4" style="background: var(--slate-50); border-radius: var(--radius-md);">
                        <div class="fw-semibold mb-2" style="color: var(--slate-800);">
                            <i class="bi bi-info-circle text-primary me-1"></i> Quy trình đánh giá đa tiêu chí AHP:
                        </div>
                        <ol class="small mb-0 ps-3" style="color: var(--slate-600);">
                            <li class="mb-1"><strong>Nhập ma trận so sánh cặp:</strong> So sánh mức độ quan trọng giữa 4 tiêu chí (Giá, Chất lượng, Giao hàng, Uy tín) theo thang điểm Saaty 1–9.</li>
                            <li class="mb-1"><strong>Tính toán AHP &amp; kiểm tra CR:</strong> Hệ thống tự động tính trọng số Wi, λmax, CI và kiểm tra tỷ số nhất quán CR ≤ 0.10.</li>
                            <li><strong>Chấm điểm &amp; xếp hạng:</strong> Chấm điểm từng NCC theo tiêu chí và tổng hợp theo mô hình Weighted Sum để đề xuất đối tác tốt nhất.</li>
                        </ol>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline">Hủy</a>
                        <button type="submit" class="btn btn-custom btn-custom-primary">
                            <i class="bi bi-arrow-right-circle me-1"></i> Tạo kỳ &amp; Nhập ma trận
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
