@model code.Models.KyDanhGia
@{
    ViewData["Title"] = "Tạo kỳ đánh giá AHP mới";
}

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
            <div class="d-flex align-items-center mb-3">
                <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3" title="Quay lại">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h4 class="fw-bold text-dark mb-0">Tạo Kỳ Đánh Giá AHP Mới</h4>
                    <small class="text-muted">Bước 1 trong quy trình 3 bước đánh giá nhà cung cấp</small>
                </div>
            </div>

            <form asp-action="CreateKy" method="post">
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="TenKyDanhGia" class="form-label fw-semibold">Tên kỳ đánh giá <span class="text-danger">*</span></label>
                    <input asp-for="TenKyDanhGia" class="form-control rounded-3" placeholder="Ví dụ: Đánh giá nhà cung cấp Quý 3/2026..." required maxlength="50" />
                    <span asp-validation-for="TenKyDanhGia" class="text-danger small"></span>
                </div>

                <div class="p-3 bg-light rounded-3 mb-4 border">
                    <div class="fw-semibold text-dark mb-2"><i class="bi bi-info-circle text-primary me-1"></i> Quy trình thực hiện sau khi tạo:</div>
                    <ol class="small text-secondary mb-0 ps-3">
                        <li class="mb-1"><strong>Nhập ma trận so sánh cặp:</strong> So sánh mức độ quan trọng giữa 4 tiêu chí (Giá, Chất lượng, Giao hàng, Uy tín) theo thang điểm Saaty 1-9.</li>
                        <li class="mb-1"><strong>Tính toán AHP & Kiểm tra CR:</strong> Hệ thống tự động tính Trọng số $W_i$, $\lambda_{max}$, $CI$ và kiểm tra tỷ số nhất quán $CR \le 0.10$.</li>
                        <li><strong>Chấm điểm & Xếp hạng:</strong> Chấm điểm từng NCC theo tiêu chí và tổng hợp theo mô hình Weighted Sum để đề xuất đối tác tốt nhất.</li>
                    </ol>
                </div>

                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index" class="btn btn-light rounded-3 px-4">Hủy</a>
                    <button type="submit" class="btn btn-primary rounded-3 px-4">
                        <i class="bi bi-arrow-right-circle me-1"></i> Tạo kỳ & Nhập ma trận
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
