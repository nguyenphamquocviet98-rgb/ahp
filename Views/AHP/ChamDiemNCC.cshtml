@model code.Models.ViewModels.ChamDiemNCCInputModel
@{
    ViewData["Title"] = "Chấm điểm nhà cung cấp - " + Model.TenKyDanhGia;
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly");
    var nccs = Model.DanhSachNCC;
    var tieuChis = Model.DanhSachTieuChi;
    var trongSoMap = Model.TrongSos.ToDictionary(t => t.MaTieuChi ?? 0, t => t.TrongSo ?? 0);
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-md-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-custom alert-custom-success mb-3">
                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
            </div>
        }

        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert-custom alert-custom-danger mb-3">
                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
            </div>
        }

        <!-- Header Chấm điểm -->
        <div class="page-header">
            <div class="page-header-left">
                <div class="d-flex align-items-center">
                    <a asp-action="KetQuaTrongSo" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline me-3" style="padding: 6px 10px;" title="Quay lại trọng số AHP">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    <div>
                        <h3><i class="bi bi-star-fill text-warning"></i> Bước 2: Chấm Điểm Năng Lực Nhà Cung Cấp</h3>
                        <p>Kỳ đánh giá: <strong>@Model.TenKyDanhGia</strong> &bull; Đánh giá từng đối tác theo 4 tiêu chí đã tính trọng số AHP</p>
                    </div>
                </div>
            </div>

            <div class="d-flex gap-2">
                <a asp-action="MaTranSoSanh" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
                    <i class="bi bi-grid-3x3"></i> Bước 1: Trọng số AHP
                </a>
            </div>
        </div>

        <!-- Hướng dẫn chấm điểm -->
        <div class="card-custom mb-4" style="background: linear-gradient(135deg, #ECFDF5 0%, #FFFFFF 100%); border-color: #A7F3D0;">
            <div class="card-body-custom">
                <div class="d-flex align-items-start gap-3">
                    <div style="width: 36px; height: 36px; border-radius: 8px; background: #059669; color: #FFF; display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;">
                        <i class="bi bi-check-circle-fill"></i>
                    </div>
                    <div>
                        <h6 class="fw-bold mb-1" style="color: #065F46; font-size: 14px;">
                            Nguyên tắc chấm điểm năng lực (Thang điểm 1 đến 9):
                        </h6>
                        <p class="small mb-0" style="color: #047857;">
                            Điểm càng cao thể hiện năng lực càng tốt: <strong>Giá rẻ/tiết kiệm &rarr; Điểm Giá cao</strong>, <strong>Chất lượng đạt chuẩn &rarr; Điểm CL cao</strong>, <strong>Giao hàng đúng hẹn &rarr; Điểm Giao cao</strong>. Cột <em>Điểm dự kiến (WSM)</em> sẽ tự động tính toán trực tiếp thời gian thực!
                        </p>
                    </div>
                </div>
            </div>
        </div>

        <form asp-action="LuuChamDiemVaXepHang" method="post" id="scoreForm">
            @Html.AntiForgeryToken()
            <input type="hidden" name="maKyDanhGia" value="@Model.MaKyDanhGia" />

            <!-- Bảng ma trận chấm điểm NCC -->
            <div class="card-custom mb-4">
                <div class="card-header-custom">
                    <div>
                        <h5><i class="bi bi-table text-primary"></i> Bảng Nhập Điểm Đánh Giá Nhà Cung Cấp</h5>
                        <small style="color: var(--slate-500);">Nhập điểm từ 1.0 đến 9.0 cho từng tiêu chí của đối tác</small>
                    </div>
                    <button type="button" class="btn btn-custom btn-custom-outline" onclick="fillDemoScores()">
                        <i class="bi bi-magic me-1"></i> Điền điểm đánh giá mẫu
                    </button>
                </div>

                <div class="card-body-custom p-0">
                    <div class="table-responsive">
                        <table class="table-custom text-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 260px;">Nhà cung cấp</th>
                                    @foreach (var tc in tieuChis)
                                    {
                                        decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                                        <th style="min-width: 170px;">
                                            <div style="font-weight: 700; color: var(--slate-900);">@tc.TenTieuChi</div>
                                            <span class="status-badge status-badge-primary mt-1" style="font-size: 10px;">
                                                Trọng số W: @w.ToString("0.000") (@((w * 100).ToString("0.0"))%)
                                            </span>
                                        </th>
                                    }
                                    <th class="text-center" style="width: 160px; background: var(--primary-light); color: var(--primary-700);">Điểm dự kiến (WSM)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var ncc in nccs)
                                {
                                    <tr>
                                        <td class="text-start">
                                            <div class="fw-bold" style="color: var(--slate-900);">@ncc.TenNhaCungCap</div>
                                            <span class="code-badge">@(ncc.MaNhaCungCapCode ?? $"NCC{ncc.MaNhaCungCap:D3}")</span>
                                        </td>
                                        @foreach (var tc in tieuChis)
                                        {
                                            decimal curScore = 5.0m;
                                            if (Model.DiemMap.ContainsKey(ncc.MaNhaCungCap) && Model.DiemMap[ncc.MaNhaCungCap].ContainsKey(tc.MaTieuChi))
                                            {
                                                curScore = Model.DiemMap[ncc.MaNhaCungCap][tc.MaTieuChi];
                                            }

                                            <td>
                                                <input type="number" step="0.5" min="1" max="9"
                                                       name="scores[@ncc.MaNhaCungCap][@tc.MaTieuChi]"
                                                       id="score_@(ncc.MaNhaCungCap)_@(tc.MaTieuChi)"
                                                       value="@curScore"
                                                       class="form-control text-center fw-bold score-input"
                                                       style="max-width: 100px; margin: 0 auto; border-color: var(--slate-300);"
                                                       data-weight="@(trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0)"
                                                       data-ncc="@ncc.MaNhaCungCap"
                                                       oninput="calcSupplierWSM(@ncc.MaNhaCungCap)" />
                                            </td>
                                        }
                                        <td style="background: var(--slate-50);">
                                            <span class="fw-bold fs-5 font-mono text-primary" id="wsm_preview_@ncc.MaNhaCungCap">
                                                0.00
                                            </span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    <div class="p-3 d-flex justify-content-end gap-2" style="border-top: 1px solid var(--border-color);">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline px-4">Hủy</a>
                        @if (isManagerOrAdmin)
                        {
                            <button type="submit" class="btn btn-custom btn-custom-emerald px-4 py-2">
                                <i class="bi bi-trophy-fill me-1"></i> Tính Tổng Điểm WSM & Xem Bảng Xếp Hạng
                            </button>
                        }
                    </div>
                </div>
            </div>
        </form>

        <!-- Thang điểm đánh giá -->
        <div class="card-custom">
            <div class="card-body-custom p-4">
                <h6 class="fw-bold mb-3" style="color: var(--slate-900);">
                    <i class="bi bi-info-circle text-primary"></i> Quy ước thang điểm đánh giá năng lực nhà cung cấp (1–9)
                </h6>
                <div class="row g-2 small" style="color: var(--slate-600);">
                    <div class="col-md-3"><span class="status-badge status-badge-danger">1 - 2</span> : Rất kém / Không đạt yêu cầu</div>
                    <div class="col-md-3"><span class="status-badge status-badge-warning">3 - 4</span> : Dưới trung bình / Còn hạn chế</div>
                    <div class="col-md-3"><span class="status-badge status-badge-primary">5 - 6</span> : Trung bình / Đạt mức cơ bản</div>
                    <div class="col-md-3"><span class="status-badge status-badge-success">7 - 9</span> : Tốt &rarr; Xuất sắc / Vượt trội</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function calcSupplierWSM(nccId) {
            const inputs = document.querySelectorAll(`input[data-ncc="${nccId}"]`);
            let total = 0;
            inputs.forEach(inp => {
                const score = parseFloat(inp.value) || 0;
                const weight = parseFloat(inp.getAttribute('data-weight')) || 0;
                total += score * weight;
            });
            const lbl = document.getElementById(`wsm_preview_${nccId}`);
            if (lbl) {
                lbl.innerText = total.toFixed(2);
            }
        }

        function recalcAll() {
            @foreach (var ncc in nccs)
            {
                <text>calcSupplierWSM(@ncc.MaNhaCungCap);</text>
            }
        }

        function fillDemoScores() {
            const demo = [
                { nccIdx: 0, scores: [6.5, 8.5, 7.5, 8.0] },
                { nccIdx: 1, scores: [9.0, 5.5, 4.5, 5.0] },
                { nccIdx: 2, scores: [5.0, 7.0, 8.5, 6.5] },
                { nccIdx: 3, scores: [7.0, 6.0, 6.0, 6.0] }
            ];

            const nccRows = document.querySelectorAll('tbody tr');
            demo.forEach((d, idx) => {
                if (idx < nccRows.length) {
                    const rowInputs = nccRows[idx].querySelectorAll('.score-input');
                    d.scores.forEach((s, sIdx) => {
                        if (sIdx < rowInputs.length) {
                            rowInputs[sIdx].value = s;
                        }
                    });
                }
            });

            recalcAll();
        }

        document.addEventListener('DOMContentLoaded', () => {
            recalcAll();
        });
    </script>
}
