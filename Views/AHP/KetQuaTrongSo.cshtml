@model code.Models.ViewModels.MaTranSoSanhInputModel
@{
    ViewData["Title"] = "Kết quả tính toán trọng số AHP - " + Model.TenKyDanhGia;
    var tieuChis = Model.DanhSachTieuChi;
    int n = tieuChis.Count;
    var res = Model.KetQuaAHP;
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-md-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
        }

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<!-- Header kết quả -->
<div class="page-header">
    <div class="page-header-left">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="MaTranSoSanh" asp-route-id="@Model.MaKyDanhGia" class="btn btn-sm btn-custom btn-custom-outline" title="Quay lại ma trận">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h3 class="mb-0">Bảng giải trình thuật toán AHP</h3>
                <p class="mb-0">Kỳ: <strong>@Model.TenKyDanhGia</strong></p>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <a asp-action="MaTranSoSanh" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-arrow-repeat me-1"></i> Điều chỉnh ma trận
        </a>
        <a asp-action="ChamDiemNCC" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-primary">
            Bước 2: Chấm điểm NCC <i class="bi bi-arrow-right"></i>
        </a>
    </div>
</div>

        @if (res != null)
        {
            <!-- 4 Thẻ Chỉ số AHP -->
            <div class="row g-3 mb-4">
                <div class="col-md-3">
                    <div class="card-custom p-3 text-center border-start border-primary border-4">
                        <div style="color: var(--slate-500); font-size: 11px; font-weight: 700; text-transform: uppercase;">Lambda Max (&lambda;<sub>max</sub>)</div>
                        <h4 class="fw-bold mb-0 font-mono mt-1" style="color: var(--primary);">@res.LambdaMax.ToString("0.0000")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card-custom p-3 text-center border-start border-info border-4">
                        <div style="color: var(--slate-500); font-size: 11px; font-weight: 700; text-transform: uppercase;">Chỉ số CI (Consistency Index)</div>
                        <h4 class="fw-bold mb-0 font-mono mt-1" style="color: var(--info);">@res.CI.ToString("0.0000")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card-custom p-3 text-center border-start @(res.IsConsistent ? "border-success" : "border-danger") border-4">
                        <div style="color: var(--slate-500); font-size: 11px; font-weight: 700; text-transform: uppercase;">Tỷ số CR (Consistency Ratio)</div>
                        <h4 class="fw-bold mb-0 font-mono mt-1 @(res.IsConsistent ? "text-success" : "text-danger")">@res.CR.ToString("0.0000")</h4>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card-custom p-3 text-center border-start @(res.IsConsistent ? "border-success" : "border-danger") border-4">
                        <div style="color: var(--slate-500); font-size: 11px; font-weight: 700; text-transform: uppercase;">Đánh giá nhất quán</div>
                        <div class="mt-1">
                            @if (res.IsConsistent)
                            {
                                <span class="status-badge status-badge-success fs-6 px-3 py-1">
                                    <i class="bi bi-check-circle me-1"></i> ĐẠT (CR &le; 0.10)
                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-badge-danger fs-6 px-3 py-1">
                                    <i class="bi bi-x-circle me-1"></i> KHÔNG ĐẠT
                                </span>
                            }
                        </div>
                    </div>
                </div>
            </div>

            <!-- Bảng 1: Ma trận chuẩn hóa và Trọng số W_i -->
            <div class="card-custom mb-4">
                <div class="card-header-custom">
                    <h5><i class="bi bi-1-circle" style="color: var(--primary);"></i> Bảng Ma Trận Chuẩn Hóa & Vector Trọng Số (W<sub>i</sub>)</h5>
                </div>
                <div class="card-body-custom p-0">
                    <div class="table-responsive">
                        <table class="table-custom text-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 220px;">Tiêu chí</th>
                                    @for (int j = 0; j < n; j++)
                                    {
                                        <th>@tieuChis[j].TenTieuChi</th>
                                    }
                                    <th style="width: 160px; background: var(--primary-light); color: var(--primary-dark);">Trọng số (W<sub>i</sub>)</th>
                                    <th style="width: 120px;">Tỷ lệ (%)</th>
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < n; i++)
                                {
                                    var w = res.TrongSo[i];
                                    <tr>
                                        <td class="text-start fw-bold" style="color: var(--slate-900);">@tieuChis[i].TenTieuChi</td>
                                        @for (int j = 0; j < n; j++)
                                        {
                                            <td class="font-mono small" style="color: var(--slate-600);">
                                                @res.MaTranChuanHoa[i, j].ToString("0.000")
                                            </td>
                                        }
                                        <td class="font-mono fw-bold fs-6" style="background: var(--primary-light); color: var(--primary);">
                                            @w.ToString("0.000")
                                        </td>
                                        <td class="fw-bold" style="color: var(--slate-900);">
                                            @((w * 100).ToString("0.0"))%
                                        </td>
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="background: var(--slate-50); font-weight: 700;">
                                <tr>
                                    <td class="text-start">Tổng cộng:</td>
                                    @for (int j = 0; j < n; j++)
                                    {
                                        <td style="color: var(--slate-400);">1.000</td>
                                    }
                                    <td class="font-mono fs-6" style="color: var(--primary);">
                                        @(res.TrongSo.Sum().ToString("0.000"))
                                    </td>
                                    <td style="color: var(--slate-900);">100%</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Bảng 2: Ma trận so sánh gốc & Tổng từng cột -->
            <div class="card-custom mb-4">
                <div class="card-header-custom">
                    <h5><i class="bi bi-2-circle" style="color: var(--slate-500);"></i> Ma Trận So Sánh Cặp Ban Đầu & Tổng Cột</h5>
                </div>
                <div class="card-body-custom p-0">
                    <div class="table-responsive">
                        <table class="table-custom text-center mb-0">
                            <thead>
                                <tr>
                                    <th class="text-start" style="width: 220px;">Tiêu chí</th>
                                    @for (int j = 0; j < n; j++)
                                    {
                                        <th>@tieuChis[j].TenTieuChi</th>
                                    }
                                </tr>
                            </thead>
                            <tbody>
                                @for (int i = 0; i < n; i++)
                                {
                                    <tr>
                                        <td class="text-start fw-semibold" style="background: var(--slate-50); color: var(--slate-800);">@tieuChis[i].TenTieuChi</td>
                                        @for (int j = 0; j < n; j++)
                                        {
                                            <td class="font-mono">
                                                @Model.MaTran[i][j].ToString("0.000")
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                            <tfoot style="background: var(--slate-100); font-weight: 700;">
                                <tr>
                                    <td class="text-start">Tổng từng cột:</td>
                                    @for (int j = 0; j < n; j++)
                                    {
                                        <td class="font-mono fs-6" style="color: var(--primary);">
                                            @res.TongCot[j].ToString("0.000")
                                        </td>
                                    }
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Công thức toán học giải trình -->
            <div class="card-custom">
                <div class="card-body-custom p-4">
                    <h6 class="fw-bold mb-3" style="color: var(--slate-900);">
                        <i class="bi bi-journal-text" style="color: var(--primary);"></i> Giải trình công thức kiểm tra tính nhất quán (Consistency Test)
                    </h6>
                    <div class="row g-3 small" style="color: var(--slate-600);">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border h-100" style="background: var(--slate-50); border-color: var(--border-color) !important;">
                                <strong>1. Chỉ số nhất quán CI (Consistency Index):</strong>
                                <div class="my-2 font-mono" style="color: var(--slate-900);">
                                    CI = (&lambda;<sub>max</sub> - n) / (n - 1) = (@res.LambdaMax.ToString("0.0000") - 4) / 3 = <strong>@res.CI.ToString("0.0000")</strong>
                                </div>
                                <small style="color: var(--slate-400);">(Trong đó n = 4 là số lượng tiêu chí đánh giá)</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 border h-100" style="background: var(--slate-50); border-color: var(--border-color) !important;">
                                <strong>2. Tỷ số nhất quán CR (Consistency Ratio):</strong>
                                <div class="my-2 font-mono" style="color: var(--slate-900);">
                                    CR = CI / RI = @res.CI.ToString("0.0000") / 0.90 = <strong>@res.CR.ToString("0.0000")</strong>
                                </div>
                                <small style="color: var(--slate-400);">(Với n = 4, chỉ số ngẫu nhiên Saaty RI = 0.90. Điều kiện đạt: CR &le; 0.10)</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
