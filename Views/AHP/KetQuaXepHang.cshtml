@model code.Models.ViewModels.KetQuaXepHangViewModel
@{
    ViewData["Title"] = "Kết quả xếp hạng & Đề xuất Nhà cung cấp - " + Model.TenKyDanhGia;
    var tieuChis = Model.DanhSachTieuChi;
    var trongSoMap = Model.TrongSos.ToDictionary(t => t.MaTieuChi ?? 0, t => t.TrongSo ?? 0);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]</div>
}

<div class="page-header">
    <div class="page-header-left">
        <div class="d-flex align-items-center gap-2">
            <a asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline" title="Quay lại danh sách kỳ">
                <i class="bi bi-arrow-left"></i>
            </a>
            <div>
                <h3 class="mb-0">Xếp hạng &amp; Đề xuất đối tác cung ứng</h3>
                <p class="mb-0">Kỳ đánh giá: <strong>@Model.TenKyDanhGia</strong> — tổng hợp trọng số AHP &amp; thang điểm WSM</p>
            </div>
        </div>
    </div>
    <div class="d-flex gap-2">
        <button type="button" class="btn btn-custom btn-custom-outline shadow-sm" onclick="window.print()">
            <i class="bi bi-printer me-1"></i> In / Xuất PDF Biên Bản AHP
        </button>
        <a asp-action="ChamDiemNCC" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
            <i class="bi bi-pencil me-1"></i> Chấm điểm lại
        </a>
    </div>
</div>

<!-- KHỐI IN ẤN BIÊN BẢN CHÍNH THỨC (Chỉ hiển thị khi In hoặc Xuất PDF) -->
<div class="d-none d-print-block print-official-header mb-4">
    <div class="row align-items-center text-center pb-3 border-bottom border-dark">
        <div class="col-5 text-start">
            <div class="fw-bold text-uppercase" style="font-size: 13px;">HỘI ĐỒNG ĐÁNH GIÁ NHÀ CUNG CẤP</div>
            <div class="small">PHÒNG THU MUA &amp; QUẢN LÝ KHO VẬN</div>
            <div class="small text-muted font-mono">Số: @Model.MaKyDanhGia/BB-AHP-KHO/@DateTime.Now.Year</div>
        </div>
        <div class="col-7 text-end">
            <div class="fw-bold text-uppercase" style="font-size: 13px;">CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM</div>
            <div class="fw-bold small">Độc lập - Tự do - Hạnh phúc</div>
            <div class="small text-muted fst-italic">TP. Hồ Chí Minh, ngày @DateTime.Now.Day tháng @DateTime.Now.Month năm @DateTime.Now.Year</div>
        </div>
    </div>

    <div class="text-center my-4">
        <h4 class="fw-bold text-uppercase mb-1">BIÊN BẢN XẾP HẠNG &amp; ĐỀ XUẤT ĐỐI TÁC CUNG ỨNG</h4>
        <p class="mb-1"><strong>MÔ HÌNH PHÂN TÍCH THỨ BẬC AHP &amp; PHƯƠNG PHÁP WSM</strong></p>
        <div class="small text-muted">Kỳ đánh giá: <strong>@Model.TenKyDanhGia</strong> | Thời điểm kết xuất: @DateTime.Now.ToString("dd/MM/yyyy HH:mm")</div>
    </div>
</div>

<!-- Nhà cung cấp đề xuất #1 -->
@if (Model.NhaCungCapDeXuat != null)
{
    <div class="mb-4">
        <partial name="_AhpWinnerCard" model="Model.NhaCungCapDeXuat" />
    </div>
}

<!-- Biểu đồ Radar & Trọng số tiêu chí -->
<div class="row g-3 mb-4">
    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-radar text-primary"></i> Radar so sánh đa chiều</h5>
            </div>
            <div class="card-body-custom d-flex justify-content-center align-items-center" style="min-height: 280px;">
                <canvas id="radarChart" style="max-height: 260px; width: 100%;"></canvas>
            </div>
        </div>
    </div>

    <div class="col-lg-6">
        <div class="card-custom h-100">
            <div class="card-header-custom">
                <h5><i class="bi bi-pie-chart text-primary"></i> Trọng số tiêu chí AHP</h5>
            </div>
            <div class="card-body-custom p-0">
                <div class="table-responsive">
                    <table class="table-custom">
                        <thead>
                            <tr>
                                <th>Tiêu chí</th>
                                <th class="text-center">Ký hiệu</th>
                                <th class="text-end">Trọng số (Wi)</th>
                                <th class="text-end">Tỷ trọng</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var tc in tieuChis)
                            {
                                decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                                <tr>
                                    <td class="fw-semibold" style="color: var(--slate-800);">
                                        @tc.TenTieuChi
                                        <span style="color: var(--slate-400); font-size: 12px;">· @(tc.LoaiTieuChi == "cost" ? "Chi phí" : "Lợi ích")</span>
                                    </td>
                                    <td class="text-center font-mono" style="color: var(--slate-500);">C@(tc.MaTieuChi)</td>
                                    <td class="text-end font-mono fw-semibold text-primary">@w.ToString("0.0000")</td>
                                    <td class="text-end font-mono" style="color: var(--slate-800);">@((w * 100).ToString("0.0"))%</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Bảng xếp hạng tổng hợp -->
<div class="card-custom mb-4">
    <div class="card-header-custom">
        <h5><i class="bi bi-table text-primary"></i> Bảng tổng hợp điểm số &amp; thứ hạng đối tác</h5>
    </div>
    <div class="card-body-custom p-0">
        <div class="table-responsive">
            <table class="table-custom text-center">
                <thead>
                    <tr>
                        <th style="width: 80px;">Hạng</th>
                        <th class="text-start" style="min-width: 200px;">Nhà cung cấp</th>
                        @foreach (var tc in tieuChis)
                        {
                            decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                            <th>
                                <div style="color: var(--slate-800); font-weight: 600;">@tc.TenTieuChi</div>
                                <small style="color: var(--slate-400); font-weight: 500;">(W: @w.ToString("0.000"))</small>
                            </th>
                        }
                        <th style="width: 120px;">Điểm WSM</th>
                        <th style="width: 130px;">Đề xuất</th>
                        <th style="width: 80px;"></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model.BangXepHang)
                    {
                        var ncc = item.NhaCungCap;
                        int nccId = item.MaNhaCungCap ?? 0;
                        bool isTop1 = item.XepHang == 1;

                        <tr style="@(isTop1 ? "background: var(--amber-50);" : "")">
                            <td>
                                @if (isTop1)
                                {
                                    <span class="status-badge status-badge-warning"><i class="bi bi-trophy"></i> #1</span>
                                }
                                else
                                {
                                    <span class="fw-semibold" style="color: var(--slate-600);">#@item.XepHang</span>
                                }
                            </td>
                            <td class="text-start">
                                <div class="fw-semibold" style="color: var(--slate-800);">@(ncc?.TenNhaCungCap ?? "N/A")</div>
                                <span class="code-badge">@(ncc?.MaNhaCungCapCode ?? $"NCC{nccId:D3}")</span>
                            </td>
                            @foreach (var tc in tieuChis)
                            {
                                decimal d = 0;
                                if (Model.DiemMap.ContainsKey(nccId) && Model.DiemMap[nccId].ContainsKey(tc.MaTieuChi))
                                {
                                    d = Model.DiemMap[nccId][tc.MaTieuChi];
                                }
                                <td class="font-mono" style="color: var(--slate-600);">@d.ToString("0.0")</td>
                            }
                            <td class="font-mono fw-bold" style="font-size: 15px; color: @(isTop1 ? "var(--amber-700)" : "var(--slate-900)");">
                                @(item.DiemTong?.ToString("0.00") ?? "0.00")
                            </td>
                            <td>
                                @if (item.DeXuat == true)
                                {
                                    <span class="status-badge status-badge-success">Đề xuất chọn</span>
                                }
                                else
                                {
                                    <span style="color: var(--slate-400); font-size: 12.5px;">Dự phòng</span>
                                }
                            </td>
                            <td>
                                <a asp-controller="NhaCungCap" asp-action="Details" asp-route-id="@nccId" class="btn btn-sm btn-outline-secondary" title="Xem hồ sơ đối tác">
                                    <i class="bi bi-box-arrow-up-right"></i>
                                </a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- CHỮ KÝ 3 BÊN KHI IN ẤN BIÊN BẢN (Print Only) -->
<div class="d-none d-print-block print-signatures mt-5 pt-4">
    <div class="row text-center">
        <div class="col-4">
            <div class="fw-bold text-uppercase small">Người Lập Báo Cáo</div>
            <div class="fst-italic text-muted" style="font-size: 11px;">(Ký và ghi rõ họ tên)</div>
            <div style="height: 75px;"></div>
            <div class="fw-bold">@User.Identity?.Name</div>
        </div>
        <div class="col-4">
            <div class="fw-bold text-uppercase small">Trưởng Ban Đánh Giá AHP</div>
            <div class="fst-italic text-muted" style="font-size: 11px;">(Xác nhận ma trận và tỷ số nhất quán)</div>
            <div style="height: 75px;"></div>
            <div class="fw-bold">Tổ Đánh Giá Kỹ Thuật</div>
        </div>
        <div class="col-4">
            <div class="fw-bold text-uppercase small">Giám Đốc Phê Duyệt</div>
            <div class="fst-italic text-muted" style="font-size: 11px;">(Ký tên và phê duyệt quyết định nhập hàng)</div>
            <div style="height: 75px;"></div>
            <div class="fw-bold">Ban Giám Đốc</div>
        </div>
    </div>
</div>

<style>
@@media print {
    .sidebar, .top-header, .page-header .d-flex, #quickSwitcher, .page-footer, .btn, .breadcrumb, form, .public-navbar, .public-footer {
        display: none !important;
    }
    .main-content, .container, body {
        margin: 0 !important;
        padding: 0 !important;
        background: #ffffff !important;
        color: #000000 !important;
        font-size: 11pt !important;
    }
    .card, .card-custom {
        border: 1px solid #999 !important;
        box-shadow: none !important;
        break-inside: avoid;
    }
    .text-white {
        color: #000000 !important;
    }
    .bg-gradient-dark, .bg-primary, .card-header, .card-header-custom {
        background: #f8f9fa !important;
        color: #000000 !important;
    }
}
</style>

@section Scripts {
    @{
        var radarLabels = tieuChis.Select(tc => tc.TenTieuChi).ToList();
        var colors = new[] { "#2563EB", "#64748B", "#059669", "#D97706", "#94A3B8" };
        var bgColors = new[] { "rgba(37, 99, 235, 0.15)", "rgba(100, 116, 139, 0.1)", "rgba(5, 150, 105, 0.1)", "rgba(217, 119, 6, 0.1)", "rgba(148, 163, 184, 0.1)" };

        var radarDatasets = Model.BangXepHang.Take(5).Select((item, idx) => {
            int nccId = item.MaNhaCungCap ?? 0;
            var scores = tieuChis.Select(tc => {
                if (Model.DiemMap.ContainsKey(nccId) && Model.DiemMap[nccId].ContainsKey(tc.MaTieuChi))
                    return (double)Model.DiemMap[nccId][tc.MaTieuChi];
                return 5.0;
            }).ToList();

            var c = colors[idx % colors.Length];
            var bg = bgColors[idx % bgColors.Length];

            return new {
                label = (item.NhaCungCap?.TenNhaCungCap ?? $"NCC #{nccId}") + $" (#{item.XepHang})",
                data = scores,
                borderColor = c,
                backgroundColor = bg,
                borderWidth = (item.XepHang == 1) ? 2.5 : 1.5,
                pointBackgroundColor = c
            };
        }).ToList();
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radarLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(radarLabels));
            const radarDatasets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(radarDatasets));

            const ctx = document.getElementById('radarChart');
            if (ctx && radarLabels && radarLabels.length > 0) {
                new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: radarLabels,
                        datasets: radarDatasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 10,
                                grid: { color: '#E2E8F0' },
                                angleLines: { color: '#E2E8F0' },
                                ticks: { stepSize: 2, font: { family: 'JetBrains Mono', size: 10 }, backdropColor: 'transparent' },
                                pointLabels: { font: { family: "'Be Vietnam Pro', 'Inter', sans-serif", size: 12, weight: '600' }, color: '#334155' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { font: { family: "'Be Vietnam Pro', 'Inter', sans-serif", size: 11 }, boxWidth: 12, padding: 10 }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
