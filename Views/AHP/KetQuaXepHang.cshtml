@model code.Models.ViewModels.KetQuaXepHangViewModel
@{
    ViewData["Title"] = "Kết quả xếp hạng & Đề xuất Nhà cung cấp - " + Model.TenKyDanhGia;
    var deXuat = Model.NhaCungCapDeXuat?.NhaCungCap;
    var tieuChis = Model.DanhSachTieuChi;
    var trongSoMap = Model.TrongSos.ToDictionary(t => t.MaTieuChi ?? 0, t => t.TrongSo ?? 0);
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-md-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
        }

        <!-- Page Header Toolbar -->
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-4">
            <div class="d-flex align-items-center">
                <a asp-action="Index" class="btn btn-custom btn-custom-outline me-3" style="padding: 6px 9px;" title="Quay lại danh sách kỳ">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h3 class="fw-bold mb-0" style="font-size: 18px; color: var(--gray-900);">
                        Xếp hạng & Đề xuất Đối tác Cung ứng
                    </h3>
                    <span style="color: var(--gray-500); font-size: 12.5px;">Kỳ đánh giá: <strong>@Model.TenKyDanhGia</strong></span>
                </div>
            </div>

            <div class="d-flex gap-2">
                <button type="button" class="btn btn-custom btn-custom-outline" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> In báo cáo AHP
                </button>
                <a asp-action="ChamDiemNCC" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
                    <i class="bi bi-pencil me-1"></i> Chấm điểm lại
                </a>
            </div>
        </div>

        <!-- Executive Recommendation Card (Handcrafted Clean) -->
        @if (Model.NhaCungCapDeXuat != null && deXuat != null)
        {
            <div class="spotlight-card mb-4">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="spotlight-tag mb-2">
                            <i class="bi bi-check2-circle"></i> ĐỐI TÁC ĐƯỢC ĐỀ XUẤT #1 (MÔ HÌNH AHP + WSM)
                        </div>
                        <h3 class="fw-bold mb-2" style="font-size: 20px; color: var(--gray-900);">@deXuat.TenNhaCungCap</h3>
                        <p class="mb-3" style="color: var(--gray-500); font-size: 12.5px;">
                            Mã đối tác: <span class="code-badge">@(deXuat.MaNhaCungCapCode ?? $"NCC{deXuat.MaNhaCungCap:D3}")</span> &bull;
                            Người liên hệ: <strong>@(deXuat.NguoiLienHe ?? "—")</strong> &bull;
                            SĐT: <strong>@(deXuat.SoDienThoai ?? "—")</strong> &bull;
                            Địa chỉ: <strong>@(deXuat.DiaChi ?? "—")</strong>
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-accent">
                                <i class="bi bi-plus-circle me-1"></i> Tạo Phiếu Nhập Hàng Từ Đối Tác Này
                            </a>
                            <a asp-controller="NhaCungCap" asp-action="Details" asp-route-id="@deXuat.MaNhaCungCap" class="btn btn-custom btn-custom-outline">
                                Xem hồ sơ đối tác
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end text-center mt-3 mt-md-0">
                        <div class="spotlight-score-box d-inline-block">
                            <div style="font-size: 11px; font-weight: 600; color: var(--gray-500); text-transform: uppercase;">Điểm tổng hợp WSM</div>
                            <div class="spotlight-score-num mt-1">
                                @(Model.NhaCungCapDeXuat.DiemTong?.ToString("0.00") ?? "0.00")
                                <span style="font-size: 13px; color: var(--gray-400); font-weight: 400;">/ 9.00</span>
                            </div>
                            <small style="color: var(--gray-400); font-size: 11px;">Thang điểm chuẩn Saaty</small>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Radar Analysis & Explanation -->
        <div class="row g-4 mb-4">
            <div class="col-lg-6">
                <div class="card-custom h-100">
                    <div class="card-header-custom">
                        <h5>Biểu đồ Radar So sánh 4 Tiêu chí</h5>
                        <span class="status-badge status-badge-secondary">Đa chiều</span>
                    </div>
                    <div class="card-body-custom d-flex justify-content-center" style="min-height: 280px;">
                        <canvas id="radarChart" style="max-height: 260px; max-width: 450px;"></canvas>
                    </div>
                </div>
            </div>

            <div class="col-lg-6">
                <div class="card-custom h-100">
                    <div class="card-header-custom">
                        <h5>Trọng số Tiêu chí phân bổ</h5>
                        <span class="status-badge status-badge-primary">Vector $W_i$</span>
                    </div>
                    <div class="card-body-custom p-0">
                        <div class="table-responsive">
                            <table class="table-custom mb-0">
                                <thead>
                                    <tr>
                                        <th>Tiêu chí</th>
                                        <th class="text-center">Ký hiệu</th>
                                        <th class="text-end">Trọng số ($W_i$)</th>
                                        <th class="text-end">Tỷ trọng</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var tc in tieuChis)
                                    {
                                        decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                                        <tr>
                                            <td class="fw-medium" style="color: var(--gray-900);">@tc.TenTieuChi</td>
                                            <td class="text-center font-mono" style="color: var(--gray-500);">C@(tc.MaTieuChi)</td>
                                            <td class="text-end font-mono fw-semibold" style="color: var(--brand-accent);">@w.ToString("0.000")</td>
                                            <td class="text-end font-mono" style="color: var(--gray-700);">@((w * 100).ToString("0.0"))%</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Bảng Xếp Hạng Toàn Diện -->
        <div class="card-custom mb-4">
            <div class="card-header-custom">
                <h5>Bảng Tổng Hợp Điểm Số & Thứ Hạng Đối Tác</h5>
                <span class="status-badge status-badge-secondary">Toàn diện</span>
            </div>
            <div class="card-body-custom p-0">
                <div class="table-responsive">
                    <table class="table-custom text-center mb-0">
                        <thead>
                            <tr>
                                <th style="width: 80px;">Thứ hạng</th>
                                <th class="text-start" style="min-width: 200px;">Nhà cung cấp</th>
                                @foreach (var tc in tieuChis)
                                {
                                    decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                                    <th>
                                        <div style="color: var(--gray-800); font-weight: 600;">@tc.TenTieuChi</div>
                                        <small style="color: var(--gray-400); font-weight: 400;">(W: @w.ToString("0.000"))</small>
                                    </th>
                                }
                                <th style="width: 150px;">Điểm tổng hợp (WSM)</th>
                                <th style="width: 120px;">Đề xuất</th>
                                <th style="width: 90px;">Hồ sơ</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BangXepHang)
                            {
                                var ncc = item.NhaCungCap;
                                int nccId = item.MaNhaCungCap ?? 0;
                                bool isTop1 = item.XepHang == 1;

                                <tr>
                                    <td>
                                        @if (isTop1)
                                        {
                                            <span class="status-badge status-badge-success fw-bold">
                                                #1
                                            </span>
                                        }
                                        else if (item.XepHang == 2)
                                        {
                                            <span class="status-badge status-badge-secondary">#2</span>
                                        }
                                        else if (item.XepHang == 3)
                                        {
                                            <span class="status-badge status-badge-secondary">#3</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-badge-secondary">#@item.XepHang</span>
                                        }
                                    </td>
                                    <td class="text-start">
                                        <div class="fw-semibold" style="color: var(--gray-900);">@(ncc?.TenNhaCungCap ?? "N/A")</div>
                                        <span class="code-badge">@(ncc?.MaNhaCungCapCode ?? $"NCC{nccId:D3}")</span>
                                    </td>
                                    @foreach (var tc in tieuChis)
                                    {
                                        decimal d = 0;
                                        if (Model.DiemMap.ContainsKey(nccId) && Model.DiemMap[nccId].ContainsKey(tc.MaTieuChi))
                                        {
                                            d = Model.DiemMap[nccId][tc.MaTieuChi];
                                        }
                                        <td class="font-mono" style="color: var(--gray-600);">
                                            @d.ToString("0.0")
                                        </td>
                                    }
                                    <td class="font-mono fw-bold fs-6" style="color: var(--gray-900);">
                                        @(item.DiemTong?.ToString("0.00") ?? "0.00")
                                    </td>
                                    <td>
                                        @if (item.DeXuat == true)
                                        {
                                            <span class="status-badge status-badge-success">
                                                Được chọn
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--gray-400); font-size: 12px;">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="NhaCungCap" asp-action="Details" asp-route-id="@nccId" class="btn btn-sm btn-custom btn-custom-outline" title="Xem hồ sơ đối tác">
                                            <i class="bi bi-arrow-up-right"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        var radarLabels = tieuChis.Select(tc => tc.TenTieuChi).ToList();
        var colors = new[] { "#2563EB", "#64748B", "#059669", "#D97706", "#94A3B8" };
        var bgColors = new[] { "rgba(37, 99, 235, 0.12)", "rgba(100, 116, 139, 0.08)", "rgba(5, 150, 105, 0.08)", "rgba(217, 119, 6, 0.08)", "rgba(148, 163, 184, 0.08)" };

        var radarDatasets = Model.BangXepHang.Take(5).Select((item, idx) => {
            int nccId = item.MaNhaCungCap ?? 0;
            var scores = tieuChis.Select(tc => {
                if (Model.DiemMap.ContainsKey(nccId) && Model.DiemMap[nccId].ContainsKey(tc.MaTieuChi))
                    return (double)Model.DiemMap[nccId][tc.MaTieuChi];
                return 5.0;
            }).ToList();

            var c = colors[idx % colors.Length];
            var bg = bgColors[idx % bgColors.Length];

            return new {
                label = (item.NhaCungCap?.TenNhaCungCap ?? $"NCC #{nccId}") + $" (#{item.XepHang})",
                data = scores,
                borderColor = c,
                backgroundColor = bg,
                borderWidth = (item.XepHang == 1) ? 2.5 : 1.5,
                pointBackgroundColor = c
            };
        }).ToList();
    }
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const radarLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(radarLabels));
            const radarDatasets = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(radarDatasets));

            const ctx = document.getElementById('radarChart');
            if (ctx && radarLabels && radarLabels.length > 0) {
                new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: radarLabels,
                        datasets: radarDatasets
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 10,
                                grid: { color: '#E2E8F0' },
                                angleLines: { color: '#E2E8F0' },
                                ticks: { stepSize: 2, font: { family: 'JetBrains Mono', size: 9 }, backdropColor: 'transparent' },
                                pointLabels: { font: { family: 'Inter', size: 11, weight: '500' }, color: '#334155' }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { font: { family: 'Inter', size: 11 }, boxWidth: 10, padding: 8 }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
