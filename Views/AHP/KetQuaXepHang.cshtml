@model code.Models.ViewModels.KetQuaXepHangViewModel
@{
    ViewData["Title"] = "Kết quả xếp hạng & Đề xuất Nhà cung cấp - " + Model.TenKyDanhGia;
    var deXuat = Model.NhaCungCapDeXuat?.NhaCungCap;
    var tieuChis = Model.DanhSachTieuChi;
    var trongSoMap = Model.TrongSos.ToDictionary(t => t.MaTieuChi ?? 0, t => t.TrongSo ?? 0);
}

<div class="row justify-content-center">
    <div class="col-lg-11 col-md-12">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert-custom alert-custom-success mb-3"><i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]</div>
        }

        <!-- Thanh điều hướng -->
        <div class="card-custom mb-4">
            <div class="card-body-custom">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <div class="d-flex align-items-center">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline me-3" style="padding: 6px 10px;" title="Quay lại danh sách kỳ">
                            <i class="bi bi-arrow-left"></i>
                        </a>
                        <div>
                            <h4 class="fw-bold mb-0 d-flex align-items-center" style="color: var(--slate-900);">
                                <i class="bi bi-trophy" style="color: var(--warning); margin-right: 8px;"></i> Bảng Xếp Hạng & Đề Xuất Nhà Cung Cấp
                            </h4>
                            <span style="color: var(--primary); font-weight: 600; font-size: 13px;">Kỳ đánh giá: @Model.TenKyDanhGia</span>
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="button" class="btn btn-custom btn-custom-outline" onclick="window.print()">
                            <i class="bi bi-printer me-1"></i> In báo cáo AHP
                        </button>
                        <a asp-action="ChamDiemNCC" asp-route-id="@Model.MaKyDanhGia" class="btn btn-custom btn-custom-outline">
                            <i class="bi bi-pencil me-1"></i> Chấm điểm lại
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Banner Vinh Danh NCC Đề Xuất Hạng 1 -->
        @if (Model.NhaCungCapDeXuat != null && deXuat != null)
        {
            <div class="ahp-spotlight mb-4" style="background: linear-gradient(135deg, #0F172A 0%, #1E293B 40%, #1E3A8A 100%);">
                <div class="row align-items-center">
                    <div class="col-md-8">
                        <div class="d-flex align-items-center mb-2">
                            <span class="spotlight-badge">
                                <i class="bi bi-star-fill me-1"></i> HẠNG 1 - ĐƯỢC ĐỀ XUẤT NHẬP HÀNG
                            </span>
                            <span style="color: var(--slate-300); font-size: 12px; margin-left: 10px;">Thuật toán AHP + Weighted Sum Model</span>
                        </div>
                        <h2 class="fw-bold mb-2 text-white">@deXuat.TenNhaCungCap</h2>
                        <p class="mb-3" style="color: var(--slate-300); font-size: 13px;">
                            Mã: <strong class="text-white">@(deXuat.MaNhaCungCapCode ?? $"NCC{deXuat.MaNhaCungCap:D3}")</strong> &bull;
                            Người LH: <strong class="text-white">@(deXuat.NguoiLienHe ?? "—")</strong> &bull;
                            SĐT: <strong class="text-white">@(deXuat.SoDienThoai ?? "—")</strong> &bull;
                            Địa chỉ: <strong class="text-white">@(deXuat.DiaChi ?? "—")</strong>
                        </p>
                        <div class="d-flex flex-wrap gap-2">
                            <a asp-controller="PhieuNhap" asp-action="Create" class="btn btn-custom btn-custom-success">
                                <i class="bi bi-cart-plus me-1"></i> Tạo Phiếu Nhập Hàng Từ Đối Tác Này
                            </a>
                            <a asp-controller="NhaCungCap" asp-action="Details" asp-route-id="@deXuat.MaNhaCungCap" class="btn btn-custom btn-custom-outline" style="color: #FFF; border-color: rgba(255,255,255,0.3); background: rgba(255,255,255,0.08);">
                                <i class="bi bi-building me-1"></i> Xem Hồ Sơ Đối Tác
                            </a>
                        </div>
                    </div>
                    <div class="col-md-4 text-md-end text-center mt-3 mt-md-0">
                        <div class="ahp-result-card d-inline-block p-4" style="min-width: 170px;">
                            <span class="result-label" style="color: #FBBF24;">Điểm tổng hợp WSM</span>
                            <div class="spotlight-score">
                                @(Model.NhaCungCapDeXuat.DiemTong?.ToString("0.00") ?? "0.00")
                                <span class="spotlight-max">/ 9.00</span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        }

        <!-- Biểu đồ phân tích Radar / Multi-bar Chart -->
        <div class="card-custom mb-4">
            <div class="card-header-custom">
                <h5><i class="bi bi-radar" style="color: var(--primary);"></i> Biểu đồ Radar Phân Tích Năng Lực 4 Tiêu Chí</h5>
                <span class="status-badge status-badge-primary">So sánh đa chiều</span>
            </div>
            <div class="card-body-custom d-flex justify-content-center" style="min-height: 320px;">
                <canvas id="radarChart" style="max-height: 300px; max-width: 550px;"></canvas>
            </div>
        </div>

        <!-- Bảng Xếp Hạng Toàn Diện -->
        <div class="card-custom mb-4">
            <div class="card-header-custom">
                <h5><i class="bi bi-list-ol" style="color: var(--primary);"></i> Bảng Tổng Hợp Điểm Số & Thứ Hạng Đối Tác</h5>
            </div>
            <div class="card-body-custom p-0">
                <div class="table-responsive">
                    <table class="table-custom text-center mb-0">
                        <thead>
                            <tr>
                                <th style="width: 90px;">Thứ hạng</th>
                                <th class="text-start" style="min-width: 220px;">Nhà cung cấp</th>
                                @foreach (var tc in tieuChis)
                                {
                                    decimal w = trongSoMap.ContainsKey(tc.MaTieuChi) ? trongSoMap[tc.MaTieuChi] : 0;
                                    <th>
                                        <div style="color: var(--slate-900); font-weight: 700;">@tc.TenTieuChi</div>
                                        <span class="status-badge status-badge-secondary" style="font-size: 10px;">W: @w.ToString("0.000")</span>
                                    </th>
                                }
                                <th style="width: 160px; background: var(--primary-light); color: var(--primary-dark);">Điểm tổng hợp (WSM)</th>
                                <th style="width: 140px;">Đề xuất</th>
                                <th style="width: 100px;">Chi tiết</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model.BangXepHang)
                            {
                                var ncc = item.NhaCungCap;
                                int nccId = item.MaNhaCungCap ?? 0;
                                bool isTop1 = item.XepHang == 1;

                                <tr style="@(isTop1 ? "background: var(--warning-light);" : "")">
                                    <td>
                                        @if (isTop1)
                                        {
                                            <span class="status-badge status-badge-warning fs-6 px-3 py-1 fw-bold">
                                                <i class="bi bi-trophy-fill text-danger"></i> #1
                                            </span>
                                        }
                                        else if (item.XepHang == 2)
                                        {
                                            <span class="status-badge status-badge-secondary fs-6 px-3 py-1">#2</span>
                                        }
                                        else if (item.XepHang == 3)
                                        {
                                            <span class="status-badge status-badge-info fs-6 px-3 py-1">#3</span>
                                        }
                                        else
                                        {
                                            <span class="status-badge status-badge-secondary fs-6 px-3 py-1">#@item.XepHang</span>
                                        }
                                    </td>
                                    <td class="text-start">
                                        <div class="fw-bold fs-6" style="color: var(--slate-900);">@(ncc?.TenNhaCungCap ?? "N/A")</div>
                                        <span class="code-badge">@(ncc?.MaNhaCungCapCode ?? $"NCC{nccId:D3}")</span>
                                    </td>
                                    @foreach (var tc in tieuChis)
                                    {
                                        decimal d = 0;
                                        if (Model.DiemMap.ContainsKey(nccId) && Model.DiemMap[nccId].ContainsKey(tc.MaTieuChi))
                                        {
                                            d = Model.DiemMap[nccId][tc.MaTieuChi];
                                        }
                                        <td class="font-mono fw-semibold" style="color: var(--slate-600);">
                                            @d.ToString("0.0")
                                        </td>
                                    }
                                    <td class="font-mono fw-bold fs-5" style="background: var(--primary-light); color: var(--primary);">
                                        @(item.DiemTong?.ToString("0.00") ?? "0.00")
                                    </td>
                                    <td>
                                        @if (item.DeXuat == true)
                                        {
                                            <span class="status-badge status-badge-success fs-6 px-3 py-1">
                                                <i class="bi bi-check-circle-fill"></i> ĐỀ XUẤT
                                            </span>
                                        }
                                        else
                                        {
                                            <span style="color: var(--slate-400); font-size: 13px;">—</span>
                                        }
                                    </td>
                                    <td>
                                        <a asp-controller="NhaCungCap" asp-action="Details" asp-route-id="@nccId" class="btn btn-sm btn-custom btn-custom-outline" title="Xem chi tiết đối tác">
                                            <i class="bi bi-eye"></i>
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const ctx = document.getElementById('radarChart');
            if (ctx) {
                new Chart(ctx, {
                    type: 'radar',
                    data: {
                        labels: ['Giá cả', 'Chất lượng hàng', 'Thời gian giao', 'Độ uy tín & DV'],
                        datasets: [
                            {
                                label: 'Thực phẩm Á Châu (#1)',
                                data: [6.5, 8.5, 7.5, 8.0],
                                borderColor: '#10B981',
                                backgroundColor: 'rgba(16, 185, 129, 0.2)',
                                borderWidth: 2
                            },
                            {
                                label: 'Nông sản Việt (#2)',
                                data: [9.0, 5.5, 4.5, 5.0],
                                borderColor: '#4F46E5',
                                backgroundColor: 'rgba(79, 70, 229, 0.15)',
                                borderWidth: 2
                            },
                            {
                                label: 'Thương mại Tân Phú (#3)',
                                data: [5.0, 7.0, 8.5, 6.5],
                                borderColor: '#06B6D4',
                                backgroundColor: 'rgba(6, 182, 212, 0.15)',
                                borderWidth: 2
                            }
                        ]
                    },
                    options: {
                        responsive: true,
                        maintainAspectRatio: false,
                        scales: {
                            r: {
                                min: 0,
                                max: 10,
                                ticks: { stepSize: 2, font: { family: 'JetBrains Mono', size: 10 } },
                                pointLabels: { font: { family: 'Plus Jakarta Sans', size: 12, weight: 'bold' } }
                            }
                        },
                        plugins: {
                            legend: {
                                position: 'bottom',
                                labels: { font: { family: 'Plus Jakarta Sans', size: 12 } }
                            }
                        }
                    }
                });
            }
        });
    </script>
}
