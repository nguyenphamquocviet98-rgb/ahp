@model List<code.Models.DoanhNghiep>
@{
    ViewData["Title"] = "Quản lý Doanh nghiệp NPP";
    var search = ViewBag.Search as string;
    var trangThaiMall = ViewBag.TrangThaiMall as string;
}

<div class="page-header d-flex flex-wrap justify-content-between align-items-center mb-4 gap-3">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted">Hệ thống</a></li>
                <li class="breadcrumb-item active text-primary fw-semibold" aria-current="page">Quản lý Doanh nghiệp</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-1 text-dark d-flex align-items-center gap-2">
            <span>Mạng Lưới Nhà Phân Phối (NPP)</span>
            <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-3 py-1 fs-6">
                <i class="bi bi-building-gear me-1"></i> ĐỐI TÁC SÀN
            </span>
        </h3>
        <p class="text-muted mb-0 small">Xét duyệt gian hàng Mall, theo dõi chỉ số uy tín và quản lý thông tin các Nhà phân phối trên sàn B2B.</p>
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show rounded-3 shadow-sm border-0" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- 3 Thẻ Thống Kê NPP (Tone Xanh Trắng) -->
<div class="row g-3 mb-4">
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold text-muted text-uppercase" style="font-size: 11.5px;">Tổng Doanh Nghiệp</span>
                <div class="p-2 rounded-3" style="background-color: #EFF6FF; color: #1E60D5;">
                    <i class="bi bi-buildings fs-5"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-dark font-mono my-1">@ViewBag.TongDN</div>
            <div class="small text-muted">Doanh nghiệp đã đăng ký tham gia</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold text-muted text-uppercase" style="font-size: 11.5px;">Gian Hàng Mall</span>
                <div class="p-2 rounded-3" style="background-color: #FFF1F2; color: #E11D48;">
                    <i class="bi bi-patch-check-fill fs-5"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-danger font-mono my-1">@ViewBag.TongMall</div>
            <div class="small text-muted">Được cấp chứng nhận chính hãng</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
            <div class="d-flex justify-content-between align-items-center mb-1">
                <span class="small fw-bold text-muted text-uppercase" style="font-size: 11.5px;">Chờ Duyệt Mall</span>
                <div class="p-2 rounded-3" style="background-color: #FFFBEB; color: #D97706;">
                    <i class="bi bi-hourglass-split fs-5"></i>
                </div>
            </div>
            <div class="fs-3 fw-bold text-warning font-mono my-1">@ViewBag.TongDangKyMall</div>
            <div class="small text-muted">Yêu cầu nâng cấp đang chờ xử lý</div>
        </div>
    </div>
</div>

<!-- Bộ lọc tìm kiếm -->
<div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
    <div class="card-body p-3">
        <form method="get" class="row g-2 align-items-center">
            <div class="col-md-6">
                <div class="input-group">
                    <span class="input-group-text bg-transparent border-end-0 text-muted"><i class="bi bi-search"></i></span>
                    <input type="text" name="search" value="@search" class="form-control border-start-0 ps-0" placeholder="Tìm theo tên doanh nghiệp, mã số thuế, email, địa chỉ..." />
                </div>
            </div>
            <div class="col-md-3">
                <select name="trangThaiMall" class="form-select">
                    <option value="">-- Tất cả phân hạng --</option>
                    <option value="mall" selected="@(trangThaiMall == "mall")">🏅 Gian Hàng Mall</option>
                    <option value="dangky" selected="@(trangThaiMall == "dangky")">⏳ Chờ duyệt Mall</option>
                    <option value="thuong" selected="@(trangThaiMall == "thuong")">Gian hàng thường</option>
                </select>
            </div>
            <div class="col-md-3 d-flex gap-2">
                <button type="submit" class="btn btn-primary flex-grow-1"><i class="bi bi-funnel me-1"></i>Lọc</button>
                @if (!string.IsNullOrEmpty(search) || !string.IsNullOrEmpty(trangThaiMall))
                {
                    <a asp-action="Index" class="btn btn-outline-secondary" title="Đặt lại bộ lọc"><i class="bi bi-arrow-counterclockwise"></i></a>
                }
            </div>
        </form>
    </div>
</div>

<!-- Bảng danh sách Doanh nghiệp -->
<div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead>
                <tr>
                    <th style="width: 50px;" class="ps-3 text-center">STT</th>
                    <th>Doanh nghiệp NPP</th>
                    <th>Liên hệ</th>
                    <th class="text-center">Phân hạng</th>
                    <th class="text-center">Điểm Uy tín</th>
                    <th class="text-center">Trạng thái</th>
                    <th class="text-center pe-3" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @{
                    var stt = 0;
                }
                @if (Model != null && Model.Any())
                {
                    @foreach (var dn in Model)
                    {
                        stt++;
                        <tr>
                            <td class="ps-3 text-center text-muted font-mono small">@stt</td>
                            <td>
                                <div class="d-flex align-items-center gap-3">
                                    <div class="rounded-circle d-flex align-items-center justify-content-center fw-bold flex-shrink-0"
                                         style="width: 40px; height: 40px; background-color: #EFF6FF; color: #1E60D5; font-size: 15px;">
                                        @(string.IsNullOrEmpty(dn.TenDoanhNghiep) ? "D" : dn.TenDoanhNghiep[0].ToString().ToUpper())
                                    </div>
                                    <div>
                                        <div class="fw-semibold text-dark d-flex align-items-center gap-2">
                                            <span>@dn.TenDoanhNghiep</span>
                                            @if (dn.LaGianHangMall)
                                            {
                                                <span class="badge bg-danger text-white px-2 py-0" style="font-size: 10px;">
                                                    <i class="bi bi-patch-check-fill me-1"></i>MALL
                                                </span>
                                            }
                                        </div>
                                        <div class="text-muted small">
                                            <span class="font-mono">MST: @(dn.MaSoThue ?? "—")</span>
                                            @if (!string.IsNullOrEmpty(dn.DiaChi))
                                            {
                                                <span> · @dn.DiaChi</span>
                                            }
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div class="small text-dark"><i class="bi bi-telephone text-muted me-1"></i>@(dn.SoDienThoai ?? "—")</div>
                                <div class="small text-muted"><i class="bi bi-envelope text-muted me-1"></i>@(dn.Email ?? "—")</div>
                            </td>
                            <td class="text-center">
                                @if (dn.TrangThaiMall == "mall")
                                {
                                    <span class="badge bg-danger-subtle text-danger"><i class="bi bi-patch-check-fill me-1"></i>Mall</span>
                                }
                                else if (dn.TrangThaiMall == "dangky")
                                {
                                    <span class="badge bg-warning-subtle text-dark"><i class="bi bi-hourglass-split me-1"></i>Chờ duyệt</span>
                                }
                                else
                                {
                                    <span class="badge bg-light text-muted border">Thường</span>
                                }
                            </td>
                            <td class="text-center">
                                <span class="fw-bold font-mono @(dn.DiemUyTin >= 7 ? "text-success" : dn.DiemUyTin >= 5 ? "text-warning" : "text-danger")">
                                    ⭐ @dn.DiemUyTin.ToString("0.0")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (dn.TrangThai)
                                {
                                    <span class="badge bg-success-subtle text-success">
                                        <i class="bi bi-dot"></i>Hoạt động
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-danger-subtle text-danger">
                                        <i class="bi bi-lock-fill me-1"></i>Đã khóa
                                    </span>
                                }
                            </td>
                            <td class="text-center pe-3">
                                <div class="btn-group btn-group-sm">
                                    <a asp-action="Details" asp-route-id="@dn.MaDoanhNghiep" class="btn btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@dn.MaDoanhNghiep" class="btn btn-outline-secondary" title="Chỉnh sửa">
                                        <i class="bi bi-pencil"></i>
                                    </a>
                                    @if (dn.TrangThaiMall == "dangky")
                                    {
                                        <form asp-action="DuyetMall" asp-route-id="@dn.MaDoanhNghiep" method="post" class="d-inline">
                                            <input type="hidden" name="approve" value="true" />
                                            <button type="submit" class="btn btn-success" title="Duyệt Mall ngay"
                                                    onclick="return confirm('Xác nhận cấp chứng nhận Gian Hàng Mall cho @dn.TenDoanhNghiep?')">
                                                <i class="bi bi-check-lg"></i>
                                            </button>
                                        </form>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-2 text-muted d-block mb-2"></i>
                            Không tìm thấy doanh nghiệp nào phù hợp.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
