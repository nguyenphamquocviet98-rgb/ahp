@model code.Models.DoanhNghiep

@{
    ViewData["Title"] = "Chỉnh sửa Doanh nghiệp - " + Model.TenDoanhNghiep;
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1 small text-muted">
                <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Quản lý Doanh nghiệp</a></li>
                <li class="breadcrumb-item active" aria-current="page">Chỉnh sửa</li>
            </ol>
        </nav>
        <h3 class="fw-bold mb-0" style="color: var(--slate-900);">
            <i class="bi bi-pencil-square text-primary me-2"></i>Chỉnh sửa thông tin Doanh nghiệp
        </h3>
    </div>
    <div>
        <a asp-action="Details" asp-route-id="@Model.MaDoanhNghiep" class="btn btn-outline-secondary px-3">
            <i class="bi bi-eye me-1"></i> Xem chi tiết
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm mb-4" style="border-radius: var(--radius-lg);">
            <div class="card-header bg-white border-bottom py-3 px-4">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle px-2 py-1">DN-@Model.MaDoanhNghiep.ToString("D3")</span>
                    <span class="fw-bold text-dark fs-6">Hồ sơ pháp lý & Cấu hình sàn</span>
                </div>
            </div>
            <div class="card-body p-4">
                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaDoanhNghiep" />

                    <div class="mb-3">
                        <label asp-for="TenDoanhNghiep" class="form-label fw-bold text-dark">
                            Tên doanh nghiệp / Nhà phân phối <span class="text-danger">*</span>
                        </label>
                        <input asp-for="TenDoanhNghiep" class="form-control" placeholder="Ví dụ: NPP Thực phẩm Sạch Miền Nam..." required />
                        <span asp-validation-for="TenDoanhNghiep" class="text-danger small"></span>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="MaSoThue" class="form-label fw-semibold text-dark">Mã số thuế</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-hash"></i></span>
                                <input asp-for="MaSoThue" class="form-control font-mono" placeholder="0312345678" />
                            </div>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="SoDienThoai" class="form-label fw-semibold text-dark">Số điện thoại liên hệ</label>
                            <div class="input-group">
                                <span class="input-group-text bg-light text-muted"><i class="bi bi-telephone"></i></span>
                                <input asp-for="SoDienThoai" class="form-control" placeholder="0901234567" />
                            </div>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold text-dark">Email liên hệ / Hóa đơn</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control" placeholder="contact@doanhnghiep.vn" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label fw-semibold text-dark">Địa chỉ trụ sở / Tổng kho</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light text-muted"><i class="bi bi-geo-alt"></i></span>
                            <input asp-for="DiaChi" class="form-control" placeholder="Số nhà, đường, quận/huyện, tỉnh/thành phố" />
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="MoTa" class="form-label fw-semibold text-dark">Mô tả năng lực cung ứng / Giới thiệu</label>
                        <textarea asp-for="MoTa" class="form-control" rows="3" placeholder="Giới thiệu quy mô, ngành hàng chủ lực, chính sách chiết khấu..."></textarea>
                    </div>

                    <div class="p-3 bg-light rounded-3 mb-4 border">
                        <div class="form-check form-switch mb-0">
                            <input class="form-check-input" type="checkbox" role="switch" asp-for="TrangThai" id="trangThaiSwitch">
                            <label class="form-check-label fw-bold text-dark" for="trangThaiSwitch">
                                Kích hoạt tài khoản & Hoạt động giao thương trên sàn
                            </label>
                            <small class="text-muted d-block mt-1">Khi tắt, doanh nghiệp sẽ bị tạm khóa các giao dịch chào sỉ và đặt hàng B2B.</small>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                        <a asp-action="Index" class="btn btn-light px-4 border">Hủy bỏ</a>
                        <button type="submit" class="btn btn-primary px-4 shadow-sm">
                            <i class="bi bi-check2-circle me-1"></i> Lưu thay đổi
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
