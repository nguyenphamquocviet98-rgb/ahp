@{
    ViewData["Title"] = "Đăng Ký Banner Tài Trợ Trang Nhất";
}

<div class="page-header d-flex justify-content-between align-items-center mb-4">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a asp-action="Index">Quảng cáo Banner</a></li>
                <li class="breadcrumb-item active" aria-current="page">Đăng ký mới</li>
            </ol>
        </nav>
        <h2 class="page-title">Đăng Ký Đặt Banner Tài Trợ Trang Nhất Sàn B2B</h2>
        <p class="text-muted mb-0 small">Xuất hiện ngay đầu trang Chợ Sỉ B2B để gia tăng đơn hàng và tiếp cận các đại lý mua sỉ lớn.</p>
    </div>
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i> Quay lại
        </a>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card shadow-sm border-0 rounded-4">
            <div class="card-body p-4 p-md-5">
                <form asp-action="DangKy" method="post">
                    @Html.AntiForgeryToken()

                    <div class="mb-4">
                        <label class="form-label fw-bold fs-6">
                            Tiêu đề chiến dịch / Thông điệp quảng cáo <span class="text-danger">*</span>
                        </label>
                        <input type="text" name="tieuDe" class="form-control form-control-lg"
                               placeholder="Ví dụ: Giảm giá sỉ 15% cho đơn hàng đầu tiên - Giao nhanh 24h" required />
                        <small class="text-muted">Tiêu đề sẽ hiển thị nổi bật trên thanh trượt Banner trang nhất Chợ Sỉ B2B.</small>
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold">Đường dẫn liên kết khi khách bấm vào Banner</label>
                        <input type="text" name="lienKet" class="form-control"
                               placeholder="/SanB2B?search=Tên_Sản_Phẩm (hoặc để trống để dẫn về gian hàng của bạn)" />
                    </div>

                    <div class="mb-4">
                        <label class="form-label fw-bold fs-6">Chọn gói thời gian tài trợ <span class="text-danger">*</span></label>
                        <div class="row g-3">
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded-3 text-center h-100 gói-qc">
                                    <input class="form-check-input d-none" type="radio" name="thoiHanTuan" id="goi1" value="1" checked onchange="capNhatGia(1000000)">
                                    <label class="form-check-label w-100 cursor-pointer" for="goi1">
                                        <div class="fw-bold mb-1">Gói 1 Tuần</div>
                                        <div class="fs-4 fw-bold text-primary mb-1">1.000.000 đ</div>
                                        <small class="text-muted">Thích hợp xả kho nhanh</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded-3 text-center h-100 gói-qc border-primary bg-primary-subtle">
                                    <input class="form-check-input d-none" type="radio" name="thoiHanTuan" id="goi2" value="2" onchange="capNhatGia(1800000)">
                                    <label class="form-check-label w-100 cursor-pointer" for="goi2">
                                        <div class="fw-bold mb-1">Gói 2 Tuần <span class="badge bg-danger small ms-1">Tiết kiệm</span></div>
                                        <div class="fs-4 fw-bold text-primary mb-1">1.800.000 đ</div>
                                        <small class="text-muted">900.000 đ/tuần</small>
                                    </label>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-check p-3 border rounded-3 text-center h-100 gói-qc">
                                    <input class="form-check-input d-none" type="radio" name="thoiHanTuan" id="goi4" value="4" onchange="capNhatGia(3000000)">
                                    <label class="form-check-label w-100 cursor-pointer" for="goi4">
                                        <div class="fw-bold mb-1">Gói 1 Tháng ⭐</div>
                                        <div class="fs-4 fw-bold text-primary mb-1">3.000.000 đ</div>
                                        <small class="text-muted">Hiệu quả phủ sóng tối đa</small>
                                    </label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Hộp hiển thị chi phí dự kiến -->
                    <div class="d-flex justify-content-between align-items-center p-4 bg-light rounded-4 mb-4 border">
                        <div>
                            <span class="text-secondary fw-bold d-block">Tổng phí tài trợ quảng cáo:</span>
                            <small class="text-muted">Khoản phí sẽ được cộng vào doanh thu vận hành sàn của Admin</small>
                        </div>
                        <div class="fs-3 fw-bold text-danger" id="hienThiTongTien">
                            1.000.000 đ
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-light px-4 py-2 rounded-3">Hủy</a>
                        <button type="submit" class="btn btn-warning btn-lg px-5 py-2 fw-bold rounded-3 shadow">
                            <i class="bi bi-credit-card me-1"></i> Xác Nhận Đăng Ký Banner
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<script>
    function capNhatGia(soTien) {
        document.getElementById('hienThiTongTien').textContent = soTien.toLocaleString('vi-VN') + ' đ';
        document.querySelectorAll('.gói-qc').forEach(el => {
            el.classList.remove('border-primary', 'bg-primary-subtle');
        });
        event.currentTarget.closest('.gói-qc').classList.add('border-primary', 'bg-primary-subtle');
    }
</script>
