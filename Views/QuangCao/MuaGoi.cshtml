@model code.Models.DoanhNghiep

@{
    ViewData["Title"] = "Gói Gian Hàng Mall & Dịch Vụ Quảng Cáo";
    var dn = ViewBag.DoanhNghiep as code.Models.DoanhNghiep ?? Model;
    bool isAdmin = ViewBag.IsAdmin ?? false;
    var lichSuGiaoDich = ViewBag.LichSuGiaoDich as List<code.Models.DoanhThuSan> ?? new List<code.Models.DoanhThuSan>();
    var myBanners = ViewBag.MyBanners as List<code.Models.QuangCaoBanner> ?? new List<code.Models.QuangCaoBanner>();

    bool isMall = dn != null && dn.LaGianHangMall;
    int daysRemaining = 0;
    if (isMall && dn?.HanMall.HasValue == true)
    {
        daysRemaining = Math.Max(0, (dn.HanMall.Value - DateTime.Now).Days);
    }
}

<div class="container-fluid px-lg-4 py-3">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb mb-0 small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none text-muted"><i class="bi bi-house-door me-1"></i>Trang chủ</a></li>
            <li class="breadcrumb-item"><a asp-controller="SanB2B" asp-action="Index" class="text-decoration-none text-muted">Sàn B2B</a></li>
            <li class="breadcrumb-item active text-dark fw-semibold" aria-current="page">Gói Mall & Dịch Vụ Sàn</li>
        </ol>
    </nav>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 d-flex align-items-center gap-2 p-3" role="alert">
            <i class="bi bi-check-circle-fill fs-5 text-success"></i>
            <div>@TempData["SuccessMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show rounded-4 shadow-sm border-0 mb-4 d-flex align-items-center gap-2 p-3" role="alert">
            <i class="bi bi-exclamation-triangle-fill fs-5 text-danger"></i>
            <div>@TempData["ErrorMessage"]</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Header & Trạng Thái Doanh Nghiệp Hiện Tại -->
    <div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden" 
         style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #1e3a8a 100%);">
        <div class="card-body p-4 p-md-5 text-white position-relative">
            <div class="row align-items-center g-4">
                <div class="col-lg-8">
                    <div class="d-inline-flex align-items-center gap-2 px-3 py-1 rounded-pill bg-white bg-opacity-10 border border-white border-opacity-20 mb-3 backdrop-blur">
                        <span class="badge bg-warning text-dark fw-bold" style="font-size: 11px;">B2B PREMIUM SERVICES</span>
                        <span class="small text-white-50">Dịch Vụ Gia Tăng Cho Nhà Phân Phối</span>
                    </div>

                    <h1 class="display-6 fw-bold mb-2 text-white">
                        Trung Tâm Gói Mall & Quảng Cáo B2B
                    </h1>
                    <p class="text-white-50 lead fs-6 mb-4" style="max-width: 680px; line-height: 1.6;">
                        Nâng tầm thương hiệu phân phối, xác thực nguồn hàng chính hãng, tăng gấp 3 lần tiếp cận đại lý mua buôn và được <strong>cộng +1.0 điểm uy tín trong mô hình chấm điểm nhà cung cấp AHP</strong>.
                    </p>

                    <!-- Widget Trạng Thái Gian Hàng -->
                    <div class="p-3 rounded-3 bg-white bg-opacity-10 border border-white border-opacity-15 d-inline-flex flex-wrap align-items-center gap-3">
                        <div class="d-flex align-items-center gap-2">
                            <div class="rounded-circle p-2 bg-white bg-opacity-20 text-warning fs-5 lh-1">
                                <i class="bi bi-building-check"></i>
                            </div>
                            <div>
                                <div class="small text-white-50" style="font-size: 11px;">Doanh nghiệp của bạn</div>
                                <div class="fw-bold text-white fs-6">@(dn?.TenDoanhNghiep ?? "Doanh nghiệp NPP")</div>
                            </div>
                        </div>

                        <div class="border-start border-white border-opacity-20 ps-3">
                            <div class="small text-white-50" style="font-size: 11px;">Cấp bậc gian hàng</div>
                            <div>
                                @if (isMall)
                                {
                                    <span class="badge bg-danger fw-bold px-2 py-1">
                                        <i class="bi bi-patch-check-fill me-1"></i> GIAN HÀNG MALL CHÍNH HÃNG
                                    </span>
                                }
                                else if (dn?.TrangThaiMall == "dangky")
                                {
                                    <span class="badge bg-warning text-dark fw-bold px-2 py-1">
                                        <i class="bi bi-clock-history me-1"></i> ĐANG CHỜ ADMIN XÉT DUYỆT MALL
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary fw-bold px-2 py-1">
                                        <i class="bi bi-shop me-1"></i> GIAN HÀNG THƯỜNG
                                    </span>
                                }
                            </div>
                        </div>

                        @if (isMall && dn?.HanMall.HasValue == true)
                        {
                            <div class="border-start border-white border-opacity-20 ps-3">
                                <div class="small text-white-50" style="font-size: 11px;">Hạn sử dụng Mall</div>
                                <div class="fw-bold text-success-emphasis">
                                    <span class="text-white">@dn.HanMall.Value.ToString("dd/MM/yyyy")</span>
                                    <span class="badge bg-success-subtle text-success ms-1 small">Còn @daysRemaining ngày</span>
                                </div>
                            </div>
                        }

                        <div class="border-start border-white border-opacity-20 ps-3">
                            <div class="small text-white-50" style="font-size: 11px;">Điểm uy tín sàn</div>
                            <div class="fw-bold text-warning">
                                ⭐ @(dn?.DiemUyTin.ToString("0.0") ?? "5.0")/10
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4 text-center text-lg-end">
                    <div class="d-inline-block text-start p-4 rounded-4 bg-white bg-opacity-10 border border-white border-opacity-20 shadow">
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <i class="bi bi-shield-fill-check text-warning fs-4"></i>
                            <h6 class="fw-bold text-white mb-0">Cam Kết Từ Sàn B2B</h6>
                        </div>
                        <ul class="list-unstyled small text-white-50 mb-3 space-y-1">
                            <li><i class="bi bi-check-circle-fill text-success me-1"></i> Xác thực 100% hồ sơ pháp lý</li>
                            <li><i class="bi bi-check-circle-fill text-success me-1"></i> Ưu tiên phân phối qua AHP B2B</li>
                            <li><i class="bi bi-check-circle-fill text-success me-1"></i> Hỗ trợ hóa đơn VAT đầy đủ</li>
                        </ul>
                        @if (!isMall)
                        {
                            <button type="button" class="btn btn-warning w-100 fw-bold rounded-pill shadow-sm" onclick="cuonDenGoi()">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Nâng Cấp Mall Ngay
                            </button>
                        }
                        else
                        {
                            <button type="button" class="btn btn-outline-light w-100 fw-bold rounded-pill shadow-sm" onclick="cuonDenGoi()">
                                <i class="bi bi-arrow-repeat me-1"></i> Gia Hạn Gói Mall
                            </button>
                        }
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Thanh Điều Hướng Tabs -->
    <ul class="nav nav-pills gap-2 mb-4 p-2 bg-white rounded-4 shadow-sm border" id="pills-tab" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active rounded-3 fw-bold px-3 py-2 d-flex align-items-center gap-2" 
                    id="pills-mall-tab" data-bs-toggle="pill" data-bs-target="#pills-mall" type="button" role="tab">
                <i class="bi bi-patch-check-fill text-danger"></i>
                <span>Gói Gian Hàng Mall</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 fw-bold px-3 py-2 d-flex align-items-center gap-2" 
                    id="pills-banner-tab" data-bs-toggle="pill" data-bs-target="#pills-banner" type="button" role="tab">
                <i class="bi bi-megaphone-fill text-primary"></i>
                <span>Quảng Cáo Banner Trang Nhất</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 fw-bold px-3 py-2 d-flex align-items-center gap-2" 
                    id="pills-sosanh-tab" data-bs-toggle="pill" data-bs-target="#pills-sosanh" type="button" role="tab">
                <i class="bi bi-diagram-3-fill text-success"></i>
                <span>Bảng So Sánh Quyền Lợi</span>
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link rounded-3 fw-bold px-3 py-2 d-flex align-items-center gap-2" 
                    id="pills-history-tab" data-bs-toggle="pill" data-bs-target="#pills-history" type="button" role="tab">
                <i class="bi bi-clock-history text-secondary"></i>
                <span>Lịch Sử Dịch Vụ Của Bạn (@lichSuGiaoDich.Count)</span>
            </button>
        </li>
    </ul>

    <!-- Nội Dung Tabs -->
    <div class="tab-content" id="pills-tabContent">
        
        <!-- ========================================== -->
        <!-- TAB 1: CÁC GÓI GIAN HÀNG MALL -->
        <!-- ========================================== -->
        <div class="tab-pane fade show active" id="pills-mall" role="tabpanel">
            <div class="text-center mb-4">
                <span class="badge bg-danger-subtle text-danger px-3 py-1 rounded-pill fw-bold text-uppercase mb-2" style="font-size: 11px;">
                    BẢNG GIÁ DỊCH VỤ GIAN HÀNG CHÍNH HÃNG
                </span>
                <h3 class="fw-bold text-dark mb-1">Chọn Gói Gian Hàng Mall Phù Hợp Doanh Nghiệp</h3>
                <p class="text-muted small">Kích hoạt ngay trong 5 phút qua mã QR ngân hàng hoặc phê duyệt tự động từ hệ thống.</p>
            </div>

            <div class="row g-4 align-items-stretch" id="khuVucGoiMall">
                <!-- Gói 1: 6 Tháng -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 package-card transition-all position-relative"
                         style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
                        <div class="card-body p-4 p-xl-5 d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-secondary-subtle text-secondary px-3 py-1 rounded-pill fw-bold" style="font-size: 11px;">
                                    GÓI KHỞI ĐỘNG
                                </span>
                                <h4 class="fw-bold text-dark mt-2 mb-1">Gói Mall 6 Tháng</h4>
                                <small class="text-muted">Trải nghiệm sức mạnh thương hiệu Mall</small>
                            </div>

                            <div class="my-3 pb-3 border-bottom">
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="display-6 fw-bold text-dark font-mono">4.990.000</span>
                                    <span class="text-muted fw-bold">đ</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Tương đương <strong>~831.000 đ/tháng</strong>
                                </div>
                            </div>

                            <ul class="list-unstyled mb-4 space-y-2 flex-grow-1">
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Huy hiệu <strong>MALL CHÍNH HÃNG</strong> độc quyền</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Ưu tiên hiển thị Top 5 trong bộ lọc Sàn Chợ Sỉ</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span><strong>+1.0 điểm uy tín</strong> trong thuật toán so sánh AHP</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Được đăng tải lên đến <strong>200 sản phẩm sỉ</strong></span>
                                </li>
                                <li class="d-flex align-items-start gap-2 text-muted mb-2">
                                    <i class="bi bi-dash-circle mt-1"></i>
                                    <span>Không tặng Banner tài trợ trang nhất</span>
                                </li>
                            </ul>

                            <button type="button" class="btn btn-outline-primary w-100 py-3 rounded-3 fw-bold mt-auto"
                                    onclick="moModalThanhToan(6, 'Gói Mall Khởi Động 6 Tháng', 4990000)">
                                <i class="bi bi-check2-circle me-1"></i> Đăng Ký Gói 6 Tháng
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Gói 2: 12 Tháng (Khuyên dùng - Nổi bật) -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow h-100 package-card popular-card transition-all position-relative"
                         style="background: linear-gradient(180deg, #ffffff 0%, #f0fdf4 100%); border: 2px solid #10b981 !important; transform: scale(1.03);">
                        
                        <!-- Badge Khuyên dùng -->
                        <div class="position-absolute top-0 start-50 translate-middle">
                            <span class="badge bg-success text-white px-3 py-2 rounded-pill fw-bold shadow-sm" style="font-size: 12px; letter-spacing: 0.5px;">
                                ⭐ KHUYÊN DÙNG • TIẾT KIỆM 15%
                            </span>
                        </div>

                        <div class="card-body p-4 p-xl-5 d-flex flex-column pt-5">
                            <div class="mb-3">
                                <span class="badge bg-success-subtle text-success px-3 py-1 rounded-pill fw-bold" style="font-size: 11px;">
                                    GÓI CHUYÊN NGHIỆP
                                </span>
                                <h4 class="fw-bold text-dark mt-2 mb-1">Gói Mall 1 Năm (12 Tháng)</h4>
                                <small class="text-muted">Được hơn 80% đối tác phân phối tin dùng</small>
                            </div>

                            <div class="my-3 pb-3 border-bottom">
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="display-6 fw-bold text-success font-mono">8.990.000</span>
                                    <span class="text-muted fw-bold">đ</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Tương đương <strong>~749.000 đ/tháng</strong> <span class="badge bg-danger-subtle text-danger ms-1">Tiết kiệm 1.000.000đ</span>
                                </div>
                            </div>

                            <div class="p-3 bg-warning-subtle rounded-3 border border-warning border-opacity-30 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-gift-fill text-warning fs-5"></i>
                                    <div class="small fw-bold text-dark">
                                        TẶNG 1 TUẦN BANNER TRANG NHẤT (Trị giá 1.000.000 đ)
                                    </div>
                                </div>
                            </div>

                            <ul class="list-unstyled mb-4 space-y-2 flex-grow-1">
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Tất cả quyền lợi của Gói Khởi Động</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span><strong>Tự động đứng đầu</strong> danh sách gợi ý nhà cung cấp AHP</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Huy hiệu <strong>"Đối Tác Chiến Lược"</strong> trên trang chi tiết</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Không giới hạn sản phẩm đăng tải chào buôn</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Hỗ trợ kỹ thuật và xét duyệt tài liệu 24/7</span>
                                </li>
                            </ul>

                            <button type="button" class="btn btn-success btn-lg w-100 py-3 rounded-3 fw-bold shadow mt-auto"
                                    onclick="moModalThanhToan(12, 'Gói Mall Chuyên Nghiệp 12 Tháng (Tặng Banner)', 8990000)">
                                <i class="bi bi-lightning-charge-fill me-1"></i> Nâng Cấp Gói 12 Tháng
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Gói 3: 24 Tháng (VIP Diamond) -->
                <div class="col-lg-4">
                    <div class="card border-0 rounded-4 shadow-sm h-100 package-card transition-all position-relative"
                         style="background: #ffffff; border: 1px solid #e2e8f0 !important;">
                        <div class="card-body p-4 p-xl-5 d-flex flex-column">
                            <div class="mb-3">
                                <span class="badge bg-primary-subtle text-primary px-3 py-1 rounded-pill fw-bold" style="font-size: 11px;">
                                    💎 VIP DIAMOND
                                </span>
                                <h4 class="fw-bold text-dark mt-2 mb-1">Gói Mall 2 Năm (24 Tháng)</h4>
                                <small class="text-muted">Đặc quyền tối thượng cho các Tổng kho lớn</small>
                            </div>

                            <div class="my-3 pb-3 border-bottom">
                                <div class="d-flex align-items-baseline gap-1">
                                    <span class="display-6 fw-bold text-primary font-mono">15.990.000</span>
                                    <span class="text-muted fw-bold">đ</span>
                                </div>
                                <div class="small text-muted mt-1">
                                    Tương đương <strong>~666.000 đ/tháng</strong> <span class="badge bg-success-subtle text-success ms-1">Tiết kiệm 25%</span>
                                </div>
                            </div>

                            <div class="p-3 bg-primary-subtle rounded-3 border border-primary border-opacity-30 mb-3">
                                <div class="d-flex align-items-center gap-2">
                                    <i class="bi bi-stars text-primary fs-5"></i>
                                    <div class="small fw-bold text-primary">
                                        TẶNG 1 THÁNG BANNER TRANG NHẤT (Trị giá 3.000.000 đ)
                                    </div>
                                </div>
                            </div>

                            <ul class="list-unstyled mb-4 space-y-2 flex-grow-1">
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Tất cả quyền lợi của Gói 12 Tháng</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Huy hiệu <strong>DIAMOND MALL</strong> danh giá bậc nhất</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Được đưa vào danh mục Nhà Cung Cấp Ưu Tú Quốc Gia</span>
                                </li>
                                <li class="d-flex align-items-start gap-2 mb-2">
                                    <i class="bi bi-check-circle-fill text-success mt-1"></i>
                                    <span>Chuyên viên tư vấn AHP & Tối ưu nguồn hàng riêng</span>
                                </li>
                            </ul>

                            <button type="button" class="btn btn-outline-primary w-100 py-3 rounded-3 fw-bold mt-auto"
                                    onclick="moModalThanhToan(24, 'Gói Doanh Nghiệp VIP Diamond 24 Tháng', 15990000)">
                                <i class="bi bi-gem me-1"></i> Đăng Ký Gói VIP 24 Tháng
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- ========================================== -->
        <!-- TAB 2: QUẢNG CÁO BANNER TRANG NHẤT -->
        <!-- ========================================== -->
        <div class="tab-pane fade" id="pills-banner" role="tabpanel">
            <div class="row g-4 align-items-start">
                <!-- Cột trái: Form đăng ký Banner -->
                <div class="col-lg-6">
                    <div class="card border-0 rounded-4 shadow-sm">
                        <div class="card-body p-4 p-md-5">
                            <div class="d-flex align-items-center gap-2 mb-3">
                                <div class="rounded-circle p-2 bg-primary bg-opacity-10 text-primary fs-5">
                                    <i class="bi bi-badge-ad"></i>
                                </div>
                                <div>
                                    <h4 class="fw-bold mb-0">Đăng Ký Banner Tài Trợ Trang Nhất</h4>
                                    <small class="text-muted">Xuất hiện ngay đầu trang Chợ Sỉ B2B để tiếp cận hàng nghìn lượt đại lý truy cập</small>
                                </div>
                            </div>

                            <form asp-action="MuaGoiBanner" method="post" id="formBanner">
                                @Html.AntiForgeryToken()

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">
                                        Tiêu đề thông điệp chiến dịch <span class="text-danger">*</span>
                                    </label>
                                    <input type="text" name="tieuDe" id="inputTieuDe" class="form-control form-control-lg fs-6" 
                                           placeholder="Ví dụ: Giảm sỉ 15% cho đơn đầu tiên - Tổng kho giao nhanh 24h" 
                                           maxlength="140" required oninput="capNhatLiveBanner()" />
                                    <small class="text-muted">Tiêu đề sẽ hiển thị nổi bật trên thanh trượt Banner trang nhất Chợ Sỉ.</small>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-bold small">Đường dẫn liên kết (Link khi click vào Banner)</label>
