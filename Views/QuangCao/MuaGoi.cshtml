</style>

<script>
    let currentMaDN = @(dn?.MaDoanhNghiep ?? 1);

    function cuonDenGoi() {
        const tabEl = document.getElementById('pills-mall-tab');
        const tab = new bootstrap.Tab(tabEl);
        tab.show();
        document.getElementById('khuVucGoiMall').scrollIntoView({ behavior: 'smooth' });
    }

    function moModalThanhToan(thang, tenGoi, soTien) {
        document.getElementById('inputThoiHanThang').value = thang;
        document.getElementById('modalMallTitle').innerText = 'Nâng Cấp ' + tenGoi;
        document.getElementById('modalSoTienHienThi').innerText = soTien.toLocaleString('vi-VN') + ' đ';
        
        const noiDung = 'MALL ' + currentMaDN + ' ' + thang + 'T';
        document.getElementById('modalNoiDungCK').innerHTML = noiDung + 
            ` <button type="button" class="btn btn-sm btn-link p-0 text-decoration-none ms-1" onclick="copyText('${noiDung}')"><i class="bi bi-copy"></i></button>`;

        const qrUrl = `https://api.vietqr.io/image/970422-0987654321-compact2.jpg?amount=${soTien}&addInfo=${encodeURIComponent(noiDung)}&accountName=SAN%20B2B%20AHP`;
        document.getElementById('qrImageMall').src = qrUrl;

        const modal = new bootstrap.Modal(document.getElementById('modalThanhToanMall'));
        modal.show();
    }

    function chonGoiBanner(tuan, soTien, radioEl) {
        document.getElementById('giaBannerHienThi').innerText = soTien.toLocaleString('vi-VN') + ' đ';
        document.querySelectorAll('.opt-thoiluong').forEach(el => el.classList.remove('active'));
        radioEl.closest('.opt-thoiluong').classList.add('active');
    }

    function capNhatLiveBanner() {
        const tieuDe = document.getElementById('inputTieuDe').value.trim();
        const lienKet = document.getElementById('inputLienKet').value.trim();
        
        document.getElementById('livePreviewTieuDe').innerText = tieuDe || 'Giảm sỉ 15% cho đơn đầu tiên - Tổng kho giao nhanh 24h';
        document.getElementById('livePreviewLink').innerText = 'Link: ' + (lienKet || '/SanB2B');
    }

    function moModalThanhToanBanner() {
        const tieuDe = document.getElementById('inputTieuDe').value.trim();
        if (!tieuDe) {
            Swal.fire({
                icon: 'warning',
                title: 'Chưa nhập tiêu đề',
                text: 'Vui lòng nhập thông điệp / tiêu đề chiến dịch quảng cáo trước khi tiếp tục!'
            });
            return;
        }

        const radioChon = document.querySelector('input[name="thoiHanTuan"]:checked');
        const tuan = radioChon ? parseInt(radioChon.value) : 1;
        const tien = tuan === 1 ? 1000000 : (tuan === 2 ? 1800000 : 3000000);
        
        document.getElementById('modalBannerTien').innerText = tien.toLocaleString('vi-VN') + ' đ';
        const noiDung = 'QC BANNER ' + currentMaDN + ' ' + tuan + 'W';
        const qrUrl = `https://api.vietqr.io/image/970422-0987654321-compact2.jpg?amount=${tien}&addInfo=${encodeURIComponent(noiDung)}&accountName=SAN%20B2B%20AHP`;
        document.getElementById('qrImageBanner').src = qrUrl;

        const modal = new bootstrap.Modal(document.getElementById('modalThanhToanBanner'));
        modal.show();
    }

    function copyText(str) {
        navigator.clipboard.writeText(str).then(() => {
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: 'Đã sao chép: ' + str,
                showConfirmButton: false,
                timer: 2000
            });
        });
    }
</script>
