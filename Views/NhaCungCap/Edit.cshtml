@model code.Models.NhaCungCap
@{
    ViewData["Title"] = "Chỉnh sửa nhà cung cấp";
}

<div class="row justify-content-center">
    <div class="col-lg-8 col-md-10">
        <div class="card-custom">
            <div class="card-header-custom">
                <h5 class="mb-0"><i class="bi bi-buildings text-primary me-1"></i> Chỉnh Sửa Nhà Cung Cấp</h5>
                <a asp-action="Index" class="btn btn-sm btn-custom btn-custom-outline">
                    <i class="bi bi-arrow-left me-1"></i> Quay lại
                </a>
            </div>

            <div class="card-body-custom">
                <form asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" method="post" enctype="multipart/form-data" class="form-custom">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="MaNhaCungCap" />
                    <input type="hidden" name="xoaAnh" id="xoaAnhNCCInput" value="false" />

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="MaNhaCungCapCode" class="form-label d-flex justify-content-between align-items-center">
                                <span>Mã NCC</span>
                                <span class="status-badge status-badge-secondary fw-normal"><i class="bi bi-lock me-1"></i>Khóa mã</span>
                            </label>
                            <input asp-for="MaNhaCungCapCode" class="form-control font-mono text-uppercase" readonly style="background: var(--slate-100);" />
                            <span asp-validation-for="MaNhaCungCapCode" class="text-danger small"></span>
                        </div>
                        <div class="col-md-8">
                            <label asp-for="TenNhaCungCap" class="form-label">Tên nhà cung cấp <span class="text-danger">*</span></label>
                            <input asp-for="TenNhaCungCap" class="form-control" required maxlength="100" />
                            <span asp-validation-for="TenNhaCungCap" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-4">
                            <label asp-for="NguoiLienHe" class="form-label">Người liên hệ</label>
                            <input asp-for="NguoiLienHe" class="form-control" maxlength="50" />
                            <span asp-validation-for="NguoiLienHe" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="SoDienThoai" class="form-label">Số điện thoại</label>
                            <input asp-for="SoDienThoai" class="form-control" maxlength="15" />
                            <span asp-validation-for="SoDienThoai" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Email" class="form-label">Email</label>
                            <input asp-for="Email" type="email" class="form-control" maxlength="50" />
                            <span asp-validation-for="Email" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="DiaChi" class="form-label">Địa chỉ</label>
                        <input asp-for="DiaChi" class="form-control" maxlength="150" />
                        <span asp-validation-for="DiaChi" class="text-danger small"></span>
                    </div>

                    <!-- Logo / Ảnh đại diện -->
                    <div class="mb-3">
                        <label class="form-label">Logo / Ảnh đại diện đối tác</label>
                        <div class="row g-3 align-items-center">
                            <div class="col-md-7">
                                <div class="image-upload-wrapper" id="dropZoneNCC" onclick="document.getElementById('fileInputNCC').click()">
                                    <input type="file" id="fileInputNCC" name="hinhAnhUpload" accept="image/*" class="d-none" onchange="previewSupplierImage(this)" />
                                    <div class="image-upload-icon">
                                        <i class="bi bi-building"></i>
                                    </div>
                                    <div class="fw-semibold" style="color: var(--slate-800);">Kéo thả logo mới vào đây hoặc nhấp để đổi</div>
                                    <div class="text-muted small">Hỗ trợ JPG, PNG, WEBP, GIF (Tối đa 5MB)</div>
                                </div>
                                <div class="mt-2">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text"><i class="bi bi-link-45deg"></i> Link</span>
                                        <input asp-for="HinhAnh" id="urlInputNCC" class="form-control" placeholder="Hoặc dán URL logo nhà cung cấp..." oninput="previewSupplierUrl(this.value)" />
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-5 text-center">
                                @{
                                    var hasLogo = !string.IsNullOrEmpty(Model.HinhAnh);
                                }
                                <div id="previewContainerNCC" class="@(hasLogo ? "" : "d-none")">
                                    <div class="image-preview-card" style="max-width: 160px;">
                                        <img id="imgPreviewNCC" src="@(hasLogo ? Model.HinhAnh : "")" alt="Logo đối tác" style="height: 140px; object-fit: contain; padding: 8px;" />
                                        <button type="button" class="btn-remove-preview" title="Gỡ logo này" onclick="clearSupplierPreview()">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    </div>
                                    <small class="text-muted d-block mt-1">Logo hiện tại / Xem trước</small>
                                </div>
                                <div id="emptyPreviewNCC" class="table-product-placeholder mx-auto @(hasLogo ? "d-none" : "")" style="width: 110px; height: 110px; border-radius: 50%; font-size: 28px;">
                                    <i class="bi bi-building"></i>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="mb-4">
                        <label class="form-label d-block">Trạng thái hợp tác</label>
                        <div class="form-check form-switch">
                            <input class="form-check-input" type="checkbox" name="TrangThai" id="chkTrangThai" value="true" @(Model.TrangThai == true ? "checked" : "")>
                            <label class="form-check-label" for="chkTrangThai">Đang hợp tác</label>
                        </div>
                    </div>

                    <div class="d-flex justify-content-end gap-2">
                        <a asp-action="Index" class="btn btn-custom btn-custom-outline">Hủy</a>
                        <button type="submit" class="btn btn-custom btn-custom-primary">
                            <i class="bi bi-check-lg me-1"></i> Cập nhật
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function previewSupplierImage(input) {
            if (input.files && input.files[0]) {
                const reader = new FileReader();
                reader.onload = function (e) {
                    document.getElementById('imgPreviewNCC').src = e.target.result;
                    document.getElementById('previewContainerNCC').classList.remove('d-none');
                    document.getElementById('emptyPreviewNCC').classList.add('d-none');
                    document.getElementById('xoaAnhNCCInput').value = 'false';
                };
                reader.readAsDataURL(input.files[0]);
            }
        }

        function previewSupplierUrl(url) {
            if (url && url.trim().length > 0) {
                document.getElementById('imgPreviewNCC').src = url.trim();
                document.getElementById('previewContainerNCC').classList.remove('d-none');
                document.getElementById('emptyPreviewNCC').classList.add('d-none');
                document.getElementById('xoaAnhNCCInput').value = 'false';
            } else if (!document.getElementById('fileInputNCC').files.length) {
                clearSupplierPreview();
            }
        }

        function clearSupplierPreview() {
            document.getElementById('fileInputNCC').value = '';
            document.getElementById('urlInputNCC').value = '';
            document.getElementById('imgPreviewNCC').src = '';
            document.getElementById('previewContainerNCC').classList.add('d-none');
            document.getElementById('emptyPreviewNCC').classList.remove('d-none');
            document.getElementById('xoaAnhNCCInput').value = 'true';
        }

        const dropZoneNCC = document.getElementById('dropZoneNCC');
        if (dropZoneNCC) {
            ['dragenter', 'dragover'].forEach(eventName => {
                dropZoneNCC.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZoneNCC.classList.add('dragover');
                }, false);
            });

            ['dragleave', 'drop'].forEach(eventName => {
                dropZoneNCC.addEventListener(eventName, (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    dropZoneNCC.classList.remove('dragover');
                }, false);
            });

            dropZoneNCC.addEventListener('drop', (e) => {
                const dt = e.dataTransfer;
                const files = dt.files;
                if (files && files.length > 0) {
                    document.getElementById('fileInputNCC').files = files;
                    previewSupplierImage(document.getElementById('fileInputNCC'));
                }
            }, false);
        }
    </script>
}
