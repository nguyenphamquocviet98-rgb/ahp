@model IEnumerable<code.Models.NhaCungCap>
@{
    ViewData["Title"] = "Quản lý Nhà cung cấp";
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly") || User.IsInRole("admin_san") || User.IsInRole("chu_npp");
    var search = ViewData["Search"] as string;
}

<div class="page-header">
    <div class="page-header-left">
        <h3>Nhà cung cấp</h3>
        <p>Quản lý danh sách đối tác cung ứng, đầu mối liên hệ và địa chỉ</p>
    </div>
    <div class="d-flex gap-2 flex-wrap">
        <a asp-controller="AHP" asp-action="Index" class="btn btn-custom btn-custom-outline" title="Xem danh sách các kỳ đánh giá AHP">
            <i class="bi bi-diagram-3 text-primary"></i> Lịch sử AHP
        </a>
        @if (isManagerOrAdmin)
        {
            <a asp-controller="AHP" asp-action="CreateKy" class="btn btn-custom btn-custom-outline" style="border-color: var(--primary-500); color: var(--primary-700); background-color: var(--primary-50);" title="Khởi tạo kỳ đánh giá lựa chọn NCC mới bằng thuật toán AHP">
                <i class="bi bi-award-fill text-primary"></i> Đánh giá AHP mới
            </a>
            <a asp-action="Create" class="btn btn-custom btn-custom-primary">
                <i class="bi bi-plus-circle"></i> Thêm nhà cung cấp mới
            </a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert-custom alert-custom-success mb-3">
        <i class="bi bi-check-circle"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert-custom alert-custom-danger mb-3">
        <i class="bi bi-exclamation-triangle"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Bộ tìm kiếm -->
<div class="search-bar mb-4">
    <form method="get" asp-action="Index" class="d-flex gap-2 align-items-center flex-wrap w-100">
        <div class="input-group" style="flex: 1; min-width: 240px;">
            <span class="input-group-text"><i class="bi bi-search"></i></span>
            <input type="text" name="search" value="@search" class="form-control" placeholder="Tìm theo tên, mã, người liên hệ, số điện thoại..." />
        </div>
        <button type="submit" class="btn btn-custom btn-custom-outline"><i class="bi bi-funnel"></i> Tìm kiếm</button>
        @if (!string.IsNullOrEmpty(search))
        {
            <a asp-action="Index" class="btn btn-custom btn-custom-outline" title="Đặt lại"><i class="bi bi-arrow-counterclockwise"></i></a>
        }
    </form>
</div>

<!-- Bảng danh sách NCC -->
<div class="table-wrapper">
    <div class="table-responsive">
        <table class="table-custom">
            <thead>
                <tr>
                    <th>Nhà cung cấp</th>
                    <th style="width: 230px;">Liên hệ</th>
                    <th class="text-center" style="width: 170px;">Đánh giá AHP gần nhất</th>
                    <th class="text-center" style="width: 110px;">Số đơn nhập</th>
                    <th class="text-center" style="width: 120px;">Trạng thái</th>
                    <th class="text-end" style="width: 140px;">Thao tác</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        var initial = !string.IsNullOrWhiteSpace(item.TenNhaCungCap) ? item.TenNhaCungCap.Trim().Substring(0, 1).ToUpper() : "N";
                        var latestAHP = item.KetQuaXepHangs?
                            .OrderByDescending(k => k.KyDanhGia != null ? k.KyDanhGia.NgayTao : DateTime.MinValue)
                            .ThenByDescending(k => k.MaKyDanhGia)
                            .FirstOrDefault();
                        <tr>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    @if (!string.IsNullOrEmpty(item.HinhAnh))
                                    {
                                        <img src="@item.HinhAnh" alt="@item.TenNhaCungCap" class="table-supplier-logo" onerror="this.onerror=null; this.src='/images/placeholder-supplier.svg';" />
                                    }
                                    else
                                    {
                                        <div class="table-supplier-avatar-placeholder">@initial</div>
                                    }
                                    <div style="min-width: 0;">
                                        <a asp-action="Details" asp-route-id="@item.MaNhaCungCap" class="text-decoration-none fw-semibold d-block" style="color: var(--slate-800);">
                                            @item.TenNhaCungCap
                                        </a>
                                        <div style="margin-top: 2px;">
                                            <span class="code-badge">@(item.MaNhaCungCapCode ?? $"NCC{item.MaNhaCungCap:D3}")</span>
                                        </div>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <div style="color: var(--slate-600); font-size: 13.5px;">
                                    <div><i class="bi bi-person me-1" style="color: var(--slate-400);"></i>@(item.NguoiLienHe ?? "—")</div>
                                    <div>
                                        @if (!string.IsNullOrEmpty(item.SoDienThoai))
                                        {
                                            <a href="tel:@item.SoDienThoai" class="text-decoration-none" style="color: var(--slate-600);"><i class="bi bi-telephone me-1" style="color: var(--slate-400);"></i>@item.SoDienThoai</a>
                                        }
                                    </div>
                                    <div>
                                        @if (!string.IsNullOrEmpty(item.Email))
                                        {
                                            <a href="mailto:@item.Email" class="text-decoration-none" style="color: var(--slate-600);"><i class="bi bi-envelope me-1" style="color: var(--slate-400);"></i>@item.Email</a>
                                        }
                                    </div>
                                </div>
                            </td>
                            <td class="text-center">
                                @if (latestAHP != null)
                                {
                                    <div class="d-flex flex-column align-items-center gap-1">
                                        @if (latestAHP.XepHang == 1 || latestAHP.DeXuat == true)
                                        {
                                            <span class="badge" style="background-color: #FEF3C7; color: #92400E; border: 1px solid #FCD34D; font-size: 11.5px; font-weight: 600;">
                                                <i class="bi bi-trophy-fill text-warning me-1"></i>Top 1 (Đề xuất)
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge" style="background-color: var(--slate-100); color: var(--slate-700); border: 1px solid var(--slate-200); font-size: 11.5px;">
                                                Hạng @(latestAHP.XepHang?.ToString() ?? "-")
                                            </span>
                                        }
                                        <a asp-controller="AHP" asp-action="KetQuaXepHang" asp-route-id="@latestAHP.MaKyDanhGia" 
                                           class="font-mono text-decoration-none fw-semibold" 
                                           style="font-size: 12px; color: var(--primary);" 
                                           title="@(latestAHP.KyDanhGia?.TenKyDanhGia ?? $"Kỳ #{latestAHP.MaKyDanhGia}") - Bấm để xem chi tiết kỳ AHP">
                                            @(latestAHP.DiemTong?.ToString("0.00") ?? "—") điểm
                                        </a>
                                    </div>
                                }
                                else
                                {
                                    <span style="color: var(--slate-400); font-size: 12.5px;">
                                        <i class="bi bi-dash-circle me-1"></i>Chưa đánh giá
                                    </span>
                                }
                            </td>
                            <td class="text-center font-mono fw-semibold">@(item.PhieuNhaps?.Count ?? 0)</td>
                            <td class="text-center">
                                @if (item.TrangThai == true)
                                {
                                    <span class="status-badge status-badge-success">Hợp tác</span>
                                }
                                else
                                {
                                    <span class="status-badge status-badge-secondary">Tạm dừng</span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="action-btn-group">
                                    <a asp-action="Details" asp-route-id="@item.MaNhaCungCap" class="btn btn-sm btn-outline-primary" title="Xem chi tiết">
                                        <i class="bi bi-eye"></i>
                                    </a>
                                    @if (isManagerOrAdmin)
                                    {
                                        <a asp-action="Edit" asp-route-id="@item.MaNhaCungCap" class="btn btn-sm btn-outline-secondary" title="Chỉnh sửa">
                                            <i class="bi bi-pencil"></i>
                                        </a>
                                        <button type="button" class="btn btn-sm btn-outline-danger" title="Xóa"
                                                onclick="confirmDelete(@item.MaNhaCungCap, '@item.TenNhaCungCap')">
                                            <i class="bi bi-trash"></i>
                                        </button>
                                    }
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6">
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <p>Không tìm thấy nhà cung cấp nào.</p>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<partial name="_DeleteModal" view-data='new ViewDataDictionary(ViewData) { ["DeleteNote"] = "Nếu nhà cung cấp đã có phiếu nhập hàng hoặc dữ liệu đánh giá AHP, hệ thống sẽ chặn xóa để bảo đảm toàn vẹn dữ liệu." }' />
