@model code.Models.NhaCungCap
@{
    ViewData["Title"] = "Chi tiết nhà cung cấp - " + Model.TenNhaCungCap;
    var isManagerOrAdmin = User.IsInRole("admin") || User.IsInRole("quanly");
}

<div class="row justify-content-center">
    <div class="col-lg-9 col-md-11">
        <!-- Card Thông tin NCC -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="d-flex align-items-center">
                    <a asp-action="Index" class="btn btn-outline-secondary btn-sm rounded-circle me-3" title="Quay lại">
                        <i class="bi bi-arrow-left"></i>
                    </a>
                    @if (!string.IsNullOrEmpty(Model.HinhAnh))
                    {
                        <img src="@Model.HinhAnh" alt="@Model.TenNhaCungCap" class="supplier-detail-media me-3" onerror="this.onerror=null; this.src='/favicon.ico';" />
                    }
                    else
                    {
                        var initial = !string.IsNullOrWhiteSpace(Model.TenNhaCungCap) ? Model.TenNhaCungCap.Trim().Substring(0, 1).ToUpper() : "N";
                        <div class="supplier-detail-media me-3 d-flex align-items-center justify-content-center bg-primary-subtle text-primary fs-2 fw-bold">
                            @initial
                        </div>
                    }
                    <div>
                        <h4 class="fw-bold text-dark mb-0">@Model.TenNhaCungCap</h4>
                        <span class="badge bg-light text-dark font-monospace border mt-1">
                            Mã: @(Model.MaNhaCungCapCode ?? $"NCC{Model.MaNhaCungCap:D3}")
                        </span>
                    </div>
                </div>
                @if (isManagerOrAdmin)
                {
                    <a asp-action="Edit" asp-route-id="@Model.MaNhaCungCap" class="btn btn-primary rounded-3 px-3">
                        <i class="bi bi-pencil me-1"></i> Chỉnh sửa
                    </a>
                }
            </div>

            <div class="row g-3">
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small d-block">Người liên hệ:</span>
                        <strong class="text-dark">@(Model.NguoiLienHe ?? "—")</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small d-block">Số điện thoại:</span>
                        <strong class="text-dark">@(Model.SoDienThoai ?? "—")</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small d-block">Email:</span>
                        <strong class="text-dark">@(Model.Email ?? "—")</strong>
                    </div>
                </div>
                <div class="col-md-8">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small d-block">Địa chỉ:</span>
                        <strong class="text-dark">@(Model.DiaChi ?? "—")</strong>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="p-3 bg-light rounded-3 h-100">
                        <span class="text-muted small d-block">Trạng thái hợp tác:</span>
                        @if (Model.TrangThai == true)
                        {
                            <span class="badge bg-success-subtle text-success fs-6">Đang hợp tác</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary-subtle text-secondary fs-6">Tạm dừng</span>
                        }
                    </div>
                </div>
            </div>
        </div>

        <!-- Lịch sử Phiếu nhập từ NCC này -->
        <div class="card border-0 shadow-sm rounded-4 bg-white p-4 mb-4">
            <h5 class="fw-bold text-dark mb-3">
                <i class="bi bi-receipt text-primary me-2"></i>Lịch sử phiếu nhập từ đối tác này
            </h5>
            @if (Model.PhieuNhaps != null && Model.PhieuNhaps.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Mã phiếu</th>
                                <th>Ngày nhập</th>
                                <th class="text-center">Số sản phẩm</th>
                                <th class="text-end">Tổng tiền</th>
                                <th class="text-center">Trạng thái</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var pn in Model.PhieuNhaps.OrderByDescending(p => p.NgayNhap))
                            {
                                var tongTien = (pn.TongTien.HasValue && pn.TongTien.Value > 0)
                                    ? pn.TongTien.Value
                                    : (pn.ChiTietPhieuNhaps?.Sum(c => c.ThanhTien ?? (c.SoLuong * c.DonGia) ?? 0) ?? 0);
                                <tr>
                                    <td>
                                        <span class="font-monospace text-primary fw-semibold">
                                            @(pn.MaPhieuNhapCode ?? $"PN{pn.MaPhieuNhap:D4}")
                                        </span>
                                    </td>
                                    <td class="small text-muted">
                                        @(pn.NgayNhap?.ToString("dd/MM/yyyy") ?? pn.NgayTao?.ToString("dd/MM/yyyy") ?? "N/A")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge bg-light text-dark border">
                                            @(pn.ChiTietPhieuNhaps?.Count ?? 0) mặt hàng
                                        </span>
                                    </td>
                                    <td class="text-end fw-bold text-dark">
                                        @(tongTien.ToString("N0")) đ
                                    </td>
                                    <td class="text-center">
                                        @if (pn.TrangThai == "xacnhan")
                                        {
                                            <span class="badge bg-success-subtle text-success">Đã xác nhận</span>
                                        }
                                        else if (pn.TrangThai == "huy")
                                        {
                                            <span class="badge bg-danger-subtle text-danger">Đã hủy</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning-subtle text-warning">Chờ xử lý</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted">
                    <i class="bi bi-inbox fs-2 d-block mb-1"></i>
                    Chưa có phiếu nhập hàng nào từ nhà cung cấp này.
                </div>
            }
        </div>

        <!-- Lịch sử Đánh giá AHP -->
        @if (Model.KetQuaXepHangs != null && Model.KetQuaXepHangs.Any())
        {
            <div class="card border-0 shadow-sm rounded-4 bg-white p-4">
                <h5 class="fw-bold text-dark mb-3">
                    <i class="bi bi-trophy text-warning me-2"></i>Kết quả đánh giá xếp hạng AHP
                </h5>
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light small text-uppercase text-muted">
                            <tr>
                                <th>Kỳ đánh giá</th>
                                <th class="text-center">Điểm tổng hợp</th>
                                <th class="text-center">Thứ hạng</th>
                                <th class="text-center">Đề xuất</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var kq in Model.KetQuaXepHangs.OrderByDescending(k => k.MaKyDanhGia))
                            {
                                <tr>
                                    <td class="fw-semibold">@(kq.KyDanhGia?.TenKyDanhGia ?? $"Kỳ #{kq.MaKyDanhGia}")</td>
                                    <td class="text-center fw-bold text-primary">
                                        @(kq.DiemTong?.ToString("0.00") ?? "N/A")
                                    </td>
                                    <td class="text-center">
                                        <span class="badge @(kq.XepHang == 1 ? "bg-warning text-dark" : "bg-light text-dark border") px-3">
                                            Hạng @(kq.XepHang?.ToString() ?? "-")
                                        </span>
                                    </td>
                                    <td class="text-center">
                                        @if (kq.DeXuat == true)
                                        {
                                            <span class="badge bg-success-subtle text-success">Được đề xuất</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">—</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        }
    </div>
</div>
